            }
        }

        :root {
            --hertz-yellow: #e0611c;
            --hertz-dark: #1a1a1a;
            --text-gray: #4a4a4a;
            --border-gray: #e0e0e0;
            --link-blue: #2b6cb0;
            --bg-light: #f7f7f8;
        }

        .btn-download {
            background: #e0611c;
            color: #fff;
            font-size: 13px;
            font-weight: 700;
            padding: 12px 24px;
            border-radius: 999px;
            border: none;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            box-shadow: 0 10px 24px rgba(24, 183, 148, .22);
        }

        :root {
            --ink: #f5f5f5;
            --ink-2: #121613;
            --panel: #161B18;
            --panel-2: #1C221E;
            --paper: #F4F1E9;
            --paper-dim: #2c2c2b;
            --teal: #e0611c;
            --teal-bright: #e0611c;
            --gold: #D05128;
            --line: rgba(244,241,233,.09);
            --line-strong: rgba(244,241,233,.16);
        }

        :root {
            --trev-green: #e0611c;
            --trev-green-mid: #1DC97A;
            --trev-green-dark: #0F6E56;
            --trev-black: #0A0A0A;
            --trev-dark: #111111;
            --trev-card: #161616;
            --trev-border: rgba(255,255,255,0.08);
            --trev-muted: rgba(255,255,255,0.45);
        }

        .trev-nav {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 999;
            background: rgba(12, 15, 13, .7);
            backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--line);
        }

        .trev-logo {
            font-size: 22px;
            font-weight: 900;
            letter-spacing: -0.5px;
            color: #fff;
            text-decoration: none;
            width: 191px;
            height: 79px;
            position: absolute;
        }

        .trev-nav {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 999;
            background: rgba(12, 15, 13, .7);
            backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--line);
        }

        .trev-nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            padding: 18px 48px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: transparent;
            backdrop-filter: none;
            border-bottom: none;
            box-shadow: none;
        }


        * {
            font-family: 'Montserrat', sans-serif;
        }

        body {
            color: var(--hertz-dark);
            background: #fff;
            font-size: 14px;
        }

        .trev-nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            padding: 18px 48px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(12, 15, 13, .7);
            backdrop-filter: none;
            border-bottom: none;
            box-shadow: none;
        }

        .trev-logo {
            font-size: 22px;
            font-weight: 900;
            letter-spacing: -0.5px;
            color: #fff;
            text-decoration: none;
        }


            .trev-logo span {
                color: var(--trev-green);
            }

        .nav-links {
            display: flex;
            gap: 36px;
            list-style: none;
            margin: 0;
            padding: 0;
            margin-left: auto;
            margin-right: 17px;
        }

            .nav-links a {
                color: #fff;
                text-decoration: none;
                font-size: 14px;
                font-weight: 500;
                letter-spacing: 0.2px;
                transition: color 0.2s;
            }

                .nav-links a:hover {
                    color: #ffb08a;
                }

        a {
            color: var(--link-blue);
            text-decoration: none;
        }

            a:hover {
                text-decoration: underline;
            }

        /* ===== Header ===== */
        .top-header {
            border-bottom: 3px solid var(--hertz-yellow);
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 1.8rem;
            letter-spacing: -1px;
            color: var(--hertz-dark) !important;
            position: relative;
        }

            .navbar-brand::after {
                content: '';
                position: absolute;
                bottom: -2px;
                left: 0;
                width: 60%;
                height: 3px;
                background: var(--hertz-yellow);
            }

        .nav-link-custom {
            font-size: .82rem;
            font-weight: 500;
            color: var(--hertz-dark) !important;
            padding: 0 .85rem !important;
        }

        .top-right-text {
            font-size: .82rem;
            font-weight: 600;
        }

        /* ===== Hero image ===== */
        .hero-banner {
            width: 100%;
            height: 280px;
            object-fit: cover;
            filter: grayscale(100%);
            display: block;
        }

        /* ===== Confirmation card ===== */
        .confirmation-card {
            max-width: 580px;
            margin: -40px auto 0;
            background: #fff;
            border: 1px solid var(--border-gray);
            box-shadow: 0 2px 10px rgba(0,0,0,.06);
            padding: 2rem 2.5rem;
            text-align: center;
            position: relative;
            z-index: 2;
        }

            .confirmation-card h2 {
                font-weight: 400;
                font-size: 1.4rem;
                color: #333;
                margin-bottom: .5rem;
            }

            .confirmation-card .conf-number {
                font-size: .95rem;
            }

                .confirmation-card .conf-number strong {
                    font-weight: 700;
                }

        .trip-dates {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 2.5rem;
            margin: 1.75rem 0 1rem;
        }

            .trip-dates .date-block {
                text-align: left;
            }

                .trip-dates .date-block .big-date {
                    font-weight: 800;
                    font-size: 1.35rem;
                    margin-bottom: .35rem;
                }

                .trip-dates .date-block .loc-time {
                    font-size: .78rem;
                    color: var(--text-gray);
                    line-height: 1.4;
                }

            .trip-dates .arrow {
                font-size: 1.3rem;
                color: #999;
            }

        .cal-links {
            font-size: .85rem;
            margin-top: 1rem;
        }

        .action-row {
            max-width: 580px;
            margin: 1.25rem auto 0;
            display: flex;
            justify-content: space-between;
            font-size: .85rem;
        }

        /* ===== Itinerary section ===== */
        .section-heading {
            font-weight: 700;
            font-size: 1.1rem;
            border-bottom: 1px solid var(--border-gray);
            padding-bottom: .6rem;
            margin-bottom: 1.25rem;
        }

        .itin-label {
            font-weight: 700;
            font-size: .85rem;
            margin-bottom: .15rem;
        }

        .itin-value {
            font-size: .85rem;
            color: var(--text-gray);
            margin-bottom: 1.25rem;
            line-height: 1.5;
        }

        /* ===== Price summary card ===== */
        .price-card {
            border: 1px solid var(--border-gray);
        }

        .price-card-header {
            background: var(--bg-light);
            text-align: center;
            padding: .9rem 1rem;
            font-weight: 700;
            font-size: .95rem;
            border-bottom: 1px solid var(--border-gray);
        }

            .price-card-header .amt {
                font-weight: 800;
                font-size: 1.1rem;
                display: block;
                margin-top: .15rem;
            }

        .price-card-body {
            padding: 1.25rem 1.25rem 0;
        }

            .price-card-body img {
                width: 100%;
                max-height: 150px;
                object-fit: contain;
                margin-bottom: 1rem;
            }

        .car-class-title {
            font-weight: 700;
            font-size: .82rem;
            margin-bottom: .15rem;
        }

        .car-class-sub {
            font-size: .78rem;
            color: var(--text-gray);
        }

        .price-row {
            display: flex;
            justify-content: space-between;
            font-size: .82rem;
            padding: .35rem 0;
        }

        .price-section-title {
            font-weight: 700;
            font-size: .8rem;
            text-transform: uppercase;
            letter-spacing: .3px;
            margin-top: 1rem;
            margin-bottom: .35rem;
        }

        .price-divider {
            border-top: 1px solid var(--border-gray);
            margin: 1rem -1.25rem;
        }

        .price-total-row {
            background: var(--bg-light);
            display: flex;
            justify-content: space-between;
            padding: .9rem 1.25rem;
            font-weight: 700;
            font-size: .9rem;
            margin: 0 -1.25rem;
        }

        .fine-print {
            font-size: .72rem;
            color: var(--text-gray);
            line-height: 1.5;
            padding: 1rem 1.25rem;
        }

            .fine-print p {
                margin-bottom: .75rem;
            }

        /* ===== Accordion ===== */
        .accordion-custom .accordion-button {
            font-weight: 600;
            font-size: .85rem;
            color: var(--hertz-dark);
            background: #fff;
            box-shadow: none;
            padding: 1rem 0;
            border-bottom: 1px solid var(--border-gray);
        }

            .accordion-custom .accordion-button::after {
                filter: sepia(1) saturate(5) hue-rotate(360deg) brightness(1);
            }

        .accordion-custom .accordion-body {
            font-size: .82rem;
            color: var(--text-gray);
            padding: 1rem 0;
        }

        .accordion-button:not(.collapsed) {
            color: var(--hertz-dark);
            background: #fff;
        }

        .accordion-button:focus {
            box-shadow: none;
        }

        /* ===== Footer ===== */
        .footer-social a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            background: var(--hertz-yellow);
            border-radius: 4px;
            margin-right: .6rem;
            color: var(--hertz-dark);
        }

        .footer-bottom {
            background: var(--bg-light);
            padding-top: 3rem;
        }

        .footer-col h6 {
            font-weight: 700;
            font-size: .85rem;
            margin-bottom: .9rem;
        }

        .footer-col a {
            display: block;
            font-size: .8rem;
            color: var(--text-gray);
            margin-bottom: .55rem;
        }

        .footer-copy {
            text-align: center;
            font-size: .75rem;
            color: var(--text-gray);
            padding: 1.5rem 0;
        }

        @@media (max-width:576px) {
            .confirmation-card {
                padding: 1.5rem 1.2rem;
            }

            .trip-dates {
                gap: 1rem;
                flex-direction: column;
            }

                .trip-dates .arrow {
                    transform: rotate(90deg);
                }
        }
    </style>
</head>
<body>


    <!-- ===== Hero Image ===== -->
