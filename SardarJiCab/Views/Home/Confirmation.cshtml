                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse3">
                        Rental Qualifications and Requirements
                    </button>
                </h2>
                <div id="collapse3" class="accordion-collapse collapse" data-bs-parent="#infoAccordion">
                    <div class="accordion-body">
                        Renters must meet minimum age requirements and present a valid driver's license, identification, and an accepted form of payment at pick-up.
                    </div>
                </div>
            </div>
        </div>
