@{
    ViewBag.Title = "Drive Green with Sardar Ji Cab";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

<style>

    body {
        background: #F5FAF8;
        font-family: 'Segoe UI', sans-serif;
    }

    .hero-section {
        background: linear-gradient(135deg,#DFF8EA,#C9F6E7);
        border-radius: 25px;
        padding: 60px;
        margin-top: 30px;
        overflow: hidden;
    }

    .hero-title {
        font-size: 46px;
        font-weight: 700;
        color: #0E5B43;
    }

    .hero-text {
        color: #555;
        font-size: 18px;
        line-height: 32px;
    }

    .section-title {
        color: #0E5B43;
        font-weight: 700;
        margin-bottom: 40px;
    }

    .feature-card {
        background: white;
        border-radius: 20px;
        padding: 30px;
        height: 100%;
        transition: .3s;
        box-shadow: 0 10px 30px rgba(0,0,0,.08);
    }

        .feature-card:hover {
            transform: translateY(-8px);
        }

    .icon-box {
        width: 75px;
        height: 75px;
        border-radius: 50%;
        background: #DFF8EA;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        color: #16A34A;
        font-size: 32px;
    }

    .stats {
        background: white;
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 10px 30px rgba(0,0,0,.08);
    }

    .number {
        font-size: 42px;
        font-weight: bold;
        color: #16A34A;
    }

    .benefit {
        background: white;
        padding: 18px;
        border-radius: 15px;
        margin-bottom: 15px;
        box-shadow: 0 5px 15px rgba(0,0,0,.05);
        transition: .3s;
    }

        .benefit:hover {
            transform: translateX(8px);
        }

    .cta {
        background: linear-gradient(135deg,#16A34A,#0F766E);
        color: white;
        border-radius: 25px;
        padding: 60px;
        text-align: center;
        margin: 60px 0;
    }

    .btn-book {
        background: white;
        color: #16A34A;
        font-weight: bold;
        padding: 12px 35px;
        border-radius: 40px;
        text-decoration: none;
        display: inline-block;
        margin-top: 20px;
    }

        .btn-book:hover {
            background: #f2f2f2;
            color: #16A34A;
            text-decoration: none;
        }

</style>

<div class="container">

    <!-- HERO -->

    <div class="hero-section">

        <div class="row align-items-center">

            <div class="col-lg-7">

                <h1 class="hero-title">
                    Drive Green with <br />
                    Sardar Ji Cab
                </h1>

                <p class="hero-text mt-4">

                    At <strong>Sardar Ji Cab</strong>, every ride is more than just reaching
                    your destination—it's about creating a cleaner, greener future.

                    Our electric vehicle fleet helps reduce carbon emissions,
                    improve air quality, and provide a smooth, quiet, and comfortable
                    travel experience.

                    Every kilometer you travel with us contributes to protecting
                    our environment for future generations.

                </p>

            </div>

            <div class="col-lg-5 text-center">

                <img src="https://cdn-icons-png.flaticon.com/512/3097/3097144.png"
                     class="img-fluid"
                     style="max-height:280px;" />

            </div>

        </div>

    </div>

    <br /><br />

    <!-- WHY -->

    <h2 class="text-center section-title">
        Why Choose Sardar Ji Cab?
    </h2>

    <div class="row">

        <div class="col-md-4 mb-4">

            <div class="feature-card">

                <div class="icon-box">
                    <i class="fa-solid fa-leaf"></i>
                </div>

                <h4>100% Eco-Friendly Rides</h4>

                <p>

                    Our electric vehicles produce zero tailpipe emissions,
                    helping reduce pollution and making cities healthier.

                </p>

            </div>

        </div>

        <div class="col-md-4 mb-4">

            <div class="feature-card">

                <div class="icon-box">
                    <i class="fa-solid fa-earth-asia"></i>
                </div>

                <h4>Reduce CO₂ Emissions</h4>

                <p>

                    Every trip with Sardar Ji Cab helps lower carbon emissions
                    compared to conventional fuel-powered vehicles.

                </p>

            </div>

        </div>

        <div class="col-md-4 mb-4">

            <div class="feature-card">

                <div class="icon-box">
                    <i class="fa-solid fa-bolt"></i>
                </div>

                <h4>Comfort & Innovation</h4>

                <p>

                    Experience smooth, silent, and comfortable rides
                    powered by the latest electric vehicle technology.

                </p>

            </div>

        </div>

    </div>

    <br />

    <!-- STATS -->

    <div class="stats">

        <div class="row text-center">

            <div class="col-md-4">

                <div class="number">0%</div>

                <h5>Tailpipe Emissions</h5>

                <p>Every EV ride helps reduce air pollution.</p>

            </div>

            <div class="col-md-4">

                <div class="number">100%</div>

                <h5>Electric Mobility</h5>

                <p>Clean transportation for a better tomorrow.</p>

            </div>

            <div class="col-md-4">

                <div class="number">24×7</div>

                <h5>Reliable Service</h5>

                <p>Available whenever you need a ride.</p>

            </div>

        </div>

    </div>

    <br /><br />

    <!-- BENEFITS -->

    <h2 class="text-center section-title">
        Every Ride Makes a Difference
    </h2>

    <div class="row">

        <div class="col-md-6">

            <div class="benefit">🌱 Every ride helps reduce carbon emissions.</div>

            <div class="benefit">🚖 Travel in clean, silent electric vehicles.</div>

            <div class="benefit">🌍 Improve city air quality.</div>

            <div class="benefit">💚 Support sustainable transportation.</div>

        </div>

        <div class="col-md-6">

            <div class="benefit">🔋 Powered by electric mobility.</div>

            <div class="benefit">🌳 Protect the environment for future generations.</div>

            <div class="benefit">⭐ Safe, trusted & professional drivers.</div>

            <div class="benefit">🤝 Together we're building a greener India.</div>

        </div>

    </div>

    <br /><br />

    <!-- WHY SARDAR JI CAB -->

    <div class="feature-card">

        <h2 class="section-title">
            Why Thousands Trust Sardar Ji Cab
        </h2>

        <p>

            <strong>Sardar Ji Cab</strong> is committed to redefining urban
            transportation through clean energy and exceptional customer service.

            We combine technology, reliability, and sustainability to ensure
            every journey is comfortable, affordable, and environmentally responsible.

        </p>

        <div class="row mt-4">

            <div class="col-md-6">

                <ul class="list-unstyled">

                    <li class="mb-3"><i class="fa fa-check-circle text-success"></i> 100% Electric Vehicle Fleet</li>

                    <li class="mb-3"><i class="fa fa-check-circle text-success"></i> Professional Drivers</li>

                    <li class="mb-3"><i class="fa fa-check-circle text-success"></i> Transparent Pricing</li>

                    <li class="mb-3"><i class="fa fa-check-circle text-success"></i> Comfortable Rides</li>

                </ul>

            </div>

            <div class="col-md-6">

                <ul class="list-unstyled">

                    <li class="mb-3"><i class="fa fa-check-circle text-success"></i> Real-Time Ride Tracking</li>

                    <li class="mb-3"><i class="fa fa-check-circle text-success"></i> 24×7 Customer Support</li>

                    <li class="mb-3"><i class="fa fa-check-circle text-success"></i> Eco-Friendly Transportation</li>

                    <li class="mb-3"><i class="fa fa-check-circle text-success"></i> Cleaner Future Together</li>

                </ul>

            </div>

        </div>

    </div>

    <!-- CTA -->

    <div class="cta">

        <h2>Join the Green Journey with Sardar Ji Cab</h2>

        <p class="mt-4">

            Thank you for choosing <strong>Sardar Ji Cab</strong>.
            Every electric ride you book contributes to cleaner air,
            reduced carbon emissions, and a more sustainable future.

            Together, we can create greener cities—one ride at a time.

        </p>

        <a href="@Url.Action("Index","Home")" class="btn-book">
            <i class="fa-solid fa-car-side"></i> Book Your Next EV Ride
        </a>

    </div>

</div>