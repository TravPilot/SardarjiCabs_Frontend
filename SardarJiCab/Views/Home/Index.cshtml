    <div id="sheetOverlay" class="sheet-overlay">
        <div class="sheet" role="dialog" aria-modal="true" aria-labelledby="sheetTitle">
            <div class="sheet-handle"></div>
            <div class="sheet-header">
                <h3 id="sheetTitle" class="sheet-title">Set your route</h3>
                <button class="sheet-close" type="button" onclick="closeSheet()" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div id="sheetPlanBadge" class="sheet-plan-badge">AIRPORT</div>

            <div class="route-block">
                <div class="route-row" id="pickupRow">
                    <div class="route-icon"><i class="fa-solid fa-location-dot"></i></div>
                    <div class="route-field">
                        <div class="route-field-label">Pickup</div>
                        <input id="pickupValue" class="route-field-input" type="text"
                               placeholder="Choose pickup point" autocomplete="off" required />
                    </div>
                </div>
                <div class="route-row" id="dropRow">
                    <div class="route-icon"><i class="fa-solid fa-location-dot"></i></div>
                    <div class="route-field">
                        <div class="route-field-label">Drop</div>
                        <input id="dropValue" class="route-field-input" type="text"
                               placeholder="Choose drop point" autocomplete="off" required />
                    </div>
                </div>
                <button class="swap-btn" type="button" onclick="swapLocations(event)" aria-label="Swap pickup and drop">
                    <i class="fa-solid fa-right-left"></i>
                </button>
            </div>

            <div id="routeMapWrap" class="route-map-wrap">
                <div id="routeMap" class="route-map"></div>
                <div id="distanceInfo" class="distance-info">Calculating distance…</div>
            </div>

            <div class="sheet-section-label" id="listLabel">Suggested pickup points</div>
            <div id="locationList" class="location-list"></div>

            <a href="/Home/Dateview" id="sheetCta" class="sheet-cta" type="button" onclick="confirmRoute()">Choose both points to continue</a>
        </div>
    </div>
    <script>

        let state = { pickup: '', drop: '', active: 'pickup', distanceKm: null, categoryId: null };

        const overlay = document.getElementById('sheetOverlay');
        const planBadge = document.getElementById('sheetPlanBadge');
        const pickupValue = document.getElementById('pickupValue'); // now an <input>
        const dropValue = document.getElementById('dropValue');     // now an <input>
        const pickupRow = document.getElementById('pickupRow');
        const dropRow = document.getElementById('dropRow');
        const listLabel = document.getElementById('listLabel');
        const locationList = document.getElementById('locationList');
        const cta = document.getElementById('sheetCta');
        const routeMapWrap = document.getElementById('routeMapWrap');
        const distanceInfo = document.getElementById('distanceInfo');


        let googleReady = false;
        let autocompleteService = null;
        let map, directionsService, directionsRenderer;
        let placesDebounce = null;

        function initGoogleMaps() {
            googleReady = true;
            autocompleteService = new google.maps.places.AutocompleteService();
            directionsService = new google.maps.DirectionsService();
        }

        function ensureMap() {
            if (!map) {
                map = new google.maps.Map(document.getElementById('routeMap'), {
                    center: { lat: 28.6139, lng: 77.2090 },
                    zoom: 11,
                    disableDefaultUI: true
                });
                directionsRenderer = new google.maps.DirectionsRenderer({ map: map, suppressMarkers: false });
            }
        }

        async function updateRouteMap() {
            if (!state.pickup || !state.drop) {
                routeMapWrap.style.display = 'none';
                state.distanceKm = null;
                return;
            }

            routeMapWrap.style.display = 'block';
            distanceInfo.innerHTML = 'Calculating distance…';

            try {
                const res = await fetch(`/Home/GetDistance?origin=${encodeURIComponent(state.pickup)}&destination=${encodeURIComponent(state.drop)}`);
                if (res.ok) {
                    const data = await res.json();
                    state.distanceKm = data.distanceKm;
                    state.duration = data.duration;

                            const seconds = parseInt(data.duration, 10) || 0;
        const hours = Math.floor(seconds / 3600);
        const minutes = Math.floor((seconds % 3600) / 60);

        let durationText = '';

        if (hours > 0) {
            durationText += `${hours} hr `;
        }

        if (minutes > 0 || hours === 0) {
            durationText += `${minutes} min`;
        }
                    distanceInfo.innerHTML =
                        `<span class="dkm">${data.distanceKm} km</span><span>${durationText ?? ''}</span>`;
                    updateCta();
                } else {
                    distanceInfo.textContent = 'Distance unavailable for this route';
                    state.distanceKm = null;
                }
            } catch (err) {
                distanceInfo.textContent = 'Distance unavailable';
                state.distanceKm = null;
            }

            if (googleReady) {
                ensureMap();
                directionsService.route(
                    {
                        origin: state.pickup,
                        destination: state.drop,
                        travelMode: google.maps.TravelMode.DRIVING
                    },
                    (result, status) => {
                        if (status === 'OK') {
                            directionsRenderer.setDirections(result);
                        }
                    }
                );
            }
        }

        function renderList() {
          const activeInput = state.active === 'pickup' ? pickupValue : dropValue;
          const rawQuery = activeInput.value.trim();

          // Current-location option only for pickup field
          const currentLocationHtml = state.active === 'pickup' ? `
            <div class="location-item current-location-item" id="useCurrentLocationBtn">
              <div class="location-item-icon"><i class="fa-solid fa-location-crosshairs"></i></div>
              <div class="location-item-text">
                <div class="main">Use my current location</div>
              </div>
            </div>` : '';

          if (rawQuery.length < 3) {
            locationList.innerHTML = currentLocationHtml + `
              <div style="padding:14px 4px;color:#9aa0a8;font-size:0.82rem;">
                Type at least 3 characters to search a location…
              </div>`;
            attachCurrentLocationHandler();
            return;
          }

          locationList.innerHTML = currentLocationHtml + '<div id="googlePredictions"></div>';
          attachCurrentLocationHandler();

          clearTimeout(placesDebounce);
          placesDebounce = setTimeout(() => {
            if (!googleReady) {
              document.getElementById('googlePredictions').innerHTML =
                '<div style="padding:8px 4px;color:#9aa0a8;font-size:0.8rem;">Loading Google Maps…</div>';
              return;
            }

            // Always restrict suggestions to India only, for both pickup and drop
            const request = {
              input: rawQuery,
              componentRestrictions: { country: 'in' }
            };

            autocompleteService.getPlacePredictions(request, (predictions, status) => {
              const wrap = document.getElementById('googlePredictions');
              if (!wrap) return;
              if (status !== google.maps.places.PlacesServiceStatus.OK || !predictions) {
                wrap.innerHTML = '<div style="padding:8px 4px;color:#9aa0a8;font-size:0.8rem;">No matches found</div>';
                return;
              }
              wrap.innerHTML = predictions.map((p) => `
                <div class="location-item" data-name="${p.description.replace(/"/g, '&quot;')}">
                  <div class="location-item-icon"><i class="fa-solid fa-map-pin"></i></div>
                  <div class="location-item-text">
                    <div class="main">${p.description}</div>
                  </div>
                </div>
              `).join('');
              wrap.querySelectorAll('.location-item').forEach((item) => {
                item.addEventListener('click', () => selectLocation(item.getAttribute('data-name')));
              });
            });
          }, 300);
        }

        function attachCurrentLocationHandler() {
          const btn = document.getElementById('useCurrentLocationBtn');
          if (btn) btn.addEventListener('click', useCurrentLocation);
        }


        function focusField(field) {
          state.active = field;
          pickupRow.classList.toggle('field-active', field === 'pickup');
          dropRow.classList.toggle('field-active', field === 'drop');
          listLabel.textContent = field === 'pickup' ? 'Suggested pickup points' : 'Suggested drop points';
          renderList();
        }

        // A clicked suggestion only fills whichever field is currently active
        function selectLocation(name) {
          if (state.active === 'pickup') {
            state.pickup = name;
            pickupValue.value = name;
            if (!state.drop) { focusField('drop'); return; }
          } else {
            state.drop = name;
            dropValue.value = name;
          }
          updateCta();
          renderList();
          updateRouteMap();
        }

        function swapLocations(event) {
          event.stopPropagation();
          const p = state.pickup, d = state.drop;
          state.pickup = d;
          state.drop = p;
          pickupValue.value = state.pickup;
          dropValue.value = state.drop;
          updateCta();
          updateRouteMap();
        }

        function updateCta() {
          if (state.pickup && state.drop && state.distanceKm) {
            cta.textContent = 'Confirm route';
            cta.classList.add('ready');
            const params = new URLSearchParams({
              pickup: state.pickup,
              drop: state.drop,
              distanceKm: state.distanceKm ?? '',
              duration: state.duration ?? '',
              categoryId: state.categoryId ?? ''
            });
            cta.href = `/Home/Dateview?${params.toString()}`;
          } else {
            cta.textContent = 'Choose both points to continue';
            cta.classList.remove('ready');
            cta.href = '#';
          }
        }

        function confirmRoute() {
          if (!state.pickup || !state.drop) return;
        }

        function openSheet(planName, categoryId) {
          planBadge.textContent = planName;
          document.querySelectorAll('.plan-box').forEach((box) => {
            box.classList.toggle('active', box.dataset.plan === planName);
          });
          state = { pickup: '', drop: '', active: 'pickup', distanceKm: null, categoryId: categoryId };
          pickupValue.value = '';
          dropValue.value = '';
          routeMapWrap.style.display = 'none';
          focusField('pickup');
          updateCta();
          overlay.classList.add('active');
          document.body.style.overflow = 'hidden';
        }

        function closeSheet() {
          overlay.classList.remove('active');
          document.body.style.overflow = '';
          document.querySelectorAll('.plan-box.active').forEach((box) => box.classList.remove('active'));
        }

        function toggleSidebar(open) {
          const sidebar = document.getElementById('mobileSidebar');
          sidebar.classList.toggle('open', open);
          sidebar.setAttribute('aria-hidden', !open);
          if (open) {
            document.body.style.overflow = 'hidden';
          } else if (!overlay.classList.contains('active')) {
            document.body.style.overflow = '';
          }
        }

        overlay.addEventListener('click', (e) => {
          if (e.target === overlay) closeSheet();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeSheet();
        });


        pickupValue.addEventListener('focus', () => focusField('pickup'));
        dropValue.addEventListener('focus', () => focusField('drop'));
        pickupValue.addEventListener('input', () => { state.pickup = pickupValue.value; renderList(); });
        dropValue.addEventListener('input', () => { state.drop = dropValue.value; renderList(); });

        document.querySelectorAll('.plan-box').forEach((box) => {
          box.addEventListener('click', () => {
            const planName = box.querySelector('h4').textContent;
            box.dataset.plan = planName;
            openSheet(planName, box.dataset.categoryId);
          });
        });
        document.querySelector('.book-btn').addEventListener('click', function (e) {
            e.preventDefault();


            const firstPlan = document.querySelector('.plan-box');

            if (firstPlan) {
                const planName = firstPlan.querySelector('h4').textContent.trim();
                const categoryId = firstPlan.dataset.categoryId;

                openSheet(planName, categoryId);
            }
        });
    </script>
    <script>
        function useCurrentLocation() {
          const btn = document.getElementById('useCurrentLocationBtn');
          if (!navigator.geolocation) {
            if (btn) btn.querySelector('.main').textContent = 'Location not supported on this device';
            return;
          }

          if (btn) btn.querySelector('.main').textContent = 'Fetching your location…';

          navigator.geolocation.getCurrentPosition(
            (pos) => {
              const { latitude, longitude } = pos.coords;

              if (googleReady) {
                const geocoder = new google.maps.Geocoder();
                geocoder.geocode({ location: { lat: latitude, lng: longitude } }, (results, status) => {
                  if (status === 'OK' && results[0]) {
                    const address = results[0].formatted_address;
                    if (!/india\s*$/i.test(address.trim())) {
                      if (btn) btn.querySelector('.main').textContent = 'Your current location is outside India';
                      return;
                    }
                    selectLocation(address);
                  } else {
                    if (btn) btn.querySelector('.main').textContent = 'Could not detect your location';
                  }
                });
              } else {
                if (btn) btn.querySelector('.main').textContent = 'Loading Google Maps…';
              }
            },
            (err) => {
              if (btn) btn.querySelector('.main').textContent = 'Could not fetch location, allow permission';
            },
            { enableHighAccuracy: true, timeout: 8000 }
          );
        }
    </script>

   
     <script async defer
            src="https://maps.googleapis.com/maps/api/js?key=@Model.GoogleMapsApiKey&libraries=places&callback=initGoogleMaps">
    </script>

    <div class="bottom-tab-bar" aria-label="Mobile navigation">
        <div class="bottom-tab-row">
            <a href="#" class="bottom-tab-item active">
                <i class="fa-solid fa-house"></i>
                <span>Home</span>
            </a>
            <a href="/CurrentRide" class="bottom-tab-item">
                <i class="fa-solid fa-location-dot"></i>
                <span>Ride</span>
            </a>
            <a href="/CabBookingList" class="bottom-tab-item">
                <i class="fa-solid fa-calendar-check"></i>
                <span>Bookings</span>
            </a>
            <a href="/profile" class="bottom-tab-item">
                <i class="fa-solid fa-user"></i>
                <span>Profile</span>
            </a>
        </div>
    </div>
