@using static SardarJi_Cab_Booking.Helper.SessionExtensions
@model HomeIndexViewModel
@{
    Layout = null;
    var customer = Context.Session.GetObject<CustomerVM>("customer");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>What are you planning?</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap');

        :root {
        --ink: #1c1c1e;
        --muted: #8e8e93;
        --card: #f4f4f6;
        --mint-bg: #d9f7ec;
        --mint-dark: #264796;
        --green-badge: #12b981;
        --page-bg: #ffffff;
        }

        html, body {
        background: #efeff1;
        font-family: "Montserrat", sans-serif;
        }

        h1, h2, h3, h4, h5, h6, a, span, p, div, button, input, label {
        margin: 0;
        padding: 0;
        font-family: "Montserrat", sans-serif !important;
        }

        .phone-frame {
        max-width: 390px;
        background: var(--page-bg);
        overflow: hidden;
        }

        .screen {
        padding: 18px 16px 28px;
        min-height: 760px;
        }


        .title {
        text-align: left;
        font-weight: 700;
        font-size: 1.1rem;
        color: var(--ink);
        margin-bottom: 18px;
        }

        .plan-box {
        height: 130px;
        background: #e6e6e6;
        border-radius: 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        cursor: pointer;
        border: 1px solid #f0f0f0;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08), 0 2px 8px rgba(0, 0, 0, 0.04);
        transition: all .3s ease;
        }

        .plan-box:hover {
        transform: translateY(-6px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.12), 0 8px 20px rgba(0,0,0,0.08);
        }

        .icon-bg {
        width: 70px;
        height: 70px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        }

        .icon-bg img {
        width: 127px;
        color: #e6e6e6;
        object-fit: contain;
        }

        .plan-box h4 {
        margin: 0;
        font-size: 14px;
        font-weight: 700;
        color: #222;
        letter-spacing: 1px;
        }

        .plan-box.active {
        border-color: #264796;
        box-shadow: 0 16px 36px rgba(14,159,110,0.16);
        transform: translateY(-4px);
        }

        /* CO2 banner */
        .co2-banner {
        background: linear-gradient(135deg,#d9f8ec 0%,#c7f3e2 100%);
        border-radius: 18px;
        padding: 16px 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 20px 0 22px;
        position: relative;
        overflow: hidden;
        }

        .co2-text .small-line {
        font-size: 0.78rem;
        color: #3c6b5c;
        margin-bottom: 2px;
        }

        .co2-text .big-line {
        font-weight: 800;
        font-size: 1.05rem;
        color: #12321f;
        }

        .co2-text .rides-line {
        font-size: 0.78rem;
        color: #3c6b5c;
        margin-top: 2px;
        }

        .co2-illustration {
        width: 78px;
        flex-shrink: 0;
        }

        .learn-more-btn {
        background: #ffffff;
        border-radius: 20px;
        padding: 6px 12px;
        font-size: 0.72rem;
        font-weight: 700;
        color: #12321f;
        white-space: nowrap;
        box-shadow: 0 1px 4px rgba(0,0,0,0.08);
        }

        .co2-row {
        display: flex;
        flex-direction: column;
        gap: 2px;
        z-index: 2;
        }

        /* Elevate section */
        .elevate-title {
        text-align: center;
        font-weight: 700;
        font-size: 1.05rem;
        color: var(--ink);
        margin-bottom: 14px;
        }

        .elevate-scroll {
        display: flex;
        gap: 10px;
        overflow-x: auto;
        padding-bottom: 6px;
        scrollbar-width: none;
        }

        .elevate-scroll::-webkit-scrollbar {
        display: none;
        }

        .elevate-card {
        position: relative;
        flex: 0 0 108px;
        height: 150px;
        border-radius: 14px;
        overflow: hidden;
        background-size: cover;
        background-position: center;
        }

        .elevate-card::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0.05) 55%);
        }

        .elevate-label {
        position: absolute;
        bottom: 8px;
        left: 8px;
        right: 8px;
        color: #fff;
        font-weight: 800;
        font-size: 0.68rem;
        line-height: 1.15;
        letter-spacing: 0.02em;
        z-index: 2;
        text-transform: uppercase;
        }


        .sheet-overlay {
        position: fixed;
        inset: 0;
        background: rgba(17,20,18,0.45);
        display: none;
        align-items: flex-end;
        justify-content: center;
        z-index: 1000;
        opacity: 0;
        transition: opacity .25s ease;
        }

        .sheet-overlay.active {
        display: flex;
        opacity: 1;
        z-index: 99999;
        }

        .sheet {
        width: 100%;
        max-width: 390px;
        background: #fff;
        border-radius: 24px 24px 0 0;
        padding: 10px 20px 22px;
        transform: translateY(100%);
        transition: transform .32s cubic-bezier(.25,.8,.35,1);
        box-shadow: 0 -12px 40px rgba(0,0,0,0.18);
        }

        .sheet-overlay.active .sheet {
        transform: translateY(0);
        }


        .sheet-handle {
        width: 36px;
        height: 4px;
        border-radius: 99px;
        background: #e2e4e8;
        margin: 6px auto 16px;
        }

        .sheet-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 4px;
        }

        .sheet-title {
        font-size: 1.02rem;
        font-weight: 700;
        color: var(--ink);
        margin: 0;
        }

        .sheet-close {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: #f3f4f6;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6b7280;
        font-size: 14px;
        line-height: 1;
        cursor: pointer;
        }

        .sheet-close:hover {
        background: #e9ebee;
        }

        .sheet-plan-badge {
        display: inline-block;
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.05em;
        color: var(--mint-dark);
        background: var(--mint-bg);
        padding: 4px 10px;
        border-radius: 99px;
        margin: 10px 0 18px;
        }

        .mobile-header {
        display: none;
        width: 100%;
        margin: 14px 0 14px;
        padding: 16px 18px 16px;
        background: #fff;
        border-radius: 28px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
        }

        .mobile-header-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        }

        .mobile-header-logo {
        width: 42px;
        height: 42px;
        border-radius: 16px;
        background: #264796;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 18px;
        font-weight: 800;
        }

        .mobile-header-title-wrap {
        min-width: 0;
        }

        .mobile-header-title {
        font-size: 1rem;
        font-weight: 800;
        color: var(--ink);
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        }

        .mobile-header-subtitle {
        font-size: 0.78rem;
        color: #6b7280;
        margin-top: 4px;
        margin-bottom: 0;
        }

        .mobile-header-action {
        width: 38px;
        height: 38px;
        background: #f3f4f6;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6b7280;
        font-size: 16px;
        border: none;
        cursor: pointer;
        }

        .mobile-header-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 16px;
        }

        .mobile-header-chip {
        flex: 1;
        min-width: 0;
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 999px;
        padding: 10px 14px;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.82rem;
        color: #334155;
        }

        .mobile-sidebar {
        position: fixed;
        top: 0;
        left: -320px;
        width: 280px;
        height: 100vh;
        background: #fff;
        box-shadow: 12px 0 36px rgba(0,0,0,0.16);
        padding: 24px 18px;
        transition: left .28s ease;
        z-index: 1200;
        }

        .mobile-sidebar.open {
        left: 0;
        }

        .sidebar-close {
        width: 36px;
        height: 36px;
        border-radius: 14px;
        border: none;
        background: #f3f4f6;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6b7280;
        cursor: pointer;
        margin-bottom: 24px;
        }

        .sidebar-logo {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 24px;
        }

        .sidebar-logo-icon {
        width: 46px;
        height: 46px;
        border-radius: 16px;
        background: #264796;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 18px;
        font-weight: 800;
        }

        .sidebar-logo-text {
        display: flex;
        flex-direction: column;
        }

        .sidebar-logo-text .title {
        font-size: 1rem;
        font-weight: 800;
        color: var(--ink);
        margin: 0;
        }

        .sidebar-logo-text .subtitle {
        font-size: 0.78rem;
        color: #6b7280;
        margin: 2px 0 0;
        }

        .sidebar-menu {
        display: grid;
        gap: 14px;
        }

        .sidebar-menu-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        border-radius: 16px;
        background: #f8fafc;
        color: #334155;
        text-decoration: none;
        font-weight: 700;
        }

        .sidebar-menu-item i {
        font-size: 16px;
        color: #264796;
        }

        .sidebar-footer {
        margin-top: 24px;
        padding: 14px 16px;
        border-radius: 18px;
        background: #264796;
        color: #fff;
        font-size: 0.92rem;
        font-weight: 700;
        }

        @@media (max-width: 768px) {
        .mobile-header {
        display: block;
        }

        .bottom-tab-bar {
        display: block;
        }

        body {
        padding-bottom: 92px;
        }
        }

        @@media (max-width: 768px) {
        .mobile-header {
        display: block;
        }
        }

        .route-block {
        position: relative;
        background: #f8fafc;
        border: 1px solid #e8eaee;
        border-radius: 16px;
        padding: 6px 14px;
        }

        .mobile-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        }

        .route-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 0;
        }

        .route-row + .route-row {
        border-top: 1px dashed #e0e3e8;
        }

        .route-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
        }

        .route-icon {
        width: 30px;
        height: 30px;
        border-radius: 10px;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--mint-dark);
        font-size: 13px;
        flex-shrink: 0;
        border: 1px solid #e8eaee;
        }

        .route-dot.pickup {
        background: var(--mint-dark);
        }

        .route-dot.drop {
        background: #1c1c1e;
        border: 2px solid #1c1c1e;
        background: #fff;
        }

        .route-field {
        flex: 1;
        min-width: 0;
        }

        .route-field-label {
        font-size: 0.68rem;
        font-weight: 700;
        color: #9aa0a8;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 2px;
        }

        .route-field-value {
        font-size: 0.92rem;
        font-weight: 600;
        color: var(--ink);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        }

        .route-field-value.placeholder {
        color: #b5b9c0;
        font-weight: 500;
        }


        .route-field-input {
        border: none;
        outline: none;
        background: transparent;
        width: 100%;
        font-size: 0.92rem;
        font-weight: 600;
        font-family: "Montserrat", sans-serif;
        color: var(--ink);
        padding: 0;
        }

        .route-field-input::placeholder {
        color: #b5b9c0;
        font-weight: 500;
        }

        .route-row.field-active {
        background: var(--mint-bg);
        border-radius: 10px;
        margin: 0 -8px;
        padding-left: 8px;
        padding-right: 8px;
        }

        .swap-btn {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #fff;
        border: 1px solid #e2e4e8;
        box-shadow: 0 2px 6px rgba(0,0,0,0.06);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 14px;
        color: var(--mint-dark);
        }

        .swap-btn:hover {
        background: var(--mint-bg);
        }

        .field-active {
        background: var(--mint-bg);
        border-radius: 10px;
        margin: 0 -8px;
        padding-left: 8px;
        padding-right: 8px;
        }

        .sheet-section-label {
        font-size: 0.72rem;
        font-weight: 700;
        color: #9aa0a8;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin: 18px 0 8px;
        }

        .location-list {
        max-height: 220px;
        overflow-y: auto;
        }

        .location-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 11px 4px;
        border-radius: 12px;
        cursor: pointer;
        }

        .location-item:hover {
        background: #f4f4f6;
        }

        .location-item-icon {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: var(--card);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6b7280;
        font-size: 15px;
        flex-shrink: 0;
        }

        .location-item-text .main {
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--ink);
        }

        .location-item-text .sub {
        font-size: 0.74rem;
        color: var(--muted);
        margin-top: 1px;
        }

        .sheet-cta {
        width: 100%;
        margin-top: 18px;
        border: none;
        border-radius: 14px;
        padding: 14px;
        background: #d8dade;
        color: #8b8f96;
        font-weight: 700;
        font-size: 0.94rem;
        transition: all .2s ease;
        }

        .sheet-cta.ready {
        background: var(--mint-dark);
        color: #fff;
        box-shadow: 0 8px 20px rgba(14, 159, 110, 0.28);
        cursor: pointer;
        display: flex;
        justify-content: center;
        align-items: center;
        text-decoration: none;
        }



        .bottom-tab-bar {
        display: none;
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 1100;
        background: #ffffff;
        border-top: 1px solid rgba(38,71,150,.12);
        box-shadow: 0 -12px 30px rgba(0,0,0,0.08);
        padding: 10px 0;
        }

        .bottom-tab-row {
        max-width: 420px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 6px;
        padding: 0 10px;
        }

        .bottom-tab-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 4px;
        font-size: 0.72rem;
        color: #6b7280;
        text-decoration: none;
        padding: 10px 0;
        border-radius: 18px;
        transition: background .2s, color .2s;
        }

        .bottom-tab-item:hover {
        background: rgba(38,71,150,.06);
        color: #264796;
        }

        .bottom-tab-item i {
        font-size: 18px;
        }

        .bottom-tab-item.active {
        color: #264796;
        background: rgba(38,71,150,.12);
        }

        .bottom-tab-item.active i {
        color: #264796;
        }

        @@media (max-width: 768px) {
        .mobile-header {
        display: block;
        }


        .mobile-header-action.extt{
        display:none !important;
        }
        .bottom-tab-bar {
        display: block;
        }

        body {
        padding-bottom: 92px;
        }
        }

        @@media (min-width: 769px) {
        .phone-frame {
        max-width: 40%;
        width:45%;
        height: 100vh;
        width: 100%;
        overflow-y: scroll;
        }
        .mobile-sidebar{
        z-index: 999999;
        }

        button.mobile-header-action {
        POSITION: absolute;
        RIGHT: 43%;
        TOP: 20PX;
        Z-INDEX: 999;
        }

        .sheet {
        width: 100%;
        max-width: 639px;
        HEIGHT: 100%;
        border-radius: 0;
        overflow-y: scroll;
        }

        .sheet-overlay.active {
        justify-content: flex-end;
        ALIGN-ITEMS: baseline;
        HEIGHT: 100%;
        }

        .Main_page {
        display: flex;
        justify-content: space-between;
        }

        .phone-frame1 {
        max-width: 65%;
        width: 65%;
        }

        .phone-frame1 img {
        width: 100%;
        height: 100vh;
        }
        }

        @@media (max-width: 768px) {
        .phone-frame1 {
        display: none;
        }
        }

        .phone-frame1 {
        position: relative;
        overflow: hidden;
        border-radius: 0px;
        }

        .phone-frame1 img {
        width: 100%;
        display: block;
        }

        .phone-frame1::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient( 90deg, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.45) 35%, rgba(0,0,0,0) 70% );
        }

        .banner-content {
        position: absolute;
        top: 50%;
        left: 60px;
        transform: translateY(-50%);
        color: #fff;
        z-index: 2;
        max-width: 420px;
        }

        .tag-line {
        display: inline-block;
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(8px);
        padding: 8px 18px;
        border-radius: 0px;
        font-size: 13px;
        letter-spacing: 2px;
        margin-bottom: 20px;
        }

        .banner-content h1 {
        font-size: 56px;
        font-weight: 700;
        line-height: 1.1;
        margin-bottom: 15px;
        text-transform: uppercase;
        }

        .banner-content p {
        font-size: 18px;
        color: rgba(255,255,255,0.9);
        margin-bottom: 30px;
        }

        .book-btn {
        display: inline-block;
        background: #0B1F5A;
        color: #fff;
        padding: 14px 32px;
        border-radius: 50px;
        text-decoration: none;
        font-weight: 600;
        transition: .3s;
        }

        .book-btn:hover {
        background: #15338b;
        color: #fff;
        }

        .logo {
        position: absolute;
        max-width: 180px;
        top: 12px;
        z-index: 99999;
        left: 53px;
        }

        .logo img {
        width: 100%;
        height: auto;
        }


        @@media(max-width:768px) {
        .banner-content {
        left: 25px;
        right: 25px;
        }

        .logo {
        display: none;
        }


        .banner-content h1 {
        font-size: 36px;
        }

        .banner-content p {
        font-size: 15px;
        }
        }


        .route-map-wrap {
        margin-top: 14px;
        display: none;
        }

        .route-map {
        width: 100%;
        height: 180px;
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid #e8eaee;
        }

        .distance-info {
        margin-top: 8px;
        padding: 10px 14px;
        background: #f8fafc;
        border-radius: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.86rem;
        font-weight: 700;
        color: var(--ink);
        }

        .distance-info .dkm {
        color: var(--mint-dark);
        }

        .google-pred-label {
        font-size: 0.68rem;
        font-weight: 700;
        color: #9aa0a8;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin: 10px 0 6px;
        }

        .current-location-item {
        border-bottom: 1px solid #eee;
        color: #2563eb;
        }

        .current-location-item .location-item-icon i {
        color: #2563eb;
        }

        .sidebar-logo-icon > img {
        height: 50px;
        border-radius: 12px;
        }

        .mobile-header-logo>img{
        height: 50px;
        border-radius: 12px;
        }
    </style>
</head>
<body>
    <div class="logo_travel">
        <div class="logo"><img src="https://adminsardarji.traviyo.in/images/LogoSardar.png" alt="Sardar Ji Cabs" /></div>

        <button class="mobile-header-action extt" type="button" aria-label="Open menu" onclick="toggleSidebar(true)">
            <i class="fa-solid fa-bars"></i>
        </button>

