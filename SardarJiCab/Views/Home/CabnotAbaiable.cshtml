@{
    ViewData["Title"] = "No Cabs Available";
    var message = ViewBag.Message ?? "We couldn't find any cabs in your area right now.";
    var subMessage = ViewBag.SubMessage ?? "This usually happens during peak hours or in low-coverage areas. Please try again in a few minutes.";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
            background: linear-gradient(135deg, #fdf6ec 0%, #fdeee1 45%, #fbe4d8 100%);
            padding: 24px;
            overflow: hidden;
            position: relative;
        }

        /* Soft floating background shapes for charm */
        .bg-shape {
            position: absolute;
            border-radius: 50%;
            opacity: 0.25;
            filter: blur(2px);
            animation: float 6s ease-in-out infinite;
        }

            .bg-shape.one {
                width: 140px;
                height: 140px;
                background: #ffb385;
                top: 8%;
                left: 10%;
                animation-delay: 0s;
            }

            .bg-shape.two {
                width: 90px;
                height: 90px;
                background: #ffd28a;
                bottom: 12%;
                right: 12%;
                animation-delay: 1.5s;
            }

            .bg-shape.three {
                width: 60px;
                height: 60px;
                background: #ff9d76;
                top: 18%;
                right: 18%;
                animation-delay: 3s;
            }

        @@keyframes float {
            0%, 100% {
                transform: translateY(0px);
            }

            50% {
                transform: translateY(-18px);
            }
        }

        .card {
            position: relative;
            z-index: 2;
            background: #ffffff;
            border-radius: 28px;
            padding: 48px 40px;
            max-width: 420px;
            width: 100%;
            text-align: center;
            box-shadow: 0 20px 60px rgba(233, 128, 68, 0.18), 0 2px 8px rgba(0,0,0,0.04);
            animation: riseIn 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @@keyframes riseIn {
            from {
                opacity: 0;
                transform: translateY(24px) scale(0.97);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .illustration {
            width: 180px;
            height: 180px;
            margin: 0 auto 8px;
        }

        .road {
            position: relative;
            height: 6px;
            background: #f1e3d3;
            border-radius: 3px;
            margin: 8px auto 24px;
            width: 80%;
            overflow: hidden;
        }

            .road::after {
                content: "";
                position: absolute;
                top: 0;
                left: -40%;
                width: 40%;
                height: 100%;
                background: repeating-linear-gradient( 90deg, #e8a06b 0px, #e8a06b 12px, transparent 12px, transparent 24px );
                animation: drift 2.4s linear infinite;
            }

        @@keyframes drift {
            from {
                left: -40%;
            }

            to {
                left: 100%;
            }
        }

        h1 {
            font-size: 22px;
            color: #3a2b22;
            margin-bottom: 12px;
            font-weight: 700;
        }

        p.message {
            color: #6b5a4d;
            font-size: 15px;
            line-height: 1.55;
            margin-bottom: 6px;
        }

        p.sub-message {
            color: #a3927f;
            font-size: 13.5px;
            line-height: 1.5;
            margin-bottom: 28px;
        }

        .actions {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #ff9a5a, #f9714f);
            color: #fff;
            border: none;
            padding: 14px 20px;
            border-radius: 14px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
            box-shadow: 0 8px 20px rgba(249, 113, 79, 0.35);
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 12px 24px rgba(249, 113, 79, 0.42);
            }

        .btn-secondary {
            background: transparent;
            color: #b0785a;
            border: none;
            padding: 10px 20px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: underline;
            text-underline-offset: 3px;
        }

            .btn-secondary:hover {
                color: #8f5c41;
            }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #fff2e6;
            color: #d97b45;
            font-size: 12px;
            font-weight: 600;
            padding: 6px 14px;
            border-radius: 999px;
            margin-bottom: 20px;
        }

            .badge .dot {
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: #d97b45;
                animation: pulse 1.4s ease-in-out infinite;
            }

        @@keyframes pulse {
            0%, 100% {
                opacity: 1;
            }

            50% {
                opacity: 0.3;
            }
        }

        @@media (max-width: 480px) {
            .card {
                padding: 36px 26px;
                border-radius: 22px;
            }

            .illustration {
                width: 140px;
                height: 140px;
            }
        }
    </style>
</head>
<body>

    <div class="bg-shape one"></div>
    <div class="bg-shape two"></div>
    <div class="bg-shape three"></div>

    <div class="card">
        <div class="badge">
            <span class="dot"></span>
            Service Unavailable
        </div>

        <div class="illustration">
            <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
               
                <ellipse cx="100" cy="158" rx="58" ry="9" fill="#f3ddc8" />

             
                <g>
                    <rect x="45" y="95" width="110" height="42" rx="12" fill="#ffb385" />
                    <path d="M62 95 L75 68 Q100 58 125 68 L138 95 Z" fill="#ffb385" />
                    <path d="M66 92 L77 72 Q100 64 123 72 L134 92 Z" fill="#fff6ee" opacity="0.55" />

                   
                    <rect x="70" y="76" width="26" height="18" rx="4" fill="#fdf1e5" />
                    <rect x="104" y="76" width="26" height="18" rx="4" fill="#fdf1e5" />

                    <rect x="90" y="52" width="20" height="10" rx="2" fill="#f9714f" />

                   
                    <rect x="45" y="112" width="110" height="8" fill="#f9714f" opacity="0.85" />

                    <circle cx="70" cy="140" r="14" fill="#3a2b22" />
                    <circle cx="70" cy="140" r="6" fill="#cfc3b8" />
                    <circle cx="130" cy="140" r="14" fill="#3a2b22" />
                    <circle cx="130" cy="140" r="6" fill="#cfc3b8" />
                </g>

               
                <g>
                    <circle cx="150" cy="55" r="22" fill="#ffffff" stroke="#f9714f" stroke-width="3" />
                    <line x1="139" y1="44" x2="161" y2="66" stroke="#f9714f" stroke-width="4" stroke-linecap="round" />
                    <line x1="161" y1="44" x2="139" y2="66" stroke="#f9714f" stroke-width="4" stroke-linecap="round" />
                </g>
            </svg>
        </div>

        <div class="road"></div>

        <h1>No Cabs Nearby</h1>
        <p class="message">@message</p>
        <p class="sub-message">@subMessage</p>

        <div class="actions">
            <button type="button" class="btn-primary" onclick="window.location.href='/Home/Index'">
                Go Back
            </button>
            <button type="button" class="btn-secondary" onclick="window.location.href='tel:99990350250'">
                Call Now
            </button>
        </div>
    </div>

</body>
</html>
