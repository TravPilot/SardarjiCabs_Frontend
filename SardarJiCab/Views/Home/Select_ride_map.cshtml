    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
    <script>
        let selectedCard = document.querySelector('.car-card.selected');

        function selectCard(el){
            document.querySelectorAll('.car-card').forEach(c => c.classList.remove('selected'));
            el.classList.add('selected');
            selectedCard = el;
        }

        document.getElementById('confirmRideBtn').addEventListener('click', () => {
            if (!selectedCard) return;
            const params = new URLSearchParams({
                pickup: @Html.Raw(Json.Serialize(Model.Pickup ?? "")),
                drop: @Html.Raw(Json.Serialize(Model.Drop ?? "")),
                distanceKm: @Html.Raw(Json.Serialize(Model.DistanceKm)),
                date: @Html.Raw(Json.Serialize(Model.RideDate ?? "")),
                time: @Html.Raw(Json.Serialize(Model.RideTime ?? "")),
                carId: selectedCard.getAttribute('data-car-id'),
                carName: selectedCard.getAttribute('data-car-name'),
                cost: selectedCard.getAttribute('data-cost')
            });
            window.location.href = `/Home/travel_summary_ticket?${params.toString()}`;
        });

      
        const pickup = {
            lat: @Model.PickupLat.ToString(System.Globalization.CultureInfo.InvariantCulture),
            lng: @Model.PickupLng.ToString(System.Globalization.CultureInfo.InvariantCulture)
        };
        const drop = {
            lat: @Model.DropLat.ToString(System.Globalization.CultureInfo.InvariantCulture),
            lng: @Model.DropLng.ToString(System.Globalization.CultureInfo.InvariantCulture)
        };

        const map = L.map('map', {
            zoomControl: false,
            attributionControl: true,
            dragging: true,
            scrollWheelZoom: false,
            tap: true
        });

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; OpenStreetMap'
        }).addTo(map);

        const bounds = L.latLngBounds([[pickup.lat, pickup.lng], [drop.lat, drop.lng]]);
        map.fitBounds(bounds, { paddingTopLeft: [20, 90], paddingBottomRight: [20, 40] });

        const pickupIcon = L.divIcon({ className: '', html: '<div class="pin pickup"></div>', iconSize: [22, 22], iconAnchor: [11, 20] });
        const dropIcon   = L.divIcon({ className: '', html: '<div class="pin drop"></div>', iconSize: [22, 22], iconAnchor: [11, 20] });

        L.marker([pickup.lat, pickup.lng], { icon: pickupIcon }).addTo(map);
        L.marker([drop.lat, drop.lng], { icon: dropIcon }).addTo(map);

       
        let routeLine = null;

        async function drawRoute(pickup, drop) {
            const url = `https://router.project-osrm.org/route/v1/driving/${pickup.lng},${pickup.lat};${drop.lng},${drop.lat}?overview=full&geometries=geojson`;
            try {
                const res = await fetch(url);
                const data = await res.json();
                if (data.code !== "Ok" || !data.routes.length) throw new Error("No route found");

                const coords = data.routes[0].geometry.coordinates.map(c => [c[1], c[0]]);
                if (routeLine) map.removeLayer(routeLine);

                routeLine = L.polyline(coords, {
                    color: "#1F7A5C",
                    weight: 4,
                    opacity: 0.85,
                    dashArray: "1, 10",
                    lineCap: "round"
                }).addTo(map);

                map.fitBounds(routeLine.getBounds(), { padding: [40, 40] });

                const distanceKm = (data.routes[0].distance / 1000).toFixed(1);
                document.querySelector(".km-line").textContent = `${distanceKm} km`;
            } catch (err) {
                console.warn("Routing failed, falling back to straight line", err);
                if (routeLine) map.removeLayer(routeLine);
                routeLine = L.polyline([[pickup.lat, pickup.lng], [drop.lat, drop.lng]], {
                    color: "#1F7A5C",
                    weight: 3.5,
                    dashArray: "1 9",
                    lineCap: "round"
                }).addTo(map);
            }
        }

        drawRoute(pickup, drop);
    </script>
