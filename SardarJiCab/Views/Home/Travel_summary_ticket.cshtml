    }

    .page-title {
        font-weight: 800;
        font-size: 1rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--ink);
        margin-bottom: 2px;
    }

    .page-sub {
        font-size: 0.72rem;
        color: var(--muted);
        letter-spacing: 0.04em;
        margin-bottom: 16px;
    }

    /* Ticket card */
    .ticket {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 14px;
        position: relative;
        overflow: visible;
    }

    .stub {
        padding: 18px 20px;
    }

    /* route strip */
    .route-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 4px;
    }

    .route-code {
        font-size: 1.7rem;
        font-weight: 700;
    }

    .route-city {
        font-size: 0.68rem;
        color: var(--muted);
        letter-spacing: 0.03em;
        max-width: 100px;
    }

    .route-path {
        flex: 1;
        position: relative;
        height: 18px;
        margin: 0 10px;
        display: flex;
        align-items: center;
    }

        .route-path .dash {
            width: 100%;
            border-top: 2px dashed var(--line);
        }

        .route-path svg {
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%,-52%);
            background: var(--card);
            padding: 0 4px;
        }

    .route-time {
        text-align: center;
        font-size: 0.72rem;
        color: var(--charge);
        font-weight: 700;
        letter-spacing: 0.04em;
        margin-bottom: 18px;
    }

    .divider-label {
        font-size: 0.66rem;
        letter-spacing: 0.14em;
        color: var(--muted);
        text-transform: uppercase;
        margin-bottom: 2px;
    }

    .passenger-grid {
        display: flex;
