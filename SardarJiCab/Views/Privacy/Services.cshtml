@model AddPageVM
@{
    ViewData["Title"] = !string.IsNullOrWhiteSpace(Model?.Header) ? Model.Header : "Privacy Policy";

    var hasImage = !string.IsNullOrWhiteSpace(Model?.ImagePath);
    var imageUrl = hasImage
        ? $"https://backendportal.traviyo.com/{Model.ImagePath.TrimStart('.', '/')}"
        : "https://backendportal.traviyo.com/images/default-banner.jpg";

    var heading = !string.IsNullOrWhiteSpace(Model?.Header) ? Model.Header : "Privacy Policy";
    var hasOverview = !string.IsNullOrWhiteSpace(Model?.Overview);
}

<div class="privacy-policy-page">

    <!-- Top Banner -->
    <div class="privacy-banner">
        <img src="@imageUrl"
             alt="@heading"
             class="privacy-banner-img"
             onerror="this.onerror=null;this.src='https://backendportal.traviyo.com/images/default-banner.jpg';" />
        <div class="privacy-banner-overlay"></div>
        <h1 class="privacy-banner-title">@heading</h1>
    </div>

    <!-- Content -->
    <div class="privacy-content">
        @if (hasOverview)
        {
            @Html.Raw(Model.Overview)
        }
        else
        {
            <div class="privacy-empty-state">
                <p>No content has been added for this page yet.</p>
            </div>
        }
    </div>

</div>

<style>
    .privacy-policy-page {
        max-width: 900px;
        margin: 0 auto;
        padding: 0 20px 40px;
        font-family: 'Segoe UI', Arial, sans-serif;
        color: #333;
        line-height: 1.75;
    }

    /* Banner */
    .privacy-banner {
        position: relative;
        width: 100%;
        border-radius: 14px;
        overflow: hidden;
        margin: 24px 0 32px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    }

    .privacy-banner-img {
        width: 100%;
        height: 300px;
        object-fit: cover;
        display: block;
        background: #f0f0f0;
    }

    .privacy-banner-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(0,0,0,0.55) 100%);
    }

    .privacy-banner-title {
        position: absolute;
        left: 28px;
        bottom: 20px;
        margin: 0;
        color: #fff;
        font-size: 2rem;
        font-weight: 700;
        text-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
    }

    /* Content */
    .privacy-content {
        background: #fff;
        border-radius: 12px;
        padding: 8px 4px;
        font-size: 1rem;
        color: #444;
    }

        .privacy-content h2 {
            margin-top: 28px;
            margin-bottom: 10px;
            font-size: 1.3rem;
            color: #222;
            border-bottom: 1px solid #eee;
            padding-bottom: 6px;
        }

        .privacy-content p {
            margin-bottom: 14px;
        }

        .privacy-content ul {
            margin-left: 20px;
            margin-bottom: 14px;
        }

        .privacy-content img {
            max-width: 100%;
            border-radius: 8px;
        }

    .privacy-empty-state {
        text-align: center;
        padding: 40px 20px;
        color: #999;
        font-style: italic;
        background: #fafafa;
        border-radius: 10px;
        border: 1px dashed #ddd;
    }

    /* Responsive */
    @@media (max-width: 600px) {
        .privacy-banner-img {
            height: 200px;
        }

        .privacy-banner-title {
            font-size: 1.4rem;
            left: 16px;
            bottom: 14px;
        }
    }
</style>
