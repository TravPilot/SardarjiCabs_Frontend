@{
    ViewData["Title"] = "Ticket Submitted";
}
<style>
    /* Ticket Submitted Page */
    .ticket-success-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 15px;
        background: linear-gradient(135deg, #eefaf3 0%, #f5f9ff 50%, #fdf4ff 100%);
        position: relative;
        overflow: hidden;
    }

        /* Decorative circles */
        .ticket-success-page::before,
        .ticket-success-page::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            filter: blur(2px);
            z-index: 0;
        }

        .ticket-success-page::before {
            width: 300px;
            height: 300px;
            background: rgba(25, 135, 84, 0.12);
            top: -100px;
            left: -100px;
        }

        .ticket-success-page::after {
            width: 350px;
            height: 350px;
            background: rgba(111, 66, 193, 0.10);
            bottom: -150px;
            right: -120px;
        }

    /* Main Card */
    .ticket-success-card {
        width: 100%;
        max-width: 600px;
        background: rgba(255, 255, 255, 0.88);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: 24px;
        padding: 55px 35px;
        text-align: center;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.10);
        position: relative;
        z-index: 1;
        animation: cardAppear 0.7s ease-out;
    }

    /* Success Icon */
    .success-icon {
        width: 90px;
        height: 90px;
        margin: 0 auto 25px;
        border-radius: 50%;
        background: linear-gradient(135deg, #198754, #20c997);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 45px;
        font-weight: bold;
        box-shadow: 0 12px 30px rgba(25, 135, 84, 0.30);
        animation: successPop 0.7s ease-out;
    }

    /* Heading */
    .ticket-success-card h1 {
        color: #1f2937;
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 12px;
        letter-spacing: -0.5px;
    }

    /* Message */
    .ticket-success-card p {
        color: #6b7280;
        font-size: 16px;
        line-height: 1.7;
        margin-bottom: 30px;
    }

    /* Button */
    .ticket-success-btn {
        display: inline-block;
        padding: 13px 28px;
        border-radius: 50px;
        background: linear-gradient(135deg, #0d6efd, #6610f2);
        color: #fff !important;
        text-decoration: none;
        font-size: 15px;
        font-weight: 600;
        border: none;
        box-shadow: 0 8px 20px rgba(13, 110, 253, 0.25);
        transition: all 0.3s ease;
    }

        .ticket-success-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 28px rgba(13, 110, 253, 0.35);
            background: linear-gradient(135deg, #0b5ed7, #520dc2);
        }

    /* Animations */
    @@keyframes successPop {
        0%

    {
        opacity: 0;
        transform: scale(0.4);
    }

    70% {
        transform: scale(1.12);
    }

    100% {
        opacity: 1;
        transform: scale(1);
    }

    }

    @@keyframes cardAppear {
        0%

    {
        opacity: 0;
        transform: translateY(30px);
    }

    100% {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* Mobile */
    @@media (max-width: 576px) {
        .ticket-success-card

    {
        padding: 40px 22px;
        border-radius: 20px;
    }

    .success-icon {
        width: 75px;
        height: 75px;
        font-size: 36px;
    }

    .ticket-success-card h1 {
        font-size: 26px;
    }

    .ticket-success-card p {
        font-size: 15px;
    }

    .ticket-success-btn {
        width: 100%;
    }

    }
</style>



<div class="ticket-success-page">

    <div class="ticket-success-card">

        <div class="success-icon">
            &#10003;
        </div>

        <h1>Ticket Submitted Successfully!</h1>

        <p>
            @(TempData["SupportSuccessMessage"]
                ?? "Thanks for reaching out — our support team will follow up by email soon.")
        </p>

        <a asp-controller="Reports"
           asp-action="SupportReview"
           class="ticket-success-btn">
            Submit Another Ticket
        </a>

    </div>
  
</div>

