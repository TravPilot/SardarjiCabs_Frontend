                        <div class="stat-icon"><i class="fa-solid fa-star"></i></div>
                        <div class="num">@Model.AverageRating.ToString("0.0")</div>
                        <div class="lbl">Average rating</div>
                    </div>
                    <div class="stat-card co2">
                        <div class="stat-icon"><i class="fa-solid fa-leaf"></i></div>
                        <div class="num">@Model.TotalCo2SavedKg.ToString("0.0")kg</div>
                        <div class="lbl">CO&#8322; saved</div>
                    </div>
                </div>

                <!-- ===================== QUICK ACTIONS ===================== -->
                <div class="section-title">Quick actions</div>
                <div class="action-row">
                    <a href="@Url.Action("Index", "DriverTrips")" class="action-chip">
                        <div class="ic"><i class="fa-solid fa-calendar-check"></i></div>
                        <span>My Trips</span>
                    </a>
                    <a href="@Url.Action("Index", "DriverEarnings")" class="action-chip">
                        <div class="ic"><i class="fa-solid fa-wallet"></i></div>
                        <span>Earnings</span>
                    </a>
                    <a href="@Url.Action("Index", "DriverDocuments")" class="action-chip">
                        <div class="ic"><i class="fa-solid fa-id-card"></i></div>
                        <span>Documents</span>
                    </a>
                    <a href="@Url.Action("Index", "DriverSupport")" class="action-chip">
                        <div class="ic"><i class="fa-solid fa-headset"></i></div>
                        <span>Support</span>
                    </a>
                    <a href="@Url.Action("Index", "DriverProfile")" class="action-chip">
                        <div class="ic"><i class="fa-solid fa-user"></i></div>
                        <span>Profile</span>
                    </a>
                </div>

                <!-- ===================== CO2 IMPACT BANNER ===================== -->
                <div class="impact-banner">
                    <div class="txt">
                        <div class="small">Your electric rides have saved</div>
                        <div class="big">@Model.TotalCo2SavedKg.ToString("0.0") Kg CO&#8322; so far</div>
                    </div>
                    <i class="fa-solid fa-car-side"></i>
                </div>

                <!-- ===================== RECENT TRIPS ===================== -->
                <div class="section-title">Recent trips <a href="@Url.Action("Index", "DriverTrips")">View all</a></div>
                <div class="trip-list">
                    @if (Model.RecentTrips != null && Model.RecentTrips.Any())
                    {
                        foreach (var trip in Model.RecentTrips)
                        {
                            <div class="trip-item">
                                <div class="trip-icon"><i class="fa-solid fa-car"></i></div>
                                <div class="trip-info">
                                    <div class="route">@trip.PickupArea &rarr; @trip.DropArea</div>
                                    <div class="when">@trip.CompletedAt.ToString("dd MMM, hh:mm tt")</div>
                                </div>
                                <div class="trip-amount">
                                    <div class="amt">₹@trip.Fare.ToString("N0")</div>
                                    <div class="status @(trip.Status == "Cancelled" ? "cancelled" : "completed")">@trip.Status</div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fa-solid fa-road"></i>
                            <p>No trips yet. Go online to start receiving ride requests.</p>
                        </div>
                    }
                </div>

            </div>

            <!-- ===================== BOTTOM TAB BAR (mobile) ===================== -->
            <div class="bottom-tab-bar">
                <div class="bottom-tab-row">
                    <a href="@Url.Action("Index", "DriverDashboard")" class="bottom-tab-item active">
                        <i class="fa-solid fa-house"></i><span>Home</span>
                    </a>
                    <a href="@Url.Action("Index", "DriverTrips")" class="bottom-tab-item">
                        <i class="fa-solid fa-calendar-check"></i><span>Trips</span>
                    </a>
                    <a href="@Url.Action("Index", "DriverEarnings")" class="bottom-tab-item">
                        <i class="fa-solid fa-wallet"></i><span>Earnings</span>
                    </a>
                    <a href="@Url.Action("Index", "DriverProfile")" class="bottom-tab-item">
                        <i class="fa-solid fa-user"></i><span>Profile</span>
                    </a>
                </div>
            </div>

        </div><!-- /.content-pane -->
    </div><!-- /.app-shell -->

    <script>
        const toggle = document.getElementById('onlineToggle');
        const statusDot = document.getElementById('statusDot');
        const statusTitle = document.getElementById('statusTitle');
        const statusSub = document.getElementById('statusSub');

        toggle.addEventListener('change', async function () {
          const goingOnline = this.checked;
          const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

          try {
            const res = await fetch('@Url.Action("SetOnlineStatus", "DriverDashboard")', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                ...(token ? { 'RequestVerificationToken': token } : {})
              },
              body: new URLSearchParams({ isOnline: goingOnline, __RequestVerificationToken: token || '' })
            });
            const data = await res.json();

            if (data.success) {
              statusDot.classList.toggle('online', goingOnline);
              statusDot.classList.toggle('offline', !goingOnline);
              statusTitle.textContent = goingOnline ? "You're online" : "You're offline";
              statusSub.textContent = goingOnline ? "Ready to receive trip requests" : "Go online to start receiving trips";
            } else {
              this.checked = !goingOnline; // revert on failure
              alert(data.message || 'Could not update your status. Please try again.');
            }
          } catch {
            this.checked = !goingOnline;
            alert('Network error — please check your connection.');
          }
        });

        function respondToTrip(accepted) {
          // TODO: wire to /DriverDashboard/RespondToTrip with the active trip id
          document.getElementById('tripRequestCard').classList.remove('show');
        }
    </script>

    @functions {
        string GetInitials(string fullName)
        {
            if (string.IsNullOrWhiteSpace(fullName)) return "D";
            var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpper()
            : parts[0][0].ToString().ToUpper();
        }
    }

</body>
</html>
