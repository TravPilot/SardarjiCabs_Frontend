@{
    ViewData["Title"] = "Driver Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Driver Login | Sardar Ji EV</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap');

        :root {
            --navy: #16265A;
            --navy-deep: #0B1533;
            --terracotta: #D6491F;
            --terracotta-2: #EF7A3C;
            --bg: #F5F4F1;
            --card: #FFFFFF;
            --ink: #171B24;
            --muted: #767C8A;
            --line: #E7E5E0;
            --ev-green: #1E8F5F;
            --error: #C0392B;
            --focus-ring: rgba(214,73,31,0.22);
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
        }

        body {
            background: var(--bg);
            font-family: "Inter",sans-serif;
            color: var(--ink);
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        h1, h2, h3, h4, .display {
            font-family: "Space Grotesk",sans-serif;
        }

        a {
            text-decoration: none;
        }

        .layout {
            display: flex;
            min-height: 100vh;
            width: 100%;
        }

        /* ---------------- LEFT VISUAL PANE (hidden on mobile) ---------------- */
        .visual-pane {
            display: none;
            position: relative;
            flex: 1 1 52%;
            background: linear-gradient(135deg, rgba(11,21,51,0.88) 0%, rgba(22,38,90,0.72) 45%, rgba(214,73,31,0.55) 100%), url('https://images.unsplash.com/photo-1449965408869-eaa3f722e40d?w=1200&q=80') center/cover no-repeat;
            overflow: hidden;
            padding: 56px;
        }

        .route-svg {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }

        .route-path {
            fill: none;
            stroke: rgba(255,255,255,0.55);
            stroke-width: 2;
            stroke-dasharray: 2 14;
            stroke-linecap: round;
        }

        .route-pulse {
            fill: var(--terracotta-2);
            filter: drop-shadow(0 0 6px rgba(239,122,60,0.9));
        }

        .visual-content {
            position: relative;
            z-index: 2;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .visual-brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .visual-brand .mark {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                background: linear-gradient(135deg,var(--terracotta),var(--terracotta-2));
                display: flex;
                align-items: center;
                justify-content: center;
                color: #fff;
                font-weight: 700;
                font-size: 18px;
                font-family: "Space Grotesk",sans-serif;
                flex-shrink: 0;
            }

            .visual-brand .word {
                color: #fff;
                font-weight: 700;
                font-size: 1.15rem;
                letter-spacing: 0.01em;
            }

                .visual-brand .word small {
                    display: block;
                    color: rgba(255,255,255,0.65);
                    font-family: "Inter",sans-serif;
                    font-weight: 600;
                    font-size: 0.62rem;
                    letter-spacing: 0.16em;
                    text-transform: uppercase;
                    margin-top: 2px;
                }

        .visual-quote {
            max-width: 400px;
        }

            .visual-quote .eyebrow {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                color: rgba(255,255,255,0.85);
                font-size: 0.72rem;
                font-weight: 700;
                letter-spacing: 0.18em;
                text-transform: uppercase;
                margin-bottom: 18px;
            }

                .visual-quote .eyebrow i {
                    color: var(--terracotta-2);
                }

            .visual-quote h2 {
                color: #fff;
                font-size: 2.1rem;
                line-height: 1.22;
                font-weight: 700;
                margin: 0 0 14px;
            }

            .visual-quote p {
                color: rgba(255,255,255,0.75);
                font-size: 0.95rem;
                line-height: 1.6;
                margin: 0;
            }

        .visual-stats {
            display: flex;
            gap: 28px;
        }

            .visual-stats .stat {
                color: #fff;
            }

                .visual-stats .stat .num {
                    font-family: "Space Grotesk",sans-serif;
                    font-weight: 700;
                    font-size: 1.5rem;
                    line-height: 1;
                }

                .visual-stats .stat .lbl {
                    color: rgba(255,255,255,0.6);
                    font-size: 0.72rem;
                    margin-top: 6px;
                    letter-spacing: 0.02em;
                }

        /* ---------------- RIGHT FORM PANE ---------------- */
        .form-pane {
            flex: 1 1 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 32px 20px 40px;
            position: relative;
        }

        .form-wrap {
            width: 100%;
            max-width: 396px;
        }

        .top-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 34px;
        }

            .top-brand .mark {
                width: 46px;
                height: 46px;
                border-radius: 13px;
                background: linear-gradient(135deg,var(--terracotta),var(--terracotta-2));
                display: flex;
                align-items: center;
                justify-content: center;
                color: #fff;
                font-weight: 700;
                font-size: 18px;
                font-family: "Space Grotesk",sans-serif;
                box-shadow: 0 8px 18px rgba(214,73,31,0.28);
                flex-shrink: 0;
            }

            .top-brand .word {
                font-weight: 700;
                font-size: 1.12rem;
                color: var(--navy);
                line-height: 1.15;
            }

                .top-brand .word span {
                    display: block;
                    color: var(--muted);
                    font-weight: 600;
                    font-size: 0.66rem;
                    letter-spacing: 0.14em;
                    text-transform: uppercase;
                    margin-top: 3px;
                }

        .eyebrow-tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #EFF2FA;
            color: var(--navy);
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 5px 12px;
            border-radius: 99px;
            margin-bottom: 16px;
        }

            .eyebrow-tag i {
                color: var(--ev-green);
                font-size: 0.7rem;
            }

        .form-wrap h1 {
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--ink);
            margin: 0 0 6px;
            letter-spacing: -0.01em;
        }

        .form-wrap .sub {
            color: var(--muted);
            font-size: 0.9rem;
            margin: 0 0 28px;
            line-height: 1.5;
        }

        .mode-switch {
            display: flex;
            background: #EFEEEA;
            border-radius: 12px;
            padding: 4px;
            margin-bottom: 24px;
        }

        .mode-btn {
            flex: 1;
            border: none;
            background: transparent;
            padding: 9px 0;
            border-radius: 9px;
            font-family: "Inter",sans-serif;
            font-weight: 600;
            font-size: 0.82rem;
            color: var(--muted);
            cursor: pointer;
            transition: all .18s ease;
        }

            .mode-btn.active {
                background: #fff;
                color: var(--navy);
                box-shadow: 0 3px 10px rgba(22,38,90,0.12);
            }

            .mode-btn:disabled {
                opacity: 0.5;
                cursor: not-allowed;
            }

        .field {
            margin-bottom: 18px;
        }

            .field label {
                display: block;
                font-size: 0.76rem;
                font-weight: 700;
                color: var(--ink);
                margin-bottom: 7px;
                letter-spacing: 0.01em;
            }

        .input-shell {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #FBFAF8;
            border: 1.5px solid var(--line);
            border-radius: 13px;
            padding: 0 14px;
            height: 50px;
            transition: border-color .16s ease, box-shadow .16s ease, background .16s ease;
        }

            .input-shell:focus-within {
                border-color: var(--terracotta);
                box-shadow: 0 0 0 4px var(--focus-ring);
                background: #fff;
            }

            .input-shell.error {
                border-color: var(--error);
                box-shadow: 0 0 0 4px rgba(192,57,43,0.12);
            }

            .input-shell.locked {
                background: #F1F0EC;
            }

            .input-shell .prefix {
                color: var(--muted);
                font-size: 0.86rem;
                font-weight: 600;
                border-right: 1px solid var(--line);
                padding-right: 10px;
                display: flex;
                align-items: center;
                gap: 6px;
            }

            .input-shell i {
                color: var(--muted);
                font-size: 0.85rem;
                width: 16px;
                text-align: center;
            }

            .input-shell input {
                border: none;
                outline: none;
                background: transparent;
                flex: 1;
                min-width: 0;
                font-family: "Inter",sans-serif;
                font-size: 0.94rem;
                font-weight: 500;
                color: var(--ink);
                height: 100%;
            }

                .input-shell input::placeholder {
                    color: #B7B4AC;
                    font-weight: 400;
                }

        .toggle-eye {
            border: none;
            background: transparent;
            color: var(--muted);
            cursor: pointer;
            font-size: 0.9rem;
            padding: 4px;
        }

        .field-msg {
            font-size: 0.76rem;
            color: var(--error);
            margin-top: 6px;
            display: none;
            align-items: center;
            gap: 6px;
        }

            .field-msg.show {
                display: flex;
            }

            .field-msg i {
                font-size: 0.75rem;
            }

        .row-between {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin: 2px 0 22px;
        }

        .remember {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.83rem;
            color: var(--muted);
            font-weight: 500;
            cursor: pointer;
        }

            .remember input {
                width: 16px;
                height: 16px;
                accent-color: var(--terracotta);
                cursor: pointer;
            }

        .forgot {
            font-size: 0.83rem;
            font-weight: 700;
            color: var(--terracotta);
        }

            .forgot:hover {
                color: var(--terracotta-2);
            }

        .cta-btn {
            width: 100%;
            border: none;
            border-radius: 13px;
            padding: 15px;
            background: linear-gradient(135deg,var(--terracotta),var(--terracotta-2));
            color: #fff;
            font-family: "Space Grotesk",sans-serif;
            font-weight: 700;
            font-size: 0.98rem;
            letter-spacing: 0.01em;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            box-shadow: 0 12px 26px rgba(214,73,31,0.30);
            transition: transform .15s ease, box-shadow .15s ease, opacity .15s ease;
        }

            .cta-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 16px 32px rgba(214,73,31,0.36);
            }

            .cta-btn:active {
                transform: translateY(0);
            }

            .cta-btn:disabled {
                opacity: 0.7;
                cursor: not-allowed;
                transform: none;
            }

            .cta-btn .fa-spinner {
                animation: spin .7s linear infinite;
            }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .cta-btn-ghost {
            width: 100%;
            border: 1.5px solid var(--line);
            border-radius: 13px;
            padding: 13px;
            background: #fff;
            color: var(--navy);
            font-family: "Inter",sans-serif;
            font-weight: 700;
            font-size: 0.88rem;
            cursor: pointer;
            margin-top: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: border-color .15s ease, background .15s ease;
        }

            .cta-btn-ghost:hover {
                border-color: var(--navy);
                background: #F8F9FC;
            }

            .cta-btn-ghost:disabled {
                opacity: 0.55;
                cursor: not-allowed;
            }

        .divider {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 26px 0;
            color: var(--muted);
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }

            .divider::before, .divider::after {
                content: "";
                flex: 1;
                height: 1px;
                background: var(--line);
            }

        .helpline {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: #F6F6F3;
            border: 1px solid var(--line);
            border-radius: 13px;
            padding: 12px 14px;
            font-size: 0.83rem;
            color: var(--ink);
            font-weight: 600;
        }

            .helpline i {
                color: var(--ev-green);
            }

            .helpline a {
                color: var(--navy);
                font-weight: 700;
            }

        .signup-line {
            text-align: center;
            margin-top: 24px;
            font-size: 0.86rem;
            color: var(--muted);
        }

            .signup-line a {
                color: var(--navy);
                font-weight: 700;
            }

                .signup-line a:hover {
                    color: var(--terracotta);
                }

        .otp-note {
            background: #EAF6EF;
            color: #155C3F;
            font-size: 0.78rem;
            font-weight: 600;
            border-radius: 10px;
            padding: 9px 12px;
            margin: -6px 0 18px;
            align-items: center;
            gap: 8px;
            display: none;
        }

            .otp-note.show {
                display: flex;
            }

        .otp-timer {
            text-align: center;
            font-size: 0.8rem;
            color: var(--muted);
            margin-top: -8px;
            margin-bottom: 18px;
        }

            .otp-timer button {
                border: none;
                background: none;
                color: var(--terracotta);
                font-weight: 700;
                cursor: pointer;
                font-size: 0.8rem;
                padding: 0;
            }

                .otp-timer button:disabled {
                    color: var(--muted);
                    cursor: not-allowed;
                }

        .password-field, #mobileField, #otpField {
            display: block;
        }

        #otpField, .otp-timer, .otp-note {
            display: none;
        }

            #otpField.show, .otp-timer.show {
                display: block;
            }

        /* section reveal states driven by data-step attribute on the form */
        form[data-step="enter-mobile"] #otpField,
        form[data-step="enter-mobile"] .otp-timer {
            display: none;
        }

        /* ---------------- TOAST NOTIFICATIONS ---------------- */
        .toast-stack {
            position: fixed;
            top: 18px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 10px;
            width: calc(100% - 32px);
            max-width: 400px;
        }

        .toast {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            background: #fff;
            border-radius: 13px;
            padding: 13px 14px;
            box-shadow: 0 14px 34px rgba(11,21,51,0.18);
            border-left: 4px solid var(--navy);
            font-size: 0.86rem;
            font-weight: 600;
            color: var(--ink);
            opacity: 0;
            transform: translateY(-14px);
            animation: toastIn .28s ease forwards;
        }

            .toast.success {
                border-left-color: var(--ev-green);
            }

            .toast.error {
                border-left-color: var(--error);
            }

            .toast.info {
                border-left-color: var(--navy);
            }

            .toast i.toast-icon {
                margin-top: 1px;
                font-size: 0.95rem;
            }

            .toast.success i.toast-icon {
                color: var(--ev-green);
            }

            .toast.error i.toast-icon {
                color: var(--error);
            }

            .toast.info i.toast-icon {
                color: var(--navy);
            }

            .toast .toast-msg {
                flex: 1;
                line-height: 1.4;
            }

            .toast .toast-close {
                border: none;
                background: none;
                color: var(--muted);
                cursor: pointer;
                font-size: 0.8rem;
                padding: 2px;
            }

            .toast.leaving {
                animation: toastOut .22s ease forwards;
            }

        @@keyframes toastIn {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes toastOut {
            to {
                opacity: 0;
                transform: translateY(-10px);
            }
        }

        @@media (min-width:992px) {
            .visual-pane {
                display: block;
            }

            .form-pane {
                flex: 0 0 48%;
                padding: 48px;
            }

            .top-brand {
                display: none;
            }
        }

        @@media (max-width:480px) {
            .form-pane {
                padding: 26px 16px 36px;
            }

            .visual-quote h2 {
                font-size: 1.8rem;
            }
        }
    </style>
</head>
<body>

    <div class="toast-stack" id="toastStack"></div>

    <div class="layout">

        <!-- ===================== LEFT VISUAL PANE (desktop only) ===================== -->
        <div class="visual-pane">
            <svg class="route-svg" viewBox="0 0 600 800" preserveAspectRatio="none">
                <path class="route-path" d="M 70 660 C 180 600, 160 460, 300 420 S 480 260, 520 120" />
                <circle class="route-pulse" cx="70" cy="660" r="6"></circle>
                <circle class="route-pulse" cx="520" cy="120" r="6"></circle>
            </svg>

            <div class="visual-content">
                <div class="visual-brand">
                    <div class="mark">SJ</div>
                    <div class="word">
                        Sardar Ji EV
                        <small>Driver Partner Network</small>
                    </div>
                </div>

                <div class="visual-quote">
                    <div class="eyebrow"><i class="fa-solid fa-bolt"></i> Built for the road ahead</div>
                    <h2>Every ride you take plugs India into cleaner streets.</h2>
                    <p>Sign in to accept trips, track your earnings and manage your EV rides &mdash; airport, outstation, rental or local, all in one place.</p>
                </div>

                <div class="visual-stats">
                    <div class="stat"><div class="num">12k+</div><div class="lbl">Active drivers</div></div>
                    <div class="stat"><div class="num">2.02kg</div><div class="lbl">CO&#8322; saved / driver avg.</div></div>
                    <div class="stat"><div class="num">24/7</div><div class="lbl">Partner support</div></div>
                </div>
            </div>
        </div>

        <!-- ===================== RIGHT FORM PANE ===================== -->
        <div class="form-pane">
            <div class="form-wrap">

                <div class="top-brand">
                    <div class="mark">SJ</div>
                    <div class="word">Sardar Ji EV<span>Driver Partner Network</span></div>
                </div>

                <div class="eyebrow-tag"><i class="fa-solid fa-bolt"></i> Driver Sign In</div>
                <h1>Welcome back, partner</h1>
                <p class="sub">Enter your registered mobile number to start your shift.</p>

                <div class="mode-switch" role="tablist">
                    <button type="button" class="mode-btn active" id="passwordModeBtn" onclick="setMode('password')">Password</button>
                    <button type="button" class="mode-btn" id="otpModeBtn" onclick="setMode('otp')">OTP</button>
                </div>

                <form id="loginForm" data-step="enter-mobile" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="field" id="mobileField">
                        <label for="mobile">Mobile number</label>
                        <div class="input-shell" id="mobileShell">
                            <span class="prefix"><i class="fa-solid fa-flag"></i> +91</span>
                            <input id="mobile" name="mobile" type="tel" inputmode="numeric" maxlength="10"
                                   placeholder="98765 43210" autocomplete="tel" required>
                        </div>
                        <div class="field-msg" id="mobileMsg"><i class="fa-solid fa-circle-exclamation"></i> <span>Enter a valid 10-digit mobile number.</span></div>
                    </div>

                    <div class="field password-field" id="passwordField">
                        <label for="password">Password</label>
                        <div class="input-shell" id="passwordShell">
                            <i class="fa-solid fa-lock"></i>
                            <input id="password" name="password" type="password"
                                   placeholder="Enter your password" autocomplete="current-password">
                            <button type="button" class="toggle-eye" onclick="togglePassword()" aria-label="Show password">
                                <i class="fa-solid fa-eye" id="eyeIcon"></i>
                            </button>
                        </div>
                        <div class="field-msg" id="passwordMsg"><i class="fa-solid fa-circle-exclamation"></i> <span>Enter your password.</span></div>
                    </div>

                    <div class="otp-note" id="otpNote">
                        <i class="fa-solid fa-circle-check"></i> We'll text a 6-digit code to this number.
                    </div>

                    <div class="field" id="otpField">
                        <label for="otp">6-digit code</label>
                        <div class="input-shell" id="otpShell">
                            <i class="fa-solid fa-shield-halved"></i>
                            <input id="otp" name="otp" type="text" inputmode="numeric" maxlength="6"
                                   placeholder="••••••" autocomplete="one-time-code">
                        </div>
                        <div class="field-msg" id="otpMsg"><i class="fa-solid fa-circle-exclamation"></i> <span>Enter the 6-digit code we sent you.</span></div>
                    </div>

                    <div class="otp-timer" id="otpTimer">
                        Didn't get it? <button type="button" id="resendBtn" onclick="resendOtp()" disabled>Resend in <span id="resendCount">30</span>s</button>
                    </div>

                    <div class="row-between" id="rememberRow">
                        <label class="remember"><input type="checkbox" id="remember"> Keep me signed in</label>
                        <a href="#" class="forgot" id="forgotLink">Forgot password?</a>
                    </div>

                    <button type="submit" class="cta-btn" id="ctaBtn">
                        <span id="ctaLabel">Sign in to drive</span> <i class="fa-solid fa-arrow-right" id="ctaIcon"></i>
                    </button>

                    <button type="button" class="cta-btn-ghost" id="changeNumberBtn" onclick="backToMobile()" style="display:none;">
                        <i class="fa-solid fa-arrow-left"></i> Use a different number
                    </button>
                </form>

                <div class="divider">or</div>

                <div class="helpline">
                    <i class="fa-solid fa-headset"></i> Need help? Call <a href="tel:+911800123456">1800-123-456</a>
                </div>

                <div class="signup-line">
                    New to Sardar Ji EV? <a href="#">Apply to become a driver partner</a>
                </div>

            </div>
        </div>

    </div>

    <script>
        // ---------- config: endpoint routes on DriverLogInController ----------
        const ENDPOINTS = {
          login:     '@Url.Action("Login", "DriverLogIn")',
          sendOtp:   '@Url.Action("SendOtp", "DriverLogIn")',
          verifyOtp: '@Url.Action("VerifyOtp", "DriverLogIn")'
        };

        let mode = 'password';       // 'password' | 'otp'
        let otpStep = 'enter-mobile'; // 'enter-mobile' | 'enter-otp'
        let resendTimerHandle = null;

        // ---------------- Toast helper ----------------
        function showToast(message, type = 'info', duration = 4500) {
          const stack = document.getElementById('toastStack');
          const icons = { success: 'fa-circle-check', error: 'fa-circle-exclamation', info: 'fa-circle-info' };

          const toast = document.createElement('div');
          toast.className = `toast ${type}`;
          toast.innerHTML = `
            <i class="fa-solid ${icons[type] || icons.info} toast-icon"></i>
            <div class="toast-msg">${message}</div>
            <button class="toast-close" aria-label="Dismiss"><i class="fa-solid fa-xmark"></i></button>
          `;
          toast.querySelector('.toast-close').addEventListener('click', () => dismissToast(toast));
          stack.appendChild(toast);

          const timeoutId = setTimeout(() => dismissToast(toast), duration);
          toast.dataset.timeoutId = timeoutId;
        }

        function dismissToast(toast) {
          if (!toast || !toast.parentNode) return;
          clearTimeout(toast.dataset.timeoutId);
          toast.classList.add('leaving');
          setTimeout(() => toast.remove(), 220);
        }

        // ---------------- Field error helpers ----------------
        function setFieldError(shellId, msgId, message) {
          const shell = document.getElementById(shellId);
          const msgEl = document.getElementById(msgId);
          shell.classList.add('error');
          if (message) msgEl.querySelector('span').textContent = message;
          msgEl.classList.add('show');
        }
        function clearFieldError(shellId, msgId) {
          document.getElementById(shellId).classList.remove('error');
          document.getElementById(msgId).classList.remove('show');
        }

        // ---------------- Mode switch (Password vs OTP) ----------------
        function setMode(next) {
          mode = next;
          otpStep = 'enter-mobile';

          document.getElementById('passwordModeBtn').classList.toggle('active', next === 'password');
          document.getElementById('otpModeBtn').classList.toggle('active', next === 'otp');

          document.getElementById('passwordField').style.display = next === 'password' ? 'block' : 'none';
          document.getElementById('otpNote').classList.toggle('show', next === 'otp');
          document.getElementById('rememberRow').style.display = next === 'password' ? 'flex' : 'none';

          document.getElementById('otpField').classList.remove('show');
          document.getElementById('otpTimer').classList.remove('show');
          document.getElementById('changeNumberBtn').style.display = 'none';
          document.getElementById('mobile').disabled = false;
          document.getElementById('mobileShell').classList.remove('locked');
          clearFieldError('otpShell', 'otpMsg');
          stopResendTimer();

          document.getElementById('ctaLabel').textContent = next === 'password' ? 'Sign in to drive' : 'Send OTP';
          document.getElementById('password').required = (next === 'password');
          document.getElementById('loginForm').dataset.step = 'enter-mobile';
        }

        function togglePassword() {
          const input = document.getElementById('password');
          const icon = document.getElementById('eyeIcon');
          const show = input.type === 'password';
          input.type = show ? 'text' : 'password';
          icon.classList.toggle('fa-eye', !show);
          icon.classList.toggle('fa-eye-slash', show);
        }

        function setButtonLoading(loading, label) {
          const btn = document.getElementById('ctaBtn');
          const lbl = document.getElementById('ctaLabel');
          const icon = document.getElementById('ctaIcon');
          btn.disabled = loading;
          if (loading) {
            lbl.textContent = label;
            icon.className = 'fa-solid fa-spinner';
          } else {
            icon.className = 'fa-solid fa-arrow-right';
          }
        }

        // ---------------- Resend timer ----------------
        function startResendTimer(seconds = 30) {
          const btn = document.getElementById('resendBtn');
          const count = document.getElementById('resendCount');
          let remaining = seconds;
          btn.disabled = true;
          count.textContent = remaining;
          stopResendTimer();
          resendTimerHandle = setInterval(() => {
            remaining -= 1;
            count.textContent = remaining;
            if (remaining <= 0) {
              stopResendTimer();
              btn.disabled = false;
              btn.textContent = 'Resend code';
            }
          }, 1000);
        }
        function stopResendTimer() {
          if (resendTimerHandle) clearInterval(resendTimerHandle);
        }

        async function resendOtp() {
          const mobile = document.getElementById('mobile').value.trim();
          await requestOtp(mobile, true);
        }

        function backToMobile() {
          otpStep = 'enter-mobile';
          document.getElementById('loginForm').dataset.step = 'enter-mobile';
          document.getElementById('mobile').disabled = false;
          document.getElementById('mobileShell').classList.remove('locked');
          document.getElementById('otpField').classList.remove('show');
          document.getElementById('otpTimer').classList.remove('show');
          document.getElementById('changeNumberBtn').style.display = 'none';
          document.getElementById('otp').value = '';
          clearFieldError('otpShell', 'otpMsg');
          stopResendTimer();
          document.getElementById('ctaLabel').textContent = 'Send OTP';
        }

        // ---------------- API calls ----------------
        async function postJson(url, data) {
          const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
          const res = await fetch(url, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded',
              'RequestVerificationToken': token
            },
            body: new URLSearchParams({ ...data, __RequestVerificationToken: token })
          });
          let payload;
          try { payload = await res.json(); }
          catch { payload = { success: false, message: 'Unexpected server response. Please try again.' }; }
          return { ok: res.ok, payload };
        }

        async function requestOtp(mobile, isResend = false) {
          setButtonLoading(true, isResend ? 'Resending…' : 'Sending code…');
          try {
            const { payload } = await postJson(ENDPOINTS.sendOtp, { mobile });
            if (payload.success) {
              showToast(isResend ? 'A new code is on its way.' : 'OTP sent to your mobile number.', 'success');
              otpStep = 'enter-otp';
              document.getElementById('loginForm').dataset.step = 'enter-otp';
              document.getElementById('mobile').disabled = true;
              document.getElementById('mobileShell').classList.add('locked');
              document.getElementById('otpField').classList.add('show');
              document.getElementById('otpTimer').classList.add('show');
              document.getElementById('changeNumberBtn').style.display = 'flex';
              document.getElementById('ctaLabel').textContent = 'Verify & sign in';
              startResendTimer(30);
              clearFieldError('mobileShell', 'mobileMsg');
            } else {
              showToast(payload.message || 'Could not send OTP. Please try again.', 'error');
              setFieldError('mobileShell', 'mobileMsg', payload.message || 'Could not send OTP for this number.');
            }
          } catch (err) {
            showToast('Network error — please check your connection and try again.', 'error');
          } finally {
            setButtonLoading(false);
          }
        }

        async function verifyOtpCode(mobile, otp) {
          setButtonLoading(true, 'Verifying…');
          try {
            const { payload } = await postJson(ENDPOINTS.verifyOtp, { mobile, otp });
            if (payload.success) {
              showToast('Signed in successfully. Redirecting…', 'success');
              setTimeout(() => { window.location.href = payload.redirectUrl || '/'; }, 700);
            } else {
              showToast(payload.message || 'That code didn\'t match. Try again.', 'error');
              setFieldError('otpShell', 'otpMsg', payload.message || 'Incorrect or expired code.');
              setButtonLoading(false);
            }
          } catch (err) {
            showToast('Network error — please check your connection and try again.', 'error');
            setButtonLoading(false);
          }
        }

        async function passwordLogin(mobile, password, remember) {
          setButtonLoading(true, 'Signing in…');
          try {
            const { payload } = await postJson(ENDPOINTS.login, { mobile, password, remember });
            if (payload.success !== false) {
              // Standard MVC post-redirect: if the controller returns JSON success, redirect here;
              // if it returns a RedirectToAction directly, the fetch 'redirected' flag / URL is used instead.
              showToast('Signed in successfully. Redirecting…', 'success');
              setTimeout(() => { window.location.href = payload.redirectUrl || '/'; }, 700);
            } else {
              showToast(payload.message || 'Incorrect mobile number or password.', 'error');
              setFieldError('passwordShell', 'passwordMsg', payload.message || 'Incorrect mobile number or password.');
              setButtonLoading(false);
            }
          } catch (err) {
            showToast('Network error — please check your connection and try again.', 'error');
            setButtonLoading(false);
          }
        }

        // ---------------- Form submit ----------------
        document.getElementById('loginForm').addEventListener('submit', function (e) {
          e.preventDefault();

          const mobile = document.getElementById('mobile').value.trim();
          clearFieldError('mobileShell', 'mobileMsg');

          if (!/^[6-9]\d{9}$/.test(mobile)) {
            setFieldError('mobileShell', 'mobileMsg', 'Enter a valid 10-digit mobile number.');
            showToast('Please enter a valid mobile number.', 'error');
            return;
          }

          if (mode === 'password') {
            const password = document.getElementById('password').value;
            clearFieldError('passwordShell', 'passwordMsg');
            if (!password) {
              setFieldError('passwordShell', 'passwordMsg', 'Enter your password.');
              showToast('Please enter your password.', 'error');
              return;
            }
            const remember = document.getElementById('remember').checked;
            passwordLogin(mobile, password, remember);
          } else {
            if (otpStep === 'enter-mobile') {
              requestOtp(mobile, false);
            } else {
              const otp = document.getElementById('otp').value.trim();
              clearFieldError('otpShell', 'otpMsg');
              if (!/^\d{6}$/.test(otp)) {
                setFieldError('otpShell', 'otpMsg', 'Enter the 6-digit code we sent you.');
                showToast('Please enter the 6-digit code.', 'error');
                return;
              }
              verifyOtpCode(mobile, otp);
            }
          }
        });

        // ---------------- Server-side messages passed via TempData ----------------
        @if (TempData["LoginError"] != null)
        {
                <text>
                document.addEventListener('DOMContentLoaded', function () {
                  showToast(@Html.Raw(Json.Serialize(TempData["LoginError"].ToString())), 'error');
                });
                </text>
        }
        @if (TempData["LoginSuccess"] != null)
        {
                <text>
                document.addEventListener('DOMContentLoaded', function () {
                  showToast(@Html.Raw(Json.Serialize(TempData["LoginSuccess"].ToString())), 'success');
                });
                </text>
        }
    </script>

</body>
</html>
