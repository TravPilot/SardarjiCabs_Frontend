@model SignUpVM

@{
    ViewBag.Title = "Register";
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>

    <meta charset="utf-8" />
    <title>Register - SardarJi_Cab_Booking</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --road: #1B1B1F;
            --mustard: #F2A93C;
            --mustard-dark: #D6891C;
            --marigold: #E5572B;
            --marigold-dk: #C0431E;
            --teal: #0E6B5F;
            --teal-dark: #0A4F46;
            --teal-pale: #E4F1EE;
            --cream: #FBF3E1;
            --ink: #241C14;
            --ink-soft: #7A6E5C;
            --line: #E6D9BC;
            --radius: 12px;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
            color: var(--ink);
            background: var(--cream);
        }

        .rg-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1.1rem 3rem;
            background: #FFFFFF;
            border-bottom: 1px solid var(--line);
        }

            .rg-header .navbar-brand img {
                height: 46px;
                display: block;
            }

            .rg-header nav {
                display: flex;
                gap: 2rem;
            }

                .rg-header nav a {
                    color: var(--ink-soft);
                    text-decoration: none;
                    font-size: 0.95rem;
                    font-weight: 600;
                    padding-bottom: 4px;
                    border-bottom: 2px solid transparent;
                    transition: color 0.15s ease, border-color 0.15s ease;
                }

                    .rg-header nav a:hover {
                        color: var(--ink);
                    }

                    .rg-header nav a.active {
                        color: var(--teal-dark);
                        border-color: var(--marigold);
                    }

        .hero {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
            align-items: center;
            max-width: 1280px;
            margin: 0 auto;
            padding: 3rem 3rem 4rem;
            direction: ltr;
        }

        .hero-left {
            order: 1;
            grid-column: 1;
        }

        .hero-right {
            order: 2;
            grid-column: 2;
            position: relative;
            border-radius: 20px;
            overflow: hidden;
            aspect-ratio: 4 / 4;
            box-shadow: 0 30px 60px -24px rgba(27,27,31,0.45);
        }

            .hero-right svg {
                display: block;
                width: 100%;
                height: 100%;
            }

        .register-card {
            background: #FFFFFF;
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 2.5rem 2.5rem 2.25rem;
            box-shadow: 0 20px 45px -26px rgba(27,27,31,0.4);
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.82rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--teal-dark);
            margin-bottom: 0.7rem;
        }

            .eyebrow .dot {
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: var(--marigold);
            }

        h2 {
            font-family: "Baloo 2", sans-serif;
            font-weight: 800;
            font-size: 1.85rem;
            color: var(--ink);
            margin: 0 0 1.6rem;
            text-align: left !important;
        }

        label {
            display: block;
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.07em;
            color: var(--teal-dark);
            margin-bottom: 0.4rem;
        }

        .form-control {
            height: auto;
            padding: 0.75rem 0.9rem;
            font-size: 0.95rem;
            border: 1.5px solid var(--line);
            border-radius: var(--radius);
            background: var(--cream);
            color: var(--ink);
            transition: border-color 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
        }

            .form-control::placeholder {
                color: #A99C84;
            }

            .form-control:hover {
                border-color: var(--mustard-dark);
            }

            .form-control:focus {
                outline: none;
                background: #FFFFFF;
                border-color: var(--teal);
                box-shadow: 0 0 0 3px rgba(14,107,95,0.14);
            }

        .input-group .form-control {
            border-right: none;
        }

        .input-group-text.toggle-password {
            background: var(--cream);
            border: 1.5px solid var(--line);
            border-left: none;
            border-radius: 0 var(--radius) var(--radius) 0;
            color: var(--ink-soft);
        }

        .text-danger {
            font-size: 0.8rem;
            margin-top: 0.3rem;
            display: block;
        }

        .btn-register {
            background: var(--marigold);
            color: #fff;
            border: none;
            height: 52px;
            border-radius: 999px;
            font-family: "Baloo 2", sans-serif;
            font-weight: 700;
            font-size: 1.05rem;
            width: 240px;
            box-shadow: 0 12px 22px -10px rgba(229,87,43,0.6);
            transition: background 0.15s ease, transform 0.05s ease;
        }

            .btn-register:hover {
                color: #fff;
                background: var(--marigold-dk);
                opacity: 1;
            }

            .btn-register:active {
                transform: translateY(1px);
            }

            .btn-register:disabled {
                opacity: 0.7;
            }

        .login-hint {
            font-size: 0.92rem;
            color: var(--ink-soft);
        }

            .login-hint a {
                color: var(--teal-dark);
                font-weight: 700;
                text-decoration: none;
            }

                .login-hint a:hover {
                    text-decoration: underline;
                }

        @@media (max-width: 980px) {
            .hero {
                grid-template-columns: 1fr;
                padding: 2.25rem 1.25rem 3rem;
            }

            .rg-header {
                padding: 1rem 1.25rem;
                flex-wrap: wrap;
                gap: 0.75rem;
            }

            .hero-right {
                aspect-ratio: 16/10;
            }

            .register-card {
                padding: 2rem 1.5rem;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .form-control, .btn-register {
                transition: none;
            }
        }
    </style>

</head>

<body>

 @*    <nav class="rg-header">
        <a class="navbar-brand" href="@Url.Action("Index","Home")">
            <img src="~/Images/LogoSardar.png" alt="SardarJi Cabs" />
        </a>
        <nav>
            <a href="@Url.Action("Index","Home")">Home</a>
            <a href="@Url.Action("Index","Registration")" class="active">Register</a>
            <a href="@Url.Action("Index","LogIn")">Login</a>
        </nav>
    </nav> *@

    <div class="hero">
        <div class="hero-left">
            <div class="register-card">
                <div class="eyebrow"><span class="dot"></span> New Rider</div>
                <h2>Create your account</h2>

                @using (Html.BeginForm("UserSignup", "Registration", FormMethod.Post, new { id = "registerForm" }))
                {
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label>First Name</label>
                            @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", placeholder = "First Name", required = "required" })
                            @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6 mb-3">
                            <label>Last Name</label>
                            @Html.TextBoxFor(m => m.LastName, new { @class = "form-control", placeholder = "Last Name", required = "required" })
                            @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6 mb-3">
                            <label>Email</label>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "Email", required = "required" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6 mb-3">
                            <label>Mobile No.</label>
                            @Html.TextBoxFor(m => m.MobileNo, new { @class = "form-control", placeholder = "Mobile Number", required = "required", maxlength = "10", pattern = "[0-9]{10}" })
                            @Html.ValidationMessageFor(m => m.MobileNo, "", new { @class = "text-danger" })
                        </div>

                        <div class="col-md-6 mb-3">
                            <label>Password</label>
                            <div class="input-group">
                                @Html.PasswordFor(m => m.Password, new
                                    {
                                        @class = "form-control",
                                        id = "Password",
                                        placeholder = "Password",
                                        required = "required"
                                    })

                                <span class="input-group-text toggle-password"
                                      data-target="Password"
                                      style="cursor:pointer;">
                                    <i class="fa fa-eye"></i>
                                </span>
                            </div>

                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                        </div>

                        <div class="col-md-6 mb-3">
                            <label>Confirm Password</label>
                            <div class="input-group">
                                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", id = "ConfirmPassword", placeholder = "Confirm Password", required = "required" })
                                <span class="input-group-text toggle-password" data-target="ConfirmPassword" style="cursor:pointer;">
                                    <i class="fa fa-eye"></i>
                                </span>
                            </div>
                            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="text-left mt-3">
                        <button type="submit" class="btn btn-register" id="btnRegister">
                            Register
                        </button>
                    </div>
                    <div class="mt-3 login-hint">
                        Already have an account?
                        <a href="@Url.Action("Index", "LogIn")">Login</a>
                    </div>
                }
            </div>
        </div>

        <div class="hero-right">
            <svg viewBox="0 0 700 875" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
                <defs>
                    <linearGradient id="sky4" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#0A4F46" />
