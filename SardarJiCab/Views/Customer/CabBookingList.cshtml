@model TravelSummaryViewModel
@{
    ViewData["Title"] = "My Bookings";
}

<style>
    :root {
        --ink: #1B2130;
        --muted: #6B7280;
        --line: #E6E8EE;
        --surface: #FFFFFF;
        --canvas: #F5F6FA;
        --primary: #3949AB;
        --confirmed: #2E7D6B;
        --confirmed-bg: #E4F3EF;
        --completed: #3949AB;
        --completed-bg: #EAEBF8;
        --cancelled: #B4443A;
        --cancelled-bg: #FBEAE8;
        --ongoing: #B5842A;
        --ongoing-bg: #FBF3E1;
    }

    .bk-wrap {
        font-family: 'Inter','Segoe UI',system-ui,sans-serif;
        color: var(--ink);
        background: var(--canvas);
        padding: 28px;
        border-radius: 12px;
    }

    .bk-header h1 {
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        margin: 0 0 4px;
    }

    .bk-header p {
        color: var(--muted);
        margin: 0 0 20px;
        font-size: .85rem;
    }

    /* Summary cards */
    .bk-cards {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 14px;
        margin-bottom: 22px;
    }

    .bk-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 16px 18px;
    }

        .bk-card .label {
            font-size: .72rem;
            text-transform: uppercase;
            letter-spacing: .05em;
            color: var(--muted);
            font-weight: 600;
        }

        .bk-card .value {
            font-size: 1.4rem;
            font-weight: 700;
            margin-top: 4px;
        }

    .bk-table-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 12px;
        overflow: hidden;
    }

    table.bk-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .86rem;
    }

        table.bk-table thead th {
            text-align: left;
            background: #FAFAFC;
            color: var(--muted);
            font-weight: 600;
            font-size: .72rem;
            text-transform: uppercase;
            letter-spacing: .05em;
            padding: 12px 16px;
            border-bottom: 1px solid var(--line);
            white-space: nowrap;
        }

        table.bk-table tbody td {
            padding: 14px 16px;
            border-bottom: 1px solid var(--line);
            vertical-align: middle;
        }

        table.bk-table tbody tr:last-child td {
            border-bottom: none;
        }

        table.bk-table tbody tr:hover {
            background: #FBFBFD;
        }

    .bk-code {
        font-weight: 700;
    }

    .bk-sub {
        color: var(--muted);
        font-size: .78rem;
    }

    .bk-route {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: .8rem;
        max-width: 260px;
    }

        .bk-route .dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            flex: 0 0 auto;
        }

            .bk-route .dot.a {
                background: var(--confirmed);
            }

            .bk-route .dot.b {
                background: var(--cancelled);
            }

        .bk-route .seg {
            flex: 1 1 auto;
            height: 1px;
            background: repeating-linear-gradient(90deg, var(--line) 0 4px, transparent 4px 8px);
        }

        .bk-route .place {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            max-width: 95px;
        }

    .badge-status {
        display: inline-block;
        padding: 4px 11px;
        border-radius: 20px;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .02em;
    }

    .badge-confirmed {
        background: var(--confirmed-bg);
        color: var(--confirmed);
    }

    .badge-completed {
        background: var(--completed-bg);
        color: var(--completed);
    }

    .badge-cancelled {
        background: var(--cancelled-bg);
        color: var(--cancelled);
    }

    .badge-ongoing {
        background: var(--ongoing-bg);
        color: var(--ongoing);
    }

    .bk-fare {
        font-weight: 700;
    }

    .bk-actions a {
        text-decoration: none;
        font-size: .78rem;
        font-weight: 600;
        color: var(--primary);
    }

    .bk-empty {
        text-align: center;
        padding: 60px 20px;
        color: var(--muted);
    }

        .bk-empty .glyph {
            font-size: 2rem;
            margin-bottom: 8px;
        }
</style>

<div class="bk-wrap">
    <div class="bk-header">
        <h1>My Bookings</h1>
        <p>@Model.TotalTrips trip@(Model.TotalTrips == 1 ? "" : "s") on record for user #@Model.UserId</p>
    </div>

    <div class="bk-cards">
        <div class="bk-card">
            <div class="label">Total trips</div>
            <div class="value">@Model.TotalTrips</div>
        </div>
        <div class="bk-card">
            <div class="label">Total spent</div>
            <div class="value">@Model.TotalSpent.ToString("C2")</div>
        </div>
        <div class="bk-card">
            <div class="label">Distance covered</div>
            <div class="value">@Model.TotalDistanceKm.ToString("0.0") km</div>
        </div>
        <div class="bk-card">
            <div class="label">Last trip</div>
            <div class="value">@(Model.LastTripDate?.ToString("dd MMM yyyy") ?? "—")</div>
        </div>
    </div>

    <div class="bk-table-card">
        @if (Model.Bookings == null || Model.Bookings.Count == 0)
        {
            <div class="bk-empty">
                <div class="glyph">🚕</div>
                <div><strong>No bookings yet.</strong></div>
                <div>Once a ride is booked, it'll show up here.</div>
            </div>
        }
        else
        {
            <table class="bk-table">
                <thead>
                    <tr>
                        <th>Booking</th>
                        <th>Route</th>
                        <th>Journey date</th>
                        <th>Vehicle</th>
                        <th>Fare</th>
                        <th>Status</th>
                        <th>Invoice</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.Bookings)
                    {
                        <tr>
                            <td>
                                <div class="bk-code">@b.BookingNo</div>
                                <div class="bk-sub">#@b.NewBookingId</div>
                            </td>
                            <td>
                                <div class="bk-route" title="@b.PickupAddress → @b.DropAddress">
                                    <span class="dot a"></span>
                                    <span class="place">@b.PickupAddress</span>
                                    <span class="seg"></span>
                                    <span class="dot b"></span>
                                    <span class="place">@b.DropAddress</span>
                                </div>
                                @if (b.TotalDistanceKm.HasValue)
                                {
                                    <div class="bk-sub">@b.TotalDistanceKm.Value.ToString("0.0") km</div>
                                }
                            </td>
                            <td>
                                <div>@b.JourneyDate.ToString("dd MMM yyyy")</div>
                                <div class="bk-sub">@b.JourneyDate.ToString("hh:mm tt")</div>
                            </td>
                            <td>
                                <div>@b.VehicleName</div>
                                <div class="bk-sub">@b.VehicleModelYear &middot; @b.VehicleColor</div>
                            </td>
                            <td>
                                <div class="bk-fare">@b.NetPayable.ToString("C2")</div>
                                <div class="bk-sub">@b.PaymentMethod</div>
                            </td>
                            <td>
                                <span class="badge-status @b.StatusBadgeClass">@b.Status</span>
                            </td>
                            <td class="bk-actions">
                                <a href="@Url.Action("DownloadInvoice", "Booking", new { id = b.NewBookingId })">Download</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
