@model CustomerProfile
@{
    ViewData["Title"] = "My Profile";
}

<style>



    @@media (min-width: 980px) {
        nav.navbar.navbar-expand-sm.navbar-toggleable-sm.navbar-light.bg-white.border-bottom.box-shadow.mb-3 {
            margin: 0 !important;
            padding: 0;
        }
    }

    :root {
    --road:         #1B1B1F;
    --mustard:      #F2A93C;
    --mustard-dark: #D6891C;
    --marigold:     #E5572B;
    --marigold-dk:  #C0431E;
    --teal:         #0E6B5F;
    --teal-dark:    #0A4F46;
    --teal-pale:    #E4F1EE;
    --cream:        #FBF3E1;
    --ink:          #241C14;
    --ink-soft:     #7A6E5C;
    --line:         #E6D9BC;
    --danger:       #B3261E;
    --success:      #1E7A46;
    --radius:       12px;
    --radius-sm:    8px;
    }

    * { box-sizing: border-box; }

   

    .profile-page {
    min-height: 100vh;
    background: var(--cream);
    color: var(--ink);
    padding: 2.5rem 1.5rem 4rem;
    }

    .profile-shell {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 2rem;
    align-items: start;
    }

    /* ---------- Sidebar ---------- */

    .profile-sidebar {
    background: #FFFFFF;
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 2.25rem 1.75rem;
    text-align: center;
    box-shadow: 0 18px 40px -28px rgba(27,27,31,0.35);
    position: sticky;
    top: 2rem;
    }

    .avatar-wrap {
    position: relative;
    width: 128px;
    height: 128px;
    margin: 0 auto 1rem;
    }

    .avatar-ring {
    position: absolute;
    inset: 0;
    transform: rotate(-90deg);
    }

    .avatar-ring .track {
    fill: none;
    stroke: var(--line);
    stroke-width: 6;
    }

    .avatar-ring .fill {
    fill: none;
    stroke: var(--marigold);
    stroke-width: 6;
    stroke-linecap: round;
    stroke-dasharray: 345;
    stroke-dashoffset: 345;
    transition: stroke-dashoffset 0.4s ease;
    }

    .avatar-img {
    position: absolute;
    inset: 10px;
    border-radius: 50%;
    background: var(--teal-pale);
    color: var(--teal-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.1rem;
    overflow: hidden;
    }

    .avatar-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    }

    .avatar-upload {
    position: absolute;
    right: 2px;
    bottom: 2px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--marigold);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    cursor: pointer;
    border: 3px solid #FFFFFF;
    box-shadow: 0 4px 10px -3px rgba(229,87,43,0.6);
    transition: background 0.15s ease;
    }

    .avatar-upload:hover { background: var(--marigold-dk); }
    .avatar-upload input { display: none; }

    .completeness-tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--teal-dark);
    background: var(--teal-pale);
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
    margin-bottom: 0.75rem;
    }

    .profile-name {
     
    font-weight: 600;
    font-size: 1.35rem;
    margin: 0 0 0.6rem;
    color: var(--ink);
    }

    .profile-contact {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-content: center;
    font-size: 0.86rem;
    color: var(--ink-soft);
    margin-bottom: 0.35rem;
    word-break: break-word;
    }

    .profile-contact i { color: var(--mustard-dark); width: 14px; }

    .sidebar-nav {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    text-align: left;
    border-top: 1px dashed var(--line);
    padding-top: 1rem;
    }

    .sidebar-nav li + li { margin-top: 0.25rem; }

    .sidebar-nav a {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.65rem 0.75rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--ink-soft);
    font-size: 0.92rem;
    font-weight: 600;
    transition: background 0.15s ease, color 0.15s ease;
    }

    .sidebar-nav a i:first-child { width: 18px; color: var(--teal); }

    .sidebar-nav a:hover { background: var(--teal-pale); color: var(--teal-dark); }

    .sidebar-nav a.active {
    background: var(--teal);
    color: #FFFFFF;
    }

    .sidebar-nav a.active i:first-child { color: #FFFFFF; }

    .sidebar-nav a.danger { color: var(--danger); }

    .sidebar-nav a.danger i:first-child { color: var(--danger); }

    .sidebar-nav a.danger:hover { background: rgba(179,38,30,0.08); }

    .sidebar-nav a .chev {
    margin-left: auto;
    opacity: 0.6;
    font-style: normal;
    }

    /* ---------- Main form ---------- */

    .profile-main {
    background: #FFFFFF;
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 2.5rem 2.5rem 2rem;
    box-shadow: 0 18px 40px -28px rgba(27,27,31,0.35);
    }

    .main-header {
    margin-bottom: 1.75rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px dashed var(--line);
    }

    .main-header h1 {
     
    font-weight: 600;
    font-size: 1.9rem;
    margin: 0 0 0.35rem;
    color: var(--ink);
    }

    .main-header p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
    }

    .form-section {
    margin-bottom: 2rem;
    }

    .section-label {
    display: flex;
    align-items: center;
    gap: 0.55rem;
     
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--teal-dark);
    margin-bottom: 1.1rem;
    }

    .section-label i { color: var(--marigold); }

    .field-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem 1.25rem;
    margin-bottom: 1.1rem;
    }

    .field-grid.title-name { grid-template-columns: 110px 1fr 1fr; }
    .field-grid.thirds { grid-template-columns: 1fr 1fr 1fr; }

    .field {
    position: relative;
    text-align: left;
    }

    .field label {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--teal-dark);
    margin-bottom: 0.4rem;
    }

    .field label .req { color: var(--marigold); margin-left: 2px; }

    .field.locked .lock-icon {
    position: absolute;
    right: 0.9rem;
    top: 2.35rem;
    color: var(--ink-soft);
    font-size: 0.85rem;
    }

    .field .hint {
    margin-top: 0.35rem;
    font-size: 0.78rem;
    color: var(--ink-soft);
    }

    .track-field {
    width: 100%;
    padding: 0.75rem 0.9rem;
    font-size: 0.95rem;
    font-family: inherit;
    color: var(--ink);
    background: var(--cream);
    border: 1.5px solid var(--line);
    border-radius: var(--radius-sm);
    transition: border-color 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
    }

    select.track-field { background-image: none; cursor: pointer; }

    .track-field::placeholder { color: #A99C84; }

    .track-field:hover:not(:disabled) { border-color: var(--mustard-dark); }

    .track-field:focus {
    outline: none;
    background: #FFFFFF;
    border-color: var(--teal);
    box-shadow: 0 0 0 3px rgba(14,107,95,0.14);
    }

    .track-field:disabled {
    background: #F1ECDD;
    color: var(--ink-soft);
    cursor: not-allowed;
    }

    .main-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--line);
    }

    .save-hint {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--ink-soft);
    }

    .save-hint i { color: var(--teal); }

    .btn-update {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background: var(--marigold);
    color: #FFFFFF;
    border: none;
    border-radius: var(--radius);
    padding: 0.85rem 1.6rem;
     
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    box-shadow: 0 12px 22px -10px rgba(229,87,43,0.6);
    transition: background 0.15s ease, transform 0.05s ease;
    }

    .btn-update:hover { background: var(--marigold-dk); }
    .btn-update:active { transform: translateY(1px); }
    .btn-update:disabled { opacity: 0.7; cursor: default; }

    /* ---------- Floating WhatsApp button ---------- */

    .wa-float {
    position: fixed;
    right: 1.75rem;
    bottom: 1.75rem;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #25D366;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    box-shadow: 0 14px 28px -10px rgba(37,211,102,0.6);
    transition: transform 0.15s ease;
    z-index: 40;
    }

    .wa-float:hover { transform: scale(1.06); color: #FFFFFF; }

    /* ---------- Toasts ---------- */

    .profile-toast {
    position: fixed;
    top: 1.5rem;
    right: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: #FFFFFF;
    border-radius: var(--radius);
    padding: 0.85rem 1.2rem;
    font-size: 0.9rem;
    font-weight: 600;
    box-shadow: 0 18px 34px -14px rgba(27,27,31,0.4);
    border-left: 4px solid var(--teal);
    color: var(--ink);
    transform: translateY(-12px);
    opacity: 0;
    transition: transform 0.25s ease, opacity 0.25s ease;
    z-index: 60;
    max-width: 340px;
    }

    .profile-toast.show { transform: translateY(0); opacity: 1; }

    .profile-toast.success { border-left-color: var(--success); }
    .profile-toast.success i { color: var(--success); }

    .profile-toast.error { border-left-color: var(--danger); }
    .profile-toast.error i { color: var(--danger); }

    /* ---------- Responsive ---------- */

    @@media (max-width: 940px) {
    .profile-shell { grid-template-columns: 1fr; }
    .profile-sidebar { position: static; }
    .field-grid.title-name,
    .field-grid.thirds { grid-template-columns: 1fr; }
    .field-grid { grid-template-columns: 1fr; }
    .profile-main { padding: 1.75rem 1.5rem; }
    }

    @@media (prefers-reduced-motion: reduce) {
    .track-field, .btn-update, .avatar-upload, .wa-float, .profile-toast, .avatar-ring .fill {
    transition: none;
    }
    }

</style>
<style>
    .back-container {
        margin: 20px 0;
    }

    .bk-back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        background: #0d6efd;
        color: #fff;
        text-decoration: none;
        border-radius: 30px;
        font-size: 15px;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    }

        .bk-back-link:hover {
            background: #0b5ed7;
            color: #fff;
            text-decoration: none;
            transform: translateY(-2px);
            box-shadow: 0 6px 14px rgba(0, 0, 0, 0.2);
        }

        .bk-back-link i {
            font-size: 14px;
        }
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="stylesheet" href="~/css/my-profile.css" asp-append-version="true">

<div class="profile-page">
    <div class="back-container">
        <a asp-action="Index" asp-controller="Home" class="bk-back-link">
            <i class="fa fa-arrow-left"></i> Back to Home
        </a>
    </div>
    <div class="profile-shell">

        <aside class="profile-sidebar">
            <div class="avatar-wrap">
                <svg class="avatar-ring" viewBox="0 0 120 120" width="128" height="128">
                    <circle class="track" cx="60" cy="60" r="55"></circle>
                    <circle id="avatarProgress" class="fill" cx="60" cy="60" r="55"></circle>
                </svg>
                <div class="avatar-img">
                    @if (!string.IsNullOrEmpty(Model?.LogoPath))
                    {
                        <img src="@Model.LogoPath" alt="@Model.FirstName @Model.LastName" />
                    }
                    else
                    {
                        <i class="fa-solid fa-user"></i>
                    }
                </div>
                <label class="avatar-upload" title="Change photo">
                    <i class="fa-solid fa-camera"></i>
                    <input type="file" id="avatarInput" name="ProfileImageFile" accept="image/*" />
                </label>
            </div>

            <span class="completeness-tag" id="completenessTag">Profile 0% complete</span>
            <h2 class="profile-name">@(Model?.FirstName ?? "") @(Model?.LastName ?? "")</h2>
            <div class="profile-contact"><i class="fa-regular fa-envelope"></i>@(Model?.Email ?? "")</div>
            <div class="profile-contact"><i class="fa-solid fa-phone"></i>@(Model?.Mobile ?? "")</div>

            <ul class="sidebar-nav">
                <li><a href="/Customer/Index" class="active"><i class="fa-solid fa-user"></i>My Profile</a></li>
                <li><a href="/CabBookingList"><i class="fa-solid fa-plane-departure"></i>All Bookings<span class="chev">›</span></a></li>
                @* <li><a href="/wallet"><i class="fa-solid fa-wallet"></i>Wallet</a></li> *@
                <li><a href="/ledger"><i class="fa-solid fa-book"></i>Ledger</a></li>
                <li><a href="/Customer/ForgotPassword" class="danger"><i class="fa-solid fa-lock"></i>Change Password</a></li>
            </ul>
        </aside>

        <main class="profile-main">

            <div class="avatar-section">
                <div class="avatar-wrap">
                    <svg class="avatar-ring" viewBox="0 0 120 120">
                        <circle class="avatar-ring-bg" cx="60" cy="60" r="55" />
                        <circle id="avatarProgress" class="avatar-ring-fg" cx="60" cy="60" r="55"
                                stroke-dasharray="345" stroke-dashoffset="345" />
                    </svg>
                    <div class="avatar-img">
                        @if (!string.IsNullOrEmpty(Model?.LogoPath))
                        {
                            <img src="@Model.LogoPath" alt="Profile photo" />
                        }
                        else
                        {
                            <i class="fa-solid fa-user"></i>
                        }
                    </div>
                    <label for="avatarInput" class="avatar-edit"><i class="fa-solid fa-camera"></i></label>
                    <input type="file" id="avatarInput" accept="image/*" hidden />
                </div>
                <div id="completenessTag" class="completeness-tag">Profile 0% complete</div>
            </div>

            <form id="profileForm"
                  asp-action="UpdateProfile" asp-controller="Customer" method="post" enctype="multipart/form-data"
                  data-get-states-url="@Url.Action("GetStates", "Customer")"
                  data-get-cities-url="@Url.Action("GetCities", "Customer")"
                  data-update-url="@Url.Action("UpdateProfile", "Customer")"
                  data-initial-country-id="@Model?.CountryId"
                  data-initial-state-id="@Model?.StateId"
                  data-initial-city-id="@Model?.CityId">

                <div class="main-header">
                    <h1>Profile</h1>
                    <p>Basic info for a faster booking experience.</p>
                </div>

                <div class="form-section">
                    <div class="section-label"><i class="fa-solid fa-id-card"></i>Basic details</div>

                    <div class="field-grid title-name">
                        <div class="field">
                            <label for="Title">Title</label>
                            <select id="Title" asp-for="Title" class="track-field">
                                <option>Mr</option>
                                <option>Mrs</option>
                                <option>Ms</option>
                                <option>Dr</option>
                            </select>
                        </div>
                        <div class="field">
                            <label for="FirstName">First name<span class="req">*</span></label>
                            <input id="FirstName" asp-for="FirstName" class="track-field" placeholder="First name" required />
                        </div>
                        <div class="field">
                            <label for="LastName">Last name<span class="req">*</span></label>
                            <input id="LastName" asp-for="LastName" class="track-field" placeholder="Last name" required />
                        </div>
                    </div>

                    <div class="field-grid">
                        <div class="field locked">
                            <label for="Mobile">Mobile number</label>
                            <input id="Mobile" asp-for="Mobile" class="track-field" disabled />
                            <i class="fa-solid fa-lock lock-icon"></i>
                            <div class="hint">Used for booking confirmations &amp; OTP login</div>
                        </div>
                        <div class="field locked">
                            <label for="Email">Email address</label>
                            <input id="Email" type="email" asp-for="Email" class="track-field" disabled />
                            <i class="fa-solid fa-lock lock-icon"></i>
                            <div class="hint">Contact support to change your email</div>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <div class="section-label"><i class="fa-solid fa-location-dot"></i>Address information</div>

                    <div class="field-grid">
                        <div class="field">
                            <label for="Address">Address</label>
                            <input id="Address" asp-for="Address" class="track-field" placeholder="House no., street, locality" />
                        </div>
                        <div class="field">
                            <label for="PinCode">PIN code</label>
                            <input id="PinCode" asp-for="PinCode" class="track-field" placeholder="e.g. 110001" maxlength="6" Change photo
                                   oninput="this.value = this.value.replace(/[^0-9.]/g, '');
                                   if (this.value < 0) this.value = 0;" />
                        </div>
                    </div>

                </div>

                <div class="main-footer">
                    <span class="save-hint"><i class="fa-solid fa-shield-halved"></i>Your details are only used to speed up bookings.</span>
                    <button type="submit" id="saveBtn" class="btn-update"><i class="fa-solid fa-check"></i>Update profile</button>
                </div>

            </form>
        </main>
    </div>
</div>

<a href="https://wa.me/917408866469" target="_blank" class="wa-float" aria-label="Chat on WhatsApp">
    <i class="fa-brands fa-whatsapp"></i>
</a>
<script>
    var profileCfg = {};

    $(document).ready(function () {

        var $form = $("#profileForm");

        profileCfg = {
            updateUrl: $form.data("update-url")
        };

        if (typeof activeSubMenu === "function") {
            activeSubMenu("/my-profile");
        }

      
        $("#avatarInput").on("change", function (e) {
            var file = e.target.files[0];
            if (!file) return;

            var reader = new FileReader();
            reader.onload = function (ev) {
                $(".avatar-img").html('<img src="' + ev.target.result + '" alt="Profile Photo" />');
                updateCompleteness();
            };
            reader.readAsDataURL(file);
        });

        $(".track-field").on("input change", function () {
            updateCompleteness();
        });

        updateCompleteness();

       
        $("#profileForm").off("submit").on("submit", function (e) {
            e.preventDefault();
            submitProfile();
            return false;
        });

    });
        function submitProfile() {
        var $btn = $("#saveBtn");
        var originalHtml = $btn.html();

        $btn.prop("disabled", true);
        $btn.html('<i class="fa-solid fa-spinner fa-spin"></i> Saving...');

        var formData = new FormData();
        formData.append("Title", $("#Title").val());
        formData.append("FirstName", $("#FirstName").val());
        formData.append("LastName", $("#LastName").val());
        formData.append("Address", $("#Address").val());
        formData.append("PinCode", $("#PinCode").val());

        var fileInput = document.getElementById("avatarInput");
        if (fileInput.files.length > 0) {
            formData.append("ProfileImageFile", fileInput.files[0]);
        }

        $.ajax({
            url: profileCfg.updateUrl,
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,
            dataType: "json",
            cache: false,
            success: function (res) {
                if (res && res.success) {
                    window.location.href = '/Customer/Index';
                } else {
                    alert(res.message);
                }
            },
            error: function (xhr, status, error) {
                console.log(xhr.responseText);
                alert("Something went wrong.");
                $btn.prop("disabled", false);
                $btn.html(originalHtml);
            }
        });
    }
    // function submitProfile() {

    //     var $btn = $("#saveBtn");
    //     var originalHtml = $btn.html();

    //     $btn.prop("disabled", true);
    //     $btn.html('<i class="fa-solid fa-spinner fa-spin"></i> Saving...');

    //     var payload = {
    //         Title: $("#Title").val(),
    //         FirstName: $("#FirstName").val(),
    //         LastName: $("#LastName").val(),
    //         Address: $("#Address").val(),
    //         PinCode: $("#PinCode").val()
    //     };

    //     $.ajax({
    //         url: profileCfg.updateUrl,
    //         type: "POST",
    //         data: payload,
    //         dataType: "json",
    //         cache: false,
    //        success: function (res) {
    //     if (res && res.success) {
    //         window.location.href = '/Customer/Index';
    //     } else {
    //         alert(res.message);
    //     }
    // },

    //         error: function (xhr, status, error) {

    //             console.log(xhr.responseText);

    //             alert("Something went wrong.");

    //             $btn.prop("disabled", false);
    //             $btn.html(originalHtml);
    //         }
    //     });
    // }

    function updateCompleteness() {

        var fields = document.querySelectorAll(".track-field");
        var filled = 0;

        fields.forEach(function (f) {
            if (f.value.trim() !== "") {
                filled++;
            }
        });

        var hasPhoto = document.querySelector(".avatar-img img") != null;

        var total = fields.length + 1;
        var completed = filled + (hasPhoto ? 1 : 0);

        var percent = Math.round((completed / total) * 100);

        var ring = document.getElementById("avatarProgress");
        var tag = document.getElementById("completenessTag");

        if (ring) {
            var circumference = 345;
            ring.style.strokeDashoffset = circumference - (circumference * percent / 100);
        }

        if (tag) {
            tag.innerHTML = "Profile " + percent + "% complete";
        }
    }
</script>

