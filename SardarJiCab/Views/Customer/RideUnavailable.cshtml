@model int
@{
    Layout = null;
    int bookingId = Model;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Ride not available</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,600;0,9..144,700&family=Public+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap');

        :root {
            --ink: #202821;
            --muted: #6E7A70;
            --line: #E4E1D4;
            --surface: #FFFFFF;
            --canvas: #F6F4EC;
            --primary: #1F6F54;
            --primary-ink: #153E2F;
            --primary-bg: #E5F1EA;
            --accent: #E7A537;
            --shadow: 0 6px 16px rgba(32,40,33,0.08), 0 24px 48px -20px rgba(32,40,33,0.28);
        }

        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
            font-family: 'Public Sans', system-ui, sans-serif;
            color: var(--ink);
            background: radial-gradient(1000px 300px at 15% -10%, rgba(31,111,84,0.07), transparent 60%), var(--canvas);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .card {
            background: var(--surface);
            border-radius: 20px;
            box-shadow: var(--shadow);
            padding: 40px 38px;
            max-width: 380px;
            text-align: center;
        }

        .glyph {
            width: 64px;
            height: 64px;
            margin: 0 auto 18px;
            border-radius: 50%;
            background: var(--primary-bg);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
        }

        h1 {
            font-family: 'Fraunces', serif;
            font-weight: 600;
            font-size: 1.3rem;
            margin: 0 0 8px;
            letter-spacing: -0.01em;
        }

        p {
            color: var(--muted);
            font-size: .88rem;
            line-height: 1.55;
            margin: 0 0 6px;
        }

        .ref {
            display: inline-block;
            font-family: 'IBM Plex Mono', monospace;
            font-size: .74rem;
            color: var(--muted);
            background: var(--canvas);
            border: 1px solid var(--line);
            padding: 4px 10px;
            border-radius: 999px;
            margin: 10px 0 22px;
        }

        .actions {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            text-decoration: none;
            font-weight: 600;
            font-size: .86rem;
            padding: 11px 18px;
            border-radius: 999px;
            border: none;
            cursor: pointer;
        }

        .btn-primary {
            background: var(--primary);
            color: #fff;
        }

            .btn-primary:hover {
                background: var(--primary-ink);
                color: #fff;
                text-decoration: none;
            }

        .btn-ghost {
            background: transparent;
            color: var(--ink);
            border: 1px solid var(--line);
        }

            .btn-ghost:hover {
                border-color: var(--primary);
                color: var(--primary-ink);
                text-decoration: none;
            }
    </style>
</head>
<body>
    <div class="card">
        <div class="glyph">🚕</div>
        <h1>Nothing to track right now</h1>
        <p>This ride may have already ended, or its tracking link has expired.</p>
        <span class="ref">Booking #@bookingId</span>
        <div class="actions">
            <a class="btn btn-primary" asp-action="CabBookingList" asp-controller="Reports">View my bookings</a>
            <button class="btn btn-ghost" type="button" onclick="location.reload()">Try again</button>
        </div>
    </div>
</body>
</html>
