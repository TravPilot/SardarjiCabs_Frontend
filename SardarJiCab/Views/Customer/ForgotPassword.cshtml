<!-- ================= FORGOT PASSWORD (split layout) ================= -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
    :root {
        --road: #1B1B1F;
        --mustard: #F2A93C;
        --mustard-dark: #D6891C;
        --marigold: #E5572B;
        --marigold-dk: #C0431E;
        --teal: #0E6B5F;
        --teal-dark: #0A4F46;
        --teal-pale: #E4F1EE;
        --cream: #FBF3E1;
        --ink: #241C14;
        --ink-soft: #7A6E5C;
        --line: #E6D9BC;
        --danger: #B3261E;
        --radius: 12px;
    }

    @@media (min-width: 980px) {
        nav.navbar.navbar-expand-sm.navbar-toggleable-sm.navbar-light.bg-white.border-bottom.box-shadow.mb-3 {
            margin: 0 !important;
            padding: 0;
        }
    }

    #forgot-split * {
        box-sizing: border-box;
    }

    #forgot-split {
        font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
        color: var(--ink);
        background: var(--cream);
    }

        #forgot-split .fs-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1.5rem 3rem;
            border-bottom: 1px solid var(--line);
        }

        #forgot-split .fs-logo {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            font-family: "Baloo 2", sans-serif;
            font-weight: 800;
            font-size: 1.35rem;
            color: var(--ink);
            text-decoration: none;
        }

            #forgot-split .fs-logo .mark {
                width: 34px;
                height: 34px;
                border-radius: 50%;
                background: var(--teal);
                color: var(--cream);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 0.95rem;
            }

        #forgot-split .fs-header nav a {
            color: var(--ink-soft);
            text-decoration: none;
            font-size: 0.95rem;
            font-weight: 500;
            margin-left: 2rem;
        }

            #forgot-split .fs-header nav a:hover {
                color: var(--ink);
            }

        #forgot-split .hero {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
            align-items: center;
            max-width: 1280px;
            margin: 0 auto;
            padding: 3.5rem 3rem 4rem;
            direction: ltr;
        }

        #forgot-split .hero-left {
            max-width: 420px;
            order: 1;
            grid-column: 1;
        }

        #forgot-split .hero-right {
            order: 2;
            grid-column: 2;
            position: relative;
            border-radius: 20px;
            overflow: hidden;
            aspect-ratio: 4 / 3;
            box-shadow: 0 30px 60px -24px rgba(27,27,31,0.45);
        }

            #forgot-split .hero-right svg {
                display: block;
                width: 100%;
                height: 100%;
            }

        #forgot-split .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--teal-dark);
            margin-bottom: 1rem;
        }

            #forgot-split .eyebrow .dot {
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: var(--marigold);
            }

        #forgot-split h1 {
            font-family: "Baloo 2", sans-serif;
            font-size: 2.35rem;
            line-height: 1.08;
            font-weight: 800;
            margin: 0 0 0.6rem;
            color: var(--ink);
        }

        #forgot-split .subtitle {
            font-size: 0.98rem;
            color: var(--ink-soft);
            margin: 0 0 2rem;
        }

        #forgot-split .form-group {
            margin-bottom: 1.15rem;
            text-align: left;
        }

            #forgot-split .form-group label {
                display: block;
                font-size: 0.72rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.08em;
                color: var(--teal-dark);
                margin-bottom: 0.4rem;
            }

        #forgot-split .form-control {
            width: 100%;
            height: auto;
            padding: 0.8rem 0.95rem;
            font-size: 0.98rem;
            font-family: inherit;
            color: var(--ink);
            background: #FFFFFF;
            border: 1.5px solid var(--line);
            border-radius: var(--radius);
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

            #forgot-split .form-control::placeholder {
                color: #A99C84;
            }

            #forgot-split .form-control:hover {
                border-color: var(--mustard-dark);
            }

            #forgot-split .form-control:focus {
                outline: none;
                border-color: var(--teal);
                box-shadow: 0 0 0 3px rgba(14,107,95,0.15);
            }

        #forgot-split .btn-theme {
            width: 100%;
            background: var(--marigold);
            color: #FFFFFF;
            border: none;
            border-radius: var(--radius);
            padding: 0.9rem 1.25rem;
            height: auto;
            font-family: "Baloo 2", sans-serif;
            font-size: 1.02rem;
            font-weight: 700;
            cursor: pointer;
            margin-top: 0.3rem;
            box-shadow: 0 12px 22px -10px rgba(229,87,43,0.6);
            transition: background 0.15s ease, transform 0.05s ease;
        }

            #forgot-split .btn-theme:hover {
                background: var(--marigold-dk);
            }

            #forgot-split .btn-theme:active {
                transform: translateY(1px);
            }

        #forgot-split hr {
            border: none;
            border-top: 1px dashed var(--line);
            margin: 1.75rem 0 1.25rem;
        }

        #forgot-split .new-account {
            text-align: center;
            margin-bottom: 0.9rem;
        }

            #forgot-split .new-account a {
                color: var(--teal-dark);
                text-decoration: none;
                font-weight: 700;
                font-size: 0.9rem;
            }

                #forgot-split .new-account a:hover {
                    text-decoration: underline;
                }

        #forgot-split .signup-row {
            text-align: center;
            font-size: 0.92rem;
            color: var(--ink-soft);
        }

            #forgot-split .signup-row a {
                display: inline-block;
                margin-left: 0.6rem;
                padding: 0.45rem 1rem;
                background: var(--teal);
                color: #FFFFFF;
                border-radius: 999px;
                text-decoration: none;
                font-weight: 600;
                font-size: 0.85rem;
                transition: background 0.15s ease;
            }

                #forgot-split .signup-row a:hover {
                    background: var(--teal-dark);
                }

    @@media (max-width: 980px) {
        #forgot-split .hero

    {
        grid-template-columns: 1fr;
        padding: 2.5rem 1.5rem 3rem;
    }

    #forgot-split .fs-header {
        padding: 1.25rem 1.5rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    #forgot-split h1 {
        font-size: 2rem;
    }

    #forgot-split .hero-right {
        aspect-ratio: 16/10;
    }

    }

    @@media (prefers-reduced-motion: reduce) {
        #forgot-split .form-control, #forgot-split .btn-theme, #forgot-split .signup-row a

    {
        transition: none;
    }

    }
</style>

<div id="forgot-split">

    <div class="hero">
        <div class="hero-left">
            <div class="eyebrow"><span class="dot"></span> Account Recovery</div>
            <h1>Forgot your password?</h1>
            <p class="subtitle">Enter your email and we'll send you a link to get back into your account.</p>

            <fieldset style="width:100%; border:none; padding:0; margin:0;">
                <div class="form-group is-empty">
                    <label for="userEmail">Email</label>
                    <div class="position-rel">
                        <input class="form-control" name="Email" type="text" id="userEmail" placeholder="you@example.com">
                    </div>
                </div>
            </fieldset>

            <div class="button-action to-signup">
                <input type="button" onclick="getEmail()" value="Send Reset Link" class="btn hoverable waves-effect waves-light btn-theme register">
            </div>

            <hr>

            <div class="new-account">
                <a href="/login"><i class="fa fa-angle-double-right"></i> <b>Back To Login</b> <i class="fa fa-angle-double-left"></i></a>
            </div>
            <div class="signup-row">
                <span>Don't have an account?</span>
                <a href="/Registration/Index">Sign Up</a>
            </div>
        </div>

        <div class="hero-right">
            <svg viewBox="0 0 700 875" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
                <defs>
                    <linearGradient id="sky3" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#0A4F46" />
                        <stop offset="45%" stop-color="#0E6B5F" />
                        <stop offset="75%" stop-color="#D6891C" />
                        <stop offset="100%" stop-color="#F2A93C" />
                    </linearGradient>
                    <radialGradient id="glow3" cx="50%" cy="50%" r="50%">
                        <stop offset="0%" stop-color="#FBF3E1" />
                        <stop offset="55%" stop-color="#F2A93C" />
                        <stop offset="100%" stop-color="#E5572B" stop-opacity="0" />
                    </radialGradient>
                </defs>

                <rect width="700" height="875" fill="url(#sky3)" />
                <circle cx="230" cy="260" r="140" fill="url(#glow3)" />

                <path d="M0 470 Q120 400 260 460 T520 440 T700 470 V875 H0 Z" fill="#0F5A50" opacity="0.85" />
                <path d="M0 520 Q160 460 340 510 T700 500 V875 H0 Z" fill="#0A4F46" />

                <rect x="0" y="700" width="700" height="175" fill="#1B1B1F" />
                <rect x="0" y="700" width="700" height="10" fill="#241C14" />
                <g fill="#FBF3E1" opacity="0.85">
                    <rect x="0" y="778" width="46" height="8" rx="2" />
                    <rect x="82" y="778" width="46" height="8" rx="2" />
                    <rect x="164" y="778" width="46" height="8" rx="2" />
                    <rect x="246" y="778" width="46" height="8" rx="2" />
                    <rect x="328" y="778" width="46" height="8" rx="2" />
                    <rect x="410" y="778" width="46" height="8" rx="2" />
                    <rect x="492" y="778" width="46" height="8" rx="2" />
                    <rect x="574" y="778" width="46" height="8" rx="2" />
                    <rect x="656" y="778" width="46" height="8" rx="2" />
                </g>

                <!-- auto-rickshaw waiting, headlight on -->
                <g transform="translate(400,590)">
                    <ellipse cx="70" cy="150" rx="120" ry="14" fill="#000000" opacity="0.22" />
                    <path d="M10 60 Q10 10 60 10 H130 Q150 10 150 40 V110 H10 Z" fill="#F2A93C" />
                    <rect x="0" y="100" width="170" height="30" rx="8" fill="#D6891C" />
                    <rect x="18" y="26" width="46" height="46" rx="6" fill="#0A4F46" opacity="0.85" />
                    <circle cx="34" cy="140" r="20" fill="#1B1B1F" />
                    <circle cx="34" cy="140" r="8" fill="#7A6E5C" />
                    <circle cx="140" cy="140" r="20" fill="#1B1B1F" />
                    <circle cx="140" cy="140" r="8" fill="#7A6E5C" />
                    <circle cx="158" cy="55" r="9" fill="#FBF3E1" />
                    <circle cx="158" cy="55" r="18" fill="#FBF3E1" opacity="0.25" />
                    <rect x="0" y="55" width="14" height="10" rx="2" fill="#E5572B" />
                </g>

                <!-- envelope with a wax-seal, floating toward the phone: password-reset motif -->
                <g transform="translate(150,300) rotate(-8)">
                    <rect x="0" y="0" width="150" height="102" rx="10" fill="#FBF3E1" stroke="#D6891C" stroke-width="3" />
                    <path d="M4 8 L75 62 L146 8" fill="none" stroke="#D6891C" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" />
                    <circle cx="75" cy="58" r="16" fill="#E5572B" />
                    <path d="M68 58 q7 -9 14 0 q-7 9 -14 0Z" fill="#FBF3E1" />
                </g>

                <!-- gentle motion lines -->
                <path d="M60 420 q30 -6 60 0" stroke="#FBF3E1" stroke-width="3" fill="none" opacity="0.5" stroke-linecap="round" />
                <path d="M40 445 q40 -8 80 0" stroke="#FBF3E1" stroke-width="3" fill="none" opacity="0.35" stroke-linecap="round" />

                <!-- foreground marigold garland silhouette, bottom-left corner -->
                <g transform="translate(-40,560)" opacity="0.96">
                    <path d="M40 320 C-20 260 0 150 90 120 C60 190 100 240 150 250 C110 190 140 120 210 100 C190 170 220 230 270 250
                   C240 190 260 120 320 110 C300 180 320 240 360 260 L360 320 Z" fill="#241C14" />
                    <circle cx="70" cy="150" r="14" fill="#E5572B" opacity="0.9" />
                    <circle cx="130" cy="115" r="11" fill="#F2A93C" opacity="0.9" />
                    <circle cx="200" cy="140" r="13" fill="#E5572B" opacity="0.8" />
                    <circle cx="270" cy="120" r="10" fill="#F2A93C" opacity="0.85" />
                    <circle cx="40" cy="230" r="9" fill="#F2A93C" opacity="0.7" />
                </g>
            </svg>
        </div>
    </div>
</div>
<!-- ================= /FORGOT PASSWORD ================= -->

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    function getEmail() {

        $.ajax({
            type: "POST",
            url: "/Customer/VerifyAccount",
            dataType: "json",
            data: {
                Email: $("#userEmail").val()
            },
            success: function (data) {

                if (data.IsSuccess) {

                    Swal.fire({
                        icon: "success",
                        title: "Success",
                        text: data.Message,
                        confirmButtonText: "OK"
                    }).then(function () {
                        window.location.reload();
                    });

                } else {

                    Swal.fire({
                        icon: "error",
                        title: "Error",
                        text: data.Message,
                        confirmButtonText: "OK"
                    });

                }
            },
            error: function (xhr, status, error) {

                Swal.fire({
                    icon: "error",
                    title: "Error",
                    text: "Result: " + status + " " + error
                });

            }
        });

    }

    function onAjaxRequestSuccess(data) {

        Swal.fire({
            icon: "success",
            title: "Success",
            text: data.Message,
            confirmButtonText: "OK"
        }).then(function () {
            window.location.reload();
        });

    }
</script>
