@{
    ViewData["Title"] = "Contact Us - SardarJi Travels";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Work+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
    :root {
        --ink: #1B2A41;
        --ink-soft: #33465F;
        --paper: #FBF3E7;
        --paper-dim: #F3E7D4;
        --marigold: #E8A93B;
        --marigold-deep: #C4841F;
        --terracotta: #C2452D;
        --teal: #0F6466;
        --line: rgba(27, 42, 65, 0.16);
    }

    .sjt-contact-page {
        background: radial-gradient(circle at 8% 12%, rgba(232,169,59,0.10), transparent 40%), radial-gradient(circle at 92% 88%, rgba(15,100,102,0.10), transparent 40%), var(--paper);
        font-family: 'Work Sans', sans-serif;
        color: var(--ink);
        padding: 64px 20px 80px;
        min-height: 100vh;
    }

    .sjt-wrap {
        max-width: 1040px;
        margin: 0 auto;
    }

    /* ---------- Header ---------- */
    .sjt-eyebrow {
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--terracotta);
        margin-bottom: 14px;
    }

        .sjt-eyebrow::before {
            content: "";
            width: 26px;
            height: 1px;
            background: var(--terracotta);
            display: inline-block;
        }

    .sjt-title {
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: clamp(2.4rem, 5vw, 3.6rem);
        line-height: 1.05;
        margin: 0 0 12px;
        color: var(--ink);
    }

        .sjt-title em {
            font-style: italic;
            color: var(--terracotta);
        }

    .sjt-subtitle {
        max-width: 560px;
        font-size: 1.02rem;
        color: var(--ink-soft);
        line-height: 1.6;
        margin-bottom: 48px;
    }

    /* ---------- Boarding Pass Card ---------- */
    .sjt-pass {
        display: grid;
        grid-template-columns: 1.55fr 1fr;
        background: #fff;
        border-radius: 22px;
        box-shadow: 0 30px 60px -25px rgba(27,42,65,0.35), 0 2px 0 rgba(27,42,65,0.03);
        overflow: hidden;
        position: relative;
        border: 1px solid var(--line);
    }

    @@media (max-width: 760px) {
        .sjt-pass {
            grid-template-columns: 1fr;
        }
    }

    .sjt-pass-main {
        padding: 44px 40px;
        position: relative;
    }

        .sjt-pass-main::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image: repeating-linear-gradient(135deg, rgba(232,169,59,0.05) 0px, rgba(232,169,59,0.05) 1px, transparent 1px, transparent 14px);
            pointer-events: none;
        }

    .sjt-agency-row {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 34px;
    }

    .sjt-mark {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: linear-gradient(150deg, var(--teal), #0a3f40);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--paper);
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: 1.3rem;
        flex-shrink: 0;
        box-shadow: 0 6px 16px rgba(15,100,102,0.35);
    }

    .sjt-agency-name {
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: 1.3rem;
        line-height: 1.15;
        color: var(--ink);
    }

    .sjt-agency-tag {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.68rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--teal);
        margin-top: 3px;
    }

    .sjt-field-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.66rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--ink-soft);
        opacity: 0.65;
        margin-bottom: 6px;
    }

    .sjt-field {
        margin-bottom: 26px;
    }

    .sjt-field-value {
        font-size: 1.08rem;
        font-weight: 500;
        color: var(--ink);
    }

        .sjt-field-value a {
            color: inherit;
            text-decoration: none;
            border-bottom: 1.5px solid var(--marigold);
            transition: border-color 0.2s ease, color 0.2s ease;
        }

            .sjt-field-value a:hover {
                color: var(--terracotta);
                border-color: var(--terracotta);
            }

    .sjt-field-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        color: var(--marigold-deep);
        margin-right: 6px;
    }

    .sjt-address-value {
        font-size: 1.02rem;
        line-height: 1.6;
        color: var(--ink);
        max-width: 420px;
    }

    .sjt-contact-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0 28px;
    }

    @@media (max-width: 480px) {
        .sjt-contact-grid {
            grid-template-columns: 1fr;
        }
    }

    /* ---------- Perforated divider (boarding-pass stub cut) ---------- */
    .sjt-pass-stub {
        background: linear-gradient(160deg, var(--teal) 0%, #0a4142 100%);
        color: var(--paper);
        padding: 44px 32px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
    }

        .sjt-pass-stub::before {
            content: "";
            position: absolute;
            top: 0;
            left: -12px;
            width: 24px;
            height: 100%;
            background-image: radial-gradient(circle, var(--paper) 6px, transparent 7px);
            background-size: 24px 26px;
            background-repeat: repeat-y;
        }

    @@media (max-width: 760px) {
        .sjt-pass-stub::before {
            top: -12px;
            left: 0;
            width: 100%;
            height: 24px;
            background-image: radial-gradient(circle, var(--paper) 6px, transparent 7px);
            background-size: 26px 24px;
            background-repeat: repeat-x;
        }
    }

    .sjt-stub-eyebrow {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.66rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--marigold);
        margin-bottom: 10px;
    }

    .sjt-stub-heading {
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: 1.6rem;
        line-height: 1.2;
        margin-bottom: 18px;
    }

    .sjt-stub-desc {
        font-size: 0.92rem;
        line-height: 1.65;
        color: rgba(251,243,231,0.82);
        margin-bottom: 28px;
    }

    .sjt-stub-cta {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.78rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--ink);
        background: var(--marigold);
        padding: 13px 20px;
        border-radius: 999px;
        text-decoration: none;
        width: fit-content;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
        box-shadow: 0 10px 22px rgba(232,169,59,0.35);
    }

        .sjt-stub-cta:hover {
            transform: translateY(-2px);
            background: #f0b74d;
            box-shadow: 0 14px 28px rgba(232,169,59,0.45);
        }

    .sjt-stub-footer {
        margin-top: 28px;
        padding-top: 20px;
        border-top: 1px dashed rgba(251,243,231,0.28);
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        color: rgba(251,243,231,0.6);
        display: flex;
        justify-content: space-between;
    }

    /* ---------- Map section ---------- */
    .sjt-map-block {
        margin-top: 56px;
    }

    .sjt-map-heading-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 20px;
    }

    .sjt-map-heading {
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: 1.6rem;
        color: var(--ink);
    }

    .sjt-map-open {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--terracotta);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-bottom: 1.5px solid transparent;
        transition: border-color 0.2s ease;
    }

        .sjt-map-open:hover {
            border-color: var(--terracotta);
        }

    .sjt-map-frame-wrap {
        position: relative;
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid var(--line);
        box-shadow: 0 24px 48px -28px rgba(27,42,65,0.4);
    }

        .sjt-map-frame-wrap iframe {
            width: 100%;
            height: 380px;
            border: 0;
            display: block;
            filter: saturate(0.92) contrast(1.02);
        }

    .sjt-map-pin-note {
        position: absolute;
        left: 20px;
        bottom: 20px;
        background: rgba(27,42,65,0.92);
        color: var(--paper);
        padding: 12px 18px;
        border-radius: 14px;
        font-size: 0.82rem;
        max-width: 260px;
        line-height: 1.5;
        backdrop-filter: blur(4px);
    }

        .sjt-map-pin-note strong {
            display: block;
            font-family: 'Fraunces', serif;
            font-size: 0.95rem;
            color: var(--marigold);
            margin-bottom: 2px;
        }

    @@media (max-width: 560px) {
        .sjt-map-pin-note {
            position: static;
            margin-top: 14px;
            max-width: 100%;
        }
    }
</style>

<div class="sjt-contact-page">
    <div class="sjt-wrap">

        <div class="sjt-eyebrow">Get in touch</div>
        <h1 class="sjt-title">Let's plan your <em>next journey</em></h1>
        <p class="sjt-subtitle">
            Questions about a package, a departure date, or a custom itinerary? SardarJi Travels
            is a call, an email, or a visit away — here's every way to reach us.
        </p>

        <!-- Boarding pass style contact card -->
        <div class="sjt-pass">
            <div class="sjt-pass-main">
                <div class="sjt-agency-row">
                    <div class="sjt-mark">S</div>
                    <div>
                        <div class="sjt-agency-name">SardarJi Travels</div>
                        <div class="sjt-agency-tag">Tour &amp; Travel Agency</div>
                    </div>
                </div>

                <div class="sjt-contact-grid">
                    <div class="sjt-field">
                        <div class="sjt-field-label">Contact person</div>
                        <div class="sjt-field-value">
                            <span class="sjt-field-icon"><i class="fa-solid fa-user"></i></span>
                            Jaswinder Singh
                        </div>
                    </div>

                    <div class="sjt-field">
                        <div class="sjt-field-label">Phone</div>
                        <div class="sjt-field-value">
                            <span class="sjt-field-icon"><i class="fa-solid fa-phone"></i></span>
                            <a href="tel:+91919990350250">+91 91999 90350250</a>
                        </div>
                    </div>

                    <div class="sjt-field">
                        <div class="sjt-field-label">Email</div>
                        <div class="sjt-field-value">
                            <span class="sjt-field-icon"><i class="fa-solid fa-envelope"></i></span>
                            <a href="mailto:jsingh5880@gmail.com">jsingh5880@gmail.com</a>
                        </div>
                    </div>

                    <div class="sjt-field">
                        <div class="sjt-field-label">Working hours</div>
                        <div class="sjt-field-value">
                            <span class="sjt-field-icon"><i class="fa-solid fa-clock"></i></span>
                            Mon – Sat, 10:00 – 19:00
                        </div>
                    </div>
                </div>

                <div class="sjt-field" style="margin-bottom: 0;">
                    <div class="sjt-field-label">Office address</div>
                    <div class="sjt-address-value">
                        <span class="sjt-field-icon" style="vertical-align: top;"><i class="fa-solid fa-location-dot"></i></span>
                        Ground Floor, Graphix, A-13, A Block, Block A,
                        Industrial Area, Sector 62, Noida, Uttar Pradesh 201309
                    </div>
                </div>
            </div>

            <div class="sjt-pass-stub">
                <div>
                    <div class="sjt-stub-eyebrow">Boarding · Enquiry Desk</div>
                    <div class="sjt-stub-heading">Ready when you are</div>
                    <p class="sjt-stub-desc">
                        Tell us your travel dates and headcount, and we'll send back a tailored
                        quote — same as the packages you see above, personalised for you.
                    </p>
                    <a class="sjt-stub-cta" href="https://wa.me/919990350250" target="_blank" rel="noopener">
                        <i class="fa-brands fa-whatsapp"></i> Message us on WhatsApp
                    </a>
                </div>
                <div class="sjt-stub-footer">
                    <span>NOIDA · UP</span>
                    <span>201309</span>
                </div>
            </div>
        </div>

        <!-- Map section -->
        <div class="sjt-map-block">
            <div class="sjt-map-heading-row">
                <div class="sjt-map-heading">Find our office</div>
                <a class="sjt-map-open"
                   href="https://www.google.com/maps/search/?api=1&query=Graphix%2C%20A-13%2C%20A%20Block%2C%20Sector%2062%2C%20Noida%2C%20Uttar%20Pradesh%20201309"
                   target="_blank" rel="noopener">
                    Open in Google Maps <i class="fa-solid fa-arrow-up-right-from-square"></i>
                </a>
            </div>

            <div class="sjt-map-frame-wrap">
                <iframe src="https://www.google.com/maps?q=Graphix,+A-13,+A+Block,+Block+A,+Industrial+Area,+Sector+62,+Noida,+Uttar+Pradesh+201309&output=embed"
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        allowfullscreen>
                </iframe>
                <div class="sjt-map-pin-note">
                    <strong>SardarJi Travels</strong>
                    Ground Floor, Graphix, A-13, Sector 62, Noida, UP 201309
                </div>
            </div>
        </div>

    </div>
</div>
