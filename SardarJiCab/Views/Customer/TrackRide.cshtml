@model TrackRideViewModel
@{
    Layout = null; 
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Track Your Ride</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
            font-family: system-ui, sans-serif;
        }

        #map {
            width: 100%;
            height: 100vh;
        }

        #status {
            position: absolute;
            top: 10px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 10;
            background: white;
            padding: 8px 16px;
            border-radius: 20px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.25);
            font-size: 14px;
        }
    </style>
</head>
<body>

    <div id="status">Tracking @Model.DriverName...</div>
    <div id="map"></div>

    <script>
        // ---- CONFIG (rendered server-side from the initial DB fetch) ----
        const BOOKING_ID = @Model.BookingId;
        const POLL_INTERVAL_MS = 4000;
        const LIVE_LOCATION_URL = `/Booking/LiveLocationJson/${BOOKING_ID}`;

        let map;
        let cabMarker;

        function initMap() {
            const startPos = { lat: @Model.Latitude, lng: @Model.Longitude, };

            map = new google.maps.Map(document.getElementById("map"), {
                zoom: 15,
                center: startPos,
            });

            cabMarker = new google.maps.Marker({
                position: startPos,
                map: map,
                icon: {
                    path: "M22.5,10 L23.5,10 L23.5,12 L22.5,12 Z", // placeholder — swap for a real cab icon/SVG path
                    scale: 6,
                    fillColor: "#1a73e8",
                    fillOpacity: 1,
                    strokeWeight: 1,
                    strokeColor: "#fff",
                },
                title: "@Model.DriverName",
            });

            // start polling once the map is ready
            setInterval(fetchAndUpdateLocation, POLL_INTERVAL_MS);
        }

        // Smoothly slide the marker from its current spot to the new one,
        // instead of snapping — makes the movement look like a real cab.
        function animateMarkerTo(marker, newPos, duration = 1000) {
            const start = marker.getPosition();
            const startLat = start.lat();
            const startLng = start.lng();
            const startTime = performance.now();

            function step(now) {
                const t = Math.min((now - startTime) / duration, 1);
                const lat = startLat + (newPos.lat - startLat) * t;
                const lng = startLng + (newPos.lng - startLng) * t;
                marker.setPosition({ lat, lng });
                if (t < 1) requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
        }

        async function fetchAndUpdateLocation() {
            try {
                const res = await fetch(LIVE_LOCATION_URL);

                if (!res.ok) {
                    document.getElementById("status").textContent = "Location unavailable...";
                    return;
                }

                const data = await res.json();
                const newPos = { lat: data.latitude, lng: data.longitude };

                animateMarkerTo(cabMarker, newPos, POLL_INTERVAL_MS * 0.9);
                document.getElementById("status").textContent = `Tracking ${data.driverName}...`;
            } catch (err) {
                console.error("Live location fetch failed:", err);
                document.getElementById("status").textContent = "Connection error, retrying...";
            }
        }
    </script>

    <script src="https://maps.googleapis.com/maps/api/js?key=@Model.GoogleMapsApiKey&callback=initMap"
            async defer>
    </script>

</body>
</html>
