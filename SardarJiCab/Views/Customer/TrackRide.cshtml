@model TrackRideViewModel
@{
    Layout = null;
}

<meta charset="utf-8" />
<title>Track your ride</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,600;0,9..144,700;1,9..144,600&family=Public+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap');

    :root {
        --ink: #202821;
        --muted: #6E7A70;
        --line: #E4E1D4;
        --surface: #FFFFFF;
        --surface-alt: #FBFAF5;
        --canvas: #F6F4EC;
        --primary: #1F6F54;
        --primary-ink: #153E2F;
        --primary-bg: #E5F1EA;
        --accent: #E7A537;
        --accent-ink: #7A5410;
        --danger: #B4443A;
        --shadow: 0 6px 16px rgba(32,40,33,0.08), 0 24px 48px -20px rgba(32,40,33,0.28);
        --safe-t: env(safe-area-inset-top, 0px);
        --safe-b: env(safe-area-inset-bottom, 0px);
    }

    * {
        box-sizing: border-box;
    }

    html, body {
        margin: 0;
        padding: 0;
        height: 100%;
        font-family: 'Public Sans', system-ui, sans-serif;
        color: var(--ink);
        background: var(--canvas);
        overscroll-behavior: none;
    }

    #map {
        width: 100%;
        height: 100vh;
        height: 100dvh;
        background: var(--canvas);
    }

    /* ---------- back pill ---------- */
    .track-back {
        position: absolute;
        top: calc(16px + var(--safe-t));
        left: 16px;
        z-index: 12;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: var(--surface);
        border: 1px solid var(--line);
        color: var(--ink);
        text-decoration: none;
        font-size: .82rem;
        font-weight: 600;
        min-height: 40px;
        padding: 9px 15px 9px 13px;
        border-radius: 999px;
        box-shadow: var(--shadow);
        cursor: pointer;
    }

        .track-back:hover {
            border-color: var(--primary);
            color: var(--primary-ink);
        }

        .track-back:focus-visible {
            outline: 2px solid var(--primary);
            outline-offset: 2px;
        }

    /* ---------- status pill ---------- */
    #status-pill {
        position: absolute;
        top: calc(16px + var(--safe-t));
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
        display: inline-flex;
        align-items: center;
        gap: 9px;
        background: var(--surface);
        padding: 9px 18px 9px 14px;
        min-height: 40px;
        border-radius: 999px;
        box-shadow: var(--shadow);
        font-size: .86rem;
        font-weight: 600;
        max-width: calc(100% - 220px);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

        #status-pill .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--accent);
            flex: 0 0 auto;
            box-shadow: 0 0 0 0 rgba(231,165,55,0.6);
            animation: pulse 1.8s ease-out infinite;
        }

        #status-pill.is-lost .dot {
            background: var(--danger);
            animation: none;
        }

        #status-pill.phase-drop .dot {
            background: var(--primary);
        }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(231,165,55,0.55);
        }

        70% {
            box-shadow: 0 0 0 8px rgba(231,165,55,0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(231,165,55,0);
        }
    }

    /* ---------- phase stepper ---------- */
    #phase-stepper {
        position: absolute;
        top: calc(64px + var(--safe-t));
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
        display: flex;
        align-items: center;
        gap: 6px;
        background: var(--surface);
        padding: 8px 14px;
        border-radius: 999px;
        box-shadow: var(--shadow);
        font-size: .72rem;
        font-weight: 600;
        color: var(--muted);
    }

        #phase-stepper .step {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 3px 8px;
            border-radius: 999px;
        }

            #phase-stepper .step.active {
                background: var(--primary-bg);
                color: var(--primary-ink);
            }

        #phase-stepper .step-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--line);
        }

        #phase-stepper .step.active .step-dot,
        #phase-stepper .step.done .step-dot {
            background: var(--primary);
        }

        #phase-stepper .arrow {
            color: var(--line);
        }

    /* ---------- bottom sheet ---------- */
    #sheet {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 11;
        background: var(--surface);
        border-radius: 22px 22px 0 0;
        box-shadow: var(--shadow);
        padding: 10px 20px calc(18px + var(--safe-b));
        max-height: 62vh;
        overflow-y: auto;
        transition: max-height .3s cubic-bezier(.4,0,.2,1);
    }

        #sheet.is-collapsed {
            max-height: 128px;
            overflow: hidden;
        }

    #sheet-handle {
        width: 38px;
        height: 4px;
        background: var(--line);
        border-radius: 999px;
        margin: 2px auto 12px;
        border: none;
        display: block;
        cursor: pointer;
    }

        #sheet-handle:focus-visible {
            outline: 2px solid var(--primary);
            outline-offset: 4px;
        }

    .sheet-top {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .driver-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: var(--primary-bg);
        color: var(--primary-ink);
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .sheet-top__info {
        flex: 1;
        min-width: 0;
    }

    .sheet-top__name {
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: 16px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .sheet-top__sub {
        font-size: .78rem;
        color: var(--muted);
        font-family: 'IBM Plex Mono', monospace;
        margin-top: 2px;
    }

    .status-badge {
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
        background: var(--primary-bg);
        color: var(--primary-ink);
        padding: 4px 10px;
        border-radius: 999px;
        flex-shrink: 0;
    }

    .call-btn {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: var(--primary);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        flex-shrink: 0;
    }

        .call-btn:hover {
            background: var(--primary-ink);
        }

        .call-btn svg {
            width: 18px;
            height: 18px;
        }

    /* route timeline inside sheet */
    .route {
        display: flex;
        gap: 12px;
        margin-top: 18px;
        padding-top: 16px;
        border-top: 1px solid var(--line);
    }

    .route__rail {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-top: 4px;
    }

    .route__dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        border: 2px solid var(--primary);
        background: #fff;
    }

    .route__dot--drop {
        background: var(--ink);
        border-color: var(--ink);
    }

    .route__dot--done {
        background: var(--primary);
    }

    .route__line {
        width: 2px;
        flex: 1;
        min-height: 24px;
        margin: 4px 0;
        background: repeating-linear-gradient(to bottom, var(--line) 0, var(--line) 4px, transparent 4px, transparent 8px);
    }

    .route__line--done {
        background: var(--primary);
    }

    .route__stops {
        flex: 1;
        min-width: 0;
    }

    .route__stop {
        padding-bottom: 16px;
    }

        .route__stop:last-child {
            padding-bottom: 0;
        }

    .route__k {
        font-size: .68rem;
        text-transform: uppercase;
        letter-spacing: .07em;
        color: var(--muted);
        font-weight: 700;
    }

    .route__v {
        font-size: .86rem;
        font-weight: 500;
        margin-top: 2px;
        line-height: 1.4;
    }

    /* ---------- locating overlay ---------- */
    #locating {
        position: absolute;
        inset: 0;
        z-index: 15;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--canvas);
        padding: 20px;
    }

    .locating-card {
        background: var(--surface);
        border-radius: 20px;
        box-shadow: var(--shadow);
        padding: 34px 30px;
        max-width: 340px;
        width: 100%;
        text-align: center;
    }

    .radar {
        width: 76px;
        height: 76px;
        margin: 0 auto 18px;
        position: relative;
    }

        .radar .ring {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            border: 2px solid var(--primary);
            opacity: 0;
            animation: radar-ring 2.4s ease-out infinite;
        }

            .radar .ring:nth-child(2) {
                animation-delay: .8s;
            }

            .radar .ring:nth-child(3) {
                animation-delay: 1.6s;
            }

        .radar .pin {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 14px;
            height: 14px;
            margin: -7px 0 0 -7px;
            border-radius: 50%;
            background: var(--primary);
            box-shadow: 0 0 0 4px var(--primary-bg);
        }

    @@keyframes radar-ring {
        0% {
            transform: scale(0.4);
            opacity: .55;
        }

        100% {
            transform: scale(1.6);
            opacity: 0;
        }
    }

    .locating-card h1 {
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: 1.2rem;
        margin: 0 0 6px;
        letter-spacing: -0.01em;
    }

    .locating-card p {
        color: var(--muted);
        font-size: .86rem;
        line-height: 1.5;
        margin: 0 0 18px;
    }

    .locating-card .retry {
        display: none;
        border: none;
        background: var(--primary);
        color: #fff;
        font-weight: 600;
        font-size: .84rem;
        min-height: 44px;
        padding: 10px 22px;
        border-radius: 999px;
        cursor: pointer;
    }

        .locating-card .retry:hover {
            background: var(--primary-ink);
        }

    .locating-card.timed-out .retry {
        display: inline-block;
    }

    .locating-card.timed-out .waiting-copy {
        display: none;
    }

    .locating-card .timeout-copy {
        display: none;
    }

    .locating-card.timed-out .timeout-copy {
        display: block;
    }

    .locating-card.map-error .waiting-copy,
    .locating-card.map-error .timeout-copy {
        display: none;
    }

    .locating-card .map-error-copy {
        display: none;
    }

    .locating-card.map-error .map-error-copy {
        display: block;
    }

    .locating-card.map-error .radar {
        opacity: .35;
    }

    /* ---------- ride complete modal ---------- */
    .modal-overlay {
        position: absolute;
        inset: 0;
        z-index: 20;
        background: rgba(32,40,33,0.45);
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

        .modal-overlay.is-open {
            display: flex;
        }

    .modal-card {
        background: var(--surface);
        border-radius: 20px;
        box-shadow: var(--shadow);
        padding: 32px 26px;
        max-width: 360px;
        width: 100%;
        text-align: center;
    }

    .modal-check {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: var(--primary-bg);
        color: var(--primary-ink);
        font-size: 26px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
    }

    .modal-card h1 {
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: 1.25rem;
        margin: 0 0 6px;
    }

    .modal-card p {
        color: var(--muted);
        font-size: .86rem;
        line-height: 1.5;
        margin: 0 0 20px;
    }

    .star-rating {
        font-size: 30px;
        margin-bottom: 18px;
        letter-spacing: 4px;
    }

    .star {
        cursor: pointer;
        color: var(--line);
        transition: color .15s, transform .1s;
        display: inline-block;
    }

        .star.active {
            color: var(--accent);
        }

        .star:hover {
            transform: scale(1.08);
        }

    #feedback-comment {
        width: 100%;
        min-height: 74px;
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 10px 12px;
        font-family: inherit;
        font-size: .85rem;
        resize: vertical;
        margin-bottom: 16px;
        color: var(--ink);
    }

        #feedback-comment:focus {
            outline: 2px solid var(--primary);
            outline-offset: 1px;
        }

    .submit-btn {
        width: 100%;
        border: none;
        background: var(--primary);
        color: #fff;
        font-weight: 600;
        font-size: .88rem;
        min-height: 46px;
        border-radius: 999px;
        cursor: pointer;
        margin-bottom: 8px;
    }

        .submit-btn:hover {
            background: var(--primary-ink);
        }

        .submit-btn:disabled {
            opacity: .55;
            cursor: not-allowed;
        }

    .skip-btn {
        width: 100%;
        border: none;
        background: transparent;
        color: var(--muted);
        font-weight: 600;
        font-size: .82rem;
        min-height: 36px;
        cursor: pointer;
    }

        .skip-btn:hover {
            color: var(--ink);
        }

    .feedback-thanks {
        display: none;
        font-size: .88rem;
        color: var(--primary-ink);
        font-weight: 600;
        padding: 10px 0 2px;
    }

    /* ---------- small screens ---------- */
    @@media (max-width: 480px) {
        #status-pill {
            max-width: calc(100% - 170px);
            font-size: .8rem;
        }

        #sheet {
            padding-left: 16px;
            padding-right: 16px;
        }

        .sheet-top__name {
            font-size: 15px;
        }

        #phase-stepper {
            font-size: .66rem;
            padding: 6px 10px;
        }
    }

    @@media (min-width: 720px) {
        #sheet {
            left: 50%;
            transform: translateX(-50%);
            width: 480px;
            border-radius: 22px;
            bottom: 20px;
            box-shadow: var(--shadow);
        }
    }
</style>

<button class="track-back" onclick="history.back()" type="button">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
        <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    Back
</button>

<div id="status-pill"><span class="dot"></span><span id="status-text">Tracking @Model.DriverName&hellip;</span></div>

@{
    bool hasRoute = !string.IsNullOrWhiteSpace(Model.PickupAddress) || !string.IsNullOrWhiteSpace(Model.DropAddress);
}

@if (hasRoute)
{
    <div id="phase-stepper">
        <span class="step" id="step-pickup">
            <span class="step-dot"></span> Pickup
        </span>
        <span class="arrow">&rarr;</span>
        <span class="step" id="step-drop">
            <span class="step-dot"></span> Drop-off
        </span>
    </div>
}

<div id="map"></div>

@{
    bool hasFix = Model.Latitude.HasValue && Model.Longitude.HasValue;
    string initials = string.Join("", (Model.DriverName ?? "?").Split(' ', System.StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpper(w[0])));
}

<div id="sheet">
    <button id="sheet-handle" type="button" aria-label="Expand or collapse ride details" onclick="toggleSheet()"></button>

    <div class="sheet-top">
        <div class="driver-avatar" aria-hidden="true">@initials</div>
        <div class="sheet-top__info">
            <div class="sheet-top__name">@Model.DriverName</div>
            <div class="sheet-top__sub">Booking #@Model.BookingId</div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Status))
        {
            <span class="status-badge" id="status-badge">@Model.Status</span>
        }
    </div>

    @if (hasRoute)
    {
        <div class="route">
            <div class="route__rail">
                <span class="route__dot" id="route-dot-pickup"></span>
                <span class="route__line" id="route-line"></span>
                <span class="route__dot route__dot--drop" id="route-dot-drop"></span>
            </div>
            <div class="route__stops">
                <div class="route__stop">
                    <div class="route__k">Pickup</div>
                    <div class="route__v">@(Model.PickupAddress ?? "—")</div>
                </div>
                <div class="route__stop">
                    <div class="route__k">Drop</div>
                    <div class="route__v">@(Model.DropAddress ?? "—")</div>
                </div>
            </div>
        </div>
    }
</div>

<div id="locating" style="display:@(hasFix ? "none" : "flex");">
    <div class="locating-card" id="locating-card">
        <div class="radar"><span class="ring"></span><span class="ring"></span><span class="ring"></span><span class="pin"></span></div>
        <h1 class="waiting-copy">Locating @Model.DriverName&hellip;</h1>
        <p class="waiting-copy">We'll draw the map the moment their GPS signal comes through. This is usually quick.</p>
        <h1 class="timeout-copy">Still no signal</h1>
        <p class="timeout-copy">The driver's GPS hasn't checked in yet. You can keep waiting or try again.</p>
        <h1 class="map-error-copy">Map couldn't load</h1>
        <p class="map-error-copy">There's a problem loading the map right now. Please check your connection and try again.</p>
        <button class="retry" type="button" onclick="retryLocating()">Check again</button>
    </div>
</div>

<div class="modal-overlay" id="ride-complete-overlay">
    <div class="modal-card">
        <div class="modal-check">&#10003;</div>
        <h1>Ride complete</h1>
        <p id="ride-complete-copy">Hope you had a smooth ride with @Model.DriverName. How was it?</p>

        <div id="feedback-form">
            <div class="star-rating" id="star-rating">
                <span class="star" data-value="1">&#9733;</span>
                <span class="star" data-value="2">&#9733;</span>
                <span class="star" data-value="3">&#9733;</span>
                <span class="star" data-value="4">&#9733;</span>
                <span class="star" data-value="5">&#9733;</span>
            </div>

            <textarea id="feedback-comment" placeholder="Add a comment (optional)"></textarea>

            <button id="submit-feedback" class="submit-btn" type="button" disabled>Submit feedback</button>
            <button id="skip-feedback" class="skip-btn" type="button">Skip</button>
        </div>

        <div class="feedback-thanks" id="feedback-thanks">Thanks for your feedback!</div>
    </div>
</div>

<script>
    const BOOKING_ID = @Model.BookingId;

    const HAS_INITIAL_FIX = @(hasFix ? "true" : "false");

    const INITIAL_LAT = @(hasFix
        ? Model.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)
        : "null");

    const INITIAL_LNG = @(hasFix
        ? Model.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)
        : "null");

    const GMAPS_KEY = "@Model.GoogleMapsApiKey";

    // Poll driver location every 2 seconds
    const POLL_INTERVAL_MS = 2000;

    // Recalculate Google road route every 8 seconds
    const ROUTE_RECALC_INTERVAL_MS = 8000;

    const LOCATING_TIMEOUT_MS = 60000;

    // Distance from a waypoint that counts as "arrived" (meters)
    const ARRIVAL_THRESHOLD_METERS = 120;

    const LIVE_LOCATION_URL =
        '@Url.Action("LiveLocationJson", "Customer")?bookingId=' + BOOKING_ID;

    const FEEDBACK_URL =
        '@Url.Action("SubmitRideFeedback", "Customer")';


    // ============================================================
    // PICKUP / DROP
    // ============================================================

    const HAS_PICKUP =
    @((Model.PickupLatitude.HasValue && Model.PickupLongitude.HasValue) ? "true" : "false");

    const PICKUP_LOCATION = HAS_PICKUP
        ? {
            lat: @(Model.PickupLatitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0"),
            lng: @(Model.PickupLongitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")
        }
        : null;

    const HAS_DROP =
    @((Model.DropLatitude.HasValue && Model.DropLongitude.HasValue) ? "true" : "false");

    const DROP_LOCATION = HAS_DROP
        ? {
            lat: @(Model.DropLatitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0"),
            lng: @(Model.DropLongitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")
        }
        : null;

    // Server-provided starting phase: "toPickup" | "toDrop" | "completed"
    const INITIAL_PHASE = "@Model.RidePhase";

    // Current waypoint the driver is heading to (mutable — swaps after pickup)
    let HAS_DESTINATION = INITIAL_PHASE === "toDrop" ? HAS_DROP : HAS_PICKUP;
    let DESTINATION = INITIAL_PHASE === "toDrop" ? DROP_LOCATION : PICKUP_LOCATION;

    let currentPhase = INITIAL_PHASE === "completed" ? "toDrop" : INITIAL_PHASE; // handled below
  
    // ============================================================
    // GLOBAL VARIABLES
    // ============================================================

    let map = null;
    let cabMarker = null;
    let destinationMarker = null;
    let directionsService = null;
    let directionsRenderer = null;
    let fallbackRouteLine = null;
    let pollTimer = null;
    let locatingTimeoutTimer = null;
    let mapLoaded = false;
    let googleMapsLoading = false;
    let lastRouteCalcAt = 0;
    let currentDriverPosition = null;
    let selectedRating = 0;


    // ============================================================
    // MAP STYLE
    // ============================================================

    const MAP_STYLE = [
        { elementType: "geometry", stylers: [{ color: "#F6F4EC" }] },
        { elementType: "labels.icon", stylers: [{ visibility: "off" }] },
        { elementType: "labels.text.fill", stylers: [{ color: "#6E7A70" }] },
        { elementType: "labels.text.stroke", stylers: [{ color: "#FBFAF5" }] },
        { featureType: "poi", stylers: [{ visibility: "off" }] },
        { featureType: "transit", stylers: [{ visibility: "off" }] },
        { featureType: "road", elementType: "geometry", stylers: [{ color: "#FFFFFF" }] },
        { featureType: "road.arterial", elementType: "geometry", stylers: [{ color: "#FBFAF5" }] },
        { featureType: "road", elementType: "geometry.stroke", stylers: [{ color: "#E4E1D4" }] },
        { featureType: "water", elementType: "geometry", stylers: [{ color: "#DCEAE1" }] },
        { featureType: "landscape", elementType: "geometry", stylers: [{ color: "#F1EEE1" }] },
        { featureType: "landscape.natural", elementType: "geometry", stylers: [{ color: "#E5F1EA" }] }
    ];


    // ============================================================
    // PICKUP MARKER ICON (orange pin)
    // ============================================================

    const PICKUP_PIN_SVG =
        'data:image/svg+xml;charset=UTF-8,' +
        encodeURIComponent(`
            <svg xmlns="http://www.w3.org/2000/svg" width="42" height="52" viewBox="0 0 42 52">
                <path d="M21 1C9.95 1 1 9.95 1 21 c0 14.8 20 30 20 30s20-15.2 20-30 C41 9.95 32.05 1 21 1z" fill="#E7A537"/>
                <circle cx="21" cy="21" r="8" fill="#FFFFFF"/>
                <circle cx="21" cy="21" r="4" fill="#1F6F54"/>
            </svg>
        `);


    // ============================================================
    // DROP MARKER ICON (dark flag pin, visually distinct from pickup)
    // ============================================================

    const DROP_PIN_SVG =
        'data:image/svg+xml;charset=UTF-8,' +
        encodeURIComponent(`
            <svg xmlns="http://www.w3.org/2000/svg" width="42" height="52" viewBox="0 0 42 52">
                <path d="M21 1C9.95 1 1 9.95 1 21 c0 14.8 20 30 20 30s20-15.2 20-30 C41 9.95 32.05 1 21 1z" fill="#202821"/>
                <circle cx="21" cy="21" r="8" fill="#FFFFFF"/>
                <circle cx="21" cy="21" r="4" fill="#E7A537"/>
            </svg>
        `);


    // ============================================================
    // CAB ICON
    // ============================================================

    const CAB_ICON_SVG =
        'data:image/svg+xml;charset=UTF-8,' +
        encodeURIComponent(`
            <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 56 56">
                <circle cx="28" cy="28" r="25" fill="#FFFFFF" stroke="#1F6F54" stroke-width="3"/>
                <path d="M16 31 L19 22 C19.5 20.5 21 19.5 22.5 19.5 H33.5 C35 19.5 36.5 20.5 37 22 L40 31 V36 H16 Z" fill="#1F6F54"/>
                <rect x="21" y="22" width="14" height="7" rx="2" fill="#E5F1EA"/>
                <circle cx="21" cy="36" r="3" fill="#202821"/>
                <circle cx="35" cy="36" r="3" fill="#202821"/>
            </svg>
        `);


    // ============================================================
    // STATUS
    // ============================================================

    function setStatus(text, lost) {
        const statusText = document.getElementById("status-text");
        const statusPill = document.getElementById("status-pill");

        if (statusText) statusText.textContent = text;

        if (statusPill) {
            statusPill.classList.toggle("is-lost", !!lost);
            statusPill.classList.toggle("phase-drop", currentPhase === "toDrop");
        }
    }


    // ============================================================
    // PHASE STEPPER / ROUTE TIMELINE UI
    // ============================================================

    function updatePhaseUI() {
        const stepPickup = document.getElementById("step-pickup");
        const stepDrop = document.getElementById("step-drop");
        const routeDotPickup = document.getElementById("route-dot-pickup");
        const routeLine = document.getElementById("route-line");
        const statusBadge = document.getElementById("status-badge");

        if (currentPhase === "toPickup") {
            if (stepPickup) { stepPickup.classList.add("active"); stepPickup.classList.remove("done"); }
            if (stepDrop) { stepDrop.classList.remove("active", "done"); }
            if (statusBadge) statusBadge.textContent = "Heading to pickup";
        } else if (currentPhase === "toDrop") {
            if (stepPickup) { stepPickup.classList.remove("active"); stepPickup.classList.add("done"); }
            if (stepDrop) { stepDrop.classList.add("active"); stepDrop.classList.remove("done"); }
            if (routeDotPickup) routeDotPickup.classList.add("route__dot--done");
            if (routeLine) routeLine.classList.add("route__line--done");
            if (statusBadge) statusBadge.textContent = "On the way to drop-off";
        } else if (currentPhase === "completed") {
            if (stepDrop) { stepDrop.classList.remove("active"); stepDrop.classList.add("done"); }
            if (statusBadge) statusBadge.textContent = "Completed";
        }
    }


    // ============================================================
    // SHEET
    // ============================================================

    window.toggleSheet = function () {
        const sheet = document.getElementById("sheet");
        if (sheet) sheet.classList.toggle("is-collapsed");
    };


    // ============================================================
    // LOCATING OVERLAY
    // ============================================================

    function hideLocatingOverlay() {
        const el = document.getElementById("locating");
        if (!el) return;

        el.style.transition = "opacity .35s ease";
        el.style.opacity = "0";

        setTimeout(function () { el.style.display = "none"; }, 350);

        clearTimeout(locatingTimeoutTimer);
    }

    function markTimedOut() {
        const card = document.getElementById("locating-card");
        if (!card) return;
        card.classList.remove("map-error");
        card.classList.add("timed-out");
    }

    function markMapError() {
        clearTimeout(locatingTimeoutTimer);

        const el = document.getElementById("locating");
        const card = document.getElementById("locating-card");

        if (el) { el.style.display = "flex"; el.style.opacity = "1"; }
        if (card) { card.classList.remove("timed-out"); card.classList.add("map-error"); }

        setStatus("Unable to load Google Maps", true);
    }

    window.retryLocating = function () {
        const card = document.getElementById("locating-card");
        if (card) card.classList.remove("timed-out", "map-error");

        if (mapLoaded) {
            fetchAndUpdateLocation();
        } else {
            loadGoogleMaps();
        }

        locatingTimeoutTimer = setTimeout(markTimedOut, LOCATING_TIMEOUT_MS);
    };


    // ============================================================
    // GOOGLE MAP AUTH FAILURE
    // ============================================================

    window.gm_authFailure = function () {
        console.error("Google Maps authentication failed.");
        markMapError();
    };


    // ============================================================
    // LOAD GOOGLE MAPS - ONLY ONCE
    // ============================================================

    function loadGoogleMaps() {
        if (mapLoaded) return;
        if (googleMapsLoading) return;

        if (!GMAPS_KEY) {
            console.error("Google Maps API key is missing.");
            markMapError();
            return;
        }

        googleMapsLoading = true;

        const existingScript = document.getElementById("google-maps-script");
        if (existingScript) return;

        const script = document.createElement("script");
        script.id = "google-maps-script";
        script.src =
            "https://maps.googleapis.com/maps/api/js" +
            "?key=" + encodeURIComponent(GMAPS_KEY) +
            "&libraries=geometry" +
            "&callback=initGoogleMaps";
        script.async = true;
        script.defer = true;

        script.onerror = function () {
            googleMapsLoading = false;
            console.error("Google Maps script failed to load.");
            markMapError();
        };

        document.head.appendChild(script);
    }


    // ============================================================
    // GOOGLE MAP CALLBACK
    // ============================================================

    window.initGoogleMaps = function () {
        googleMapsLoading = false;

        if (HAS_INITIAL_FIX) {
            buildMap(INITIAL_LAT, INITIAL_LNG);
        } else {
            fetchAndUpdateLocation();
        }
    };


    // ============================================================
    // BUILD MAP
    // ============================================================

    function buildMap(centerLat, centerLng) {
        if (!window.google || !google.maps) {
            console.error("Google Maps is not available.");
            markMapError();
            return;
        }

        const startPos = { lat: Number(centerLat), lng: Number(centerLng) };
        currentDriverPosition = startPos;

        map = new google.maps.Map(document.getElementById("map"), {
            zoom: 14,
            center: startPos,
            disableDefaultUI: false,
            zoomControl: true,
            mapTypeControl: false,
            streetViewControl: false,
            fullscreenControl: true,
            clickableIcons: false,
            styles: MAP_STYLE
        });

        cabMarker = new google.maps.Marker({
            position: startPos,
            map: map,
            title: "@Model.DriverName",
            zIndex: 100,
            icon: {
                url: CAB_ICON_SVG,
                scaledSize: new google.maps.Size(56, 56),
                anchor: new google.maps.Point(28, 28)
            }
        });

        if (HAS_DESTINATION) {
            placeDestinationMarker();

            fallbackRouteLine = new google.maps.Polyline({
                path: [startPos, DESTINATION],
                map: map,
                strokeColor: "#E7A537",
                strokeOpacity: 0.7,
                strokeWeight: 4,
                geodesic: true,
                zIndex: 5
            });

            directionsService = new google.maps.DirectionsService();

            directionsRenderer = new google.maps.DirectionsRenderer({
                map: map,
                suppressMarkers: true,
                preserveViewport: true,
                polylineOptions: {
                    strokeColor: "#1F6F54",
                    strokeOpacity: 0.95,
                    strokeWeight: 6,
                    zIndex: 10
                }
            });

            computeRoute(startPos, true);
        }

        mapLoaded = true;
        hideLocatingOverlay();
        updatePhaseUI();
        setStatus("Tracking @Model.DriverName...");

        clearInterval(pollTimer);
        pollTimer = setInterval(fetchAndUpdateLocation, POLL_INTERVAL_MS);

        // If the server already told us the ride is done (edge case: page
        // opened after completion), just show the modal immediately.
        if (INITIAL_PHASE === "completed") {
            completeRide();
        }
    }


    // ============================================================
    // DESTINATION MARKER (pickup or drop, swapped on phase change)
    // ============================================================

    function placeDestinationMarker() {
        if (destinationMarker) {
            destinationMarker.setMap(null);
            destinationMarker = null;
        }

        if (!HAS_DESTINATION || !DESTINATION) return;

        const isDropPhase = currentPhase === "toDrop";

        destinationMarker = new google.maps.Marker({
            position: DESTINATION,
            map: map,
            title: isDropPhase ? "Drop location" : "Pickup location",
            zIndex: 90,
            icon: {
                url: isDropPhase ? DROP_PIN_SVG : PICKUP_PIN_SVG,
                scaledSize: new google.maps.Size(42, 52),
                anchor: new google.maps.Point(21, 52)
            }
        });
    }


    // ============================================================
    // CALCULATE REAL ROAD ROUTE
    // ============================================================

    function computeRoute(driverPos, fitBounds) {
        if (!HAS_DESTINATION || !directionsService || !DESTINATION) return;

        lastRouteCalcAt = Date.now();

        directionsService.route({
            origin: driverPos,
            destination: DESTINATION,
            travelMode: google.maps.TravelMode.DRIVING,
            provideRouteAlternatives: false
        }, function (result, status) {

            if (status !== "OK") {
                console.warn("Directions API failed:", status);

                if (fallbackRouteLine) {
                    fallbackRouteLine.setPath([driverPos, DESTINATION]);
                    fallbackRouteLine.setMap(map);
                }
                return;
            }

            if (fallbackRouteLine) fallbackRouteLine.setMap(null);

            directionsRenderer.setDirections(result);

            if (fitBounds) {
                const bounds = new google.maps.LatLngBounds();
                bounds.extend(driverPos);
                bounds.extend(DESTINATION);
                map.fitBounds(bounds, 100);
            }

            const route = result.routes && result.routes[0];
            if (!route) return;

            const leg = route.legs && route.legs[0];
            if (!leg) return;

            const label = currentPhase === "toDrop" ? "to drop-off" : "to pickup";

            setStatus(
                "@Model.DriverName is " + leg.duration.text +
                " away " + label + " · " + leg.distance.text
            );
        });
    }


    // ============================================================
    // SMOOTH CAB MOVEMENT
    // ============================================================

    function animateMarkerTo(marker, newPosition, duration) {
        if (!marker) return;

        const oldPosition = marker.getPosition();

        if (!oldPosition) {
            marker.setPosition(newPosition);
            return;
        }

        const startLat = oldPosition.lat();
        const startLng = oldPosition.lng();
        const startTime = performance.now();

        function step(now) {
            const progress = Math.min((now - startTime) / duration, 1);
            const eased = progress * (2 - progress);

            const lat = startLat + (newPosition.lat - startLat) * eased;
            const lng = startLng + (newPosition.lng - startLng) * eased;

            marker.setPosition({ lat: lat, lng: lng });

            if (progress < 1) requestAnimationFrame(step);
        }

        requestAnimationFrame(step);
    }


    // ============================================================
    // MOVE CAB
    // ============================================================

    function updateCabPosition(newPosition) {
        if (!cabMarker) return;

        animateMarkerTo(cabMarker, newPosition, POLL_INTERVAL_MS * 0.9);

        currentDriverPosition = newPosition;
    }


    // ============================================================
    // DISTANCE (haversine, meters)
    // ============================================================

    function distanceMeters(lat1, lng1, lat2, lng2) {
        const R = 6371000;
        const toRad = d => d * Math.PI / 180;
        const dLat = toRad(lat2 - lat1);
        const dLng = toRad(lng2 - lng1);
        const a = Math.sin(dLat / 2) ** 2 +
                  Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLng / 2) ** 2;
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    }


    // ============================================================
    // PHASE TRANSITIONS
    // ============================================================

    function checkPhaseTransition(driverPos) {
        if (currentPhase === "toPickup" && HAS_PICKUP) {
            const d = distanceMeters(driverPos.lat, driverPos.lng, PICKUP_LOCATION.lat, PICKUP_LOCATION.lng);
            if (d <= ARRIVAL_THRESHOLD_METERS) {
                switchToDropPhase();
            }
        } else if (currentPhase === "toDrop" && HAS_DROP) {
            const d = distanceMeters(driverPos.lat, driverPos.lng, DROP_LOCATION.lat, DROP_LOCATION.lng);
            if (d <= ARRIVAL_THRESHOLD_METERS) {
                completeRide();
            }
        }
    }

    function switchToDropPhase() {
        if (currentPhase === "toDrop") return; // already switched
        currentPhase = "toDrop";

        HAS_DESTINATION = HAS_DROP;
        DESTINATION = DROP_LOCATION;

        placeDestinationMarker();
        updatePhaseUI();

        if (HAS_DESTINATION) {
            computeRoute(currentDriverPosition || DESTINATION, true);
        } else {
            setStatus("Picked up — no drop location set");
        }

        if (HAS_DESTINATION) {
            setStatus("Picked up — heading to drop-off");
        }
    }

    function completeRide() {
        if (currentPhase === "completed") return; // avoid double-trigger
        currentPhase = "completed";

        clearInterval(pollTimer);

        if (directionsRenderer) directionsRenderer.setMap(null);
        if (fallbackRouteLine) fallbackRouteLine.setMap(null);
        if (destinationMarker) destinationMarker.setMap(null);

        updatePhaseUI();
        setStatus("Ride completed");

        showRideCompleteModal();
    }


    // ============================================================
    // RIDE COMPLETE MODAL + FEEDBACK
    // ============================================================

    function showRideCompleteModal() {
        const overlay = document.getElementById("ride-complete-overlay");
        if (overlay) overlay.classList.add("is-open");
    }

    function hideRideCompleteModal() {
        const overlay = document.getElementById("ride-complete-overlay");
        if (overlay) overlay.classList.remove("is-open");
    }

    function initFeedbackUI() {
        const starWrap = document.getElementById("star-rating");
        const submitBtn = document.getElementById("submit-feedback");
        const skipBtn = document.getElementById("skip-feedback");
        const commentBox = document.getElementById("feedback-comment");
        const feedbackForm = document.getElementById("feedback-form");
        const thanks = document.getElementById("feedback-thanks");

        if (starWrap) {
            starWrap.addEventListener("click", function (e) {
                const star = e.target.closest(".star");
                if (!star) return;

                selectedRating = Number(star.dataset.value);

                starWrap.querySelectorAll(".star").forEach(function (s) {
                    s.classList.toggle("active", Number(s.dataset.value) <= selectedRating);
                });

                if (submitBtn) submitBtn.disabled = selectedRating === 0;
            });
        }

        if (submitBtn) {
            submitBtn.addEventListener("click", async function () {
                if (selectedRating === 0) return;

                submitBtn.disabled = true;
                submitBtn.textContent = "Submitting...";

                const comment = commentBox ? commentBox.value : "";

                try {
                    const res = await fetch(FEEDBACK_URL, {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            bookingId: BOOKING_ID,
                            rating: selectedRating,
                            comment: comment
                        })
                    });

                    await res.json().catch(function () { return null; });
                } catch (err) {
                    console.error("Feedback submit failed:", err);
                }

                if (feedbackForm) feedbackForm.style.display = "none";
                if (thanks) thanks.style.display = "block";

                setTimeout(hideRideCompleteModal, 1600);
            });
        }

        if (skipBtn) {
            skipBtn.addEventListener("click", function () {
                hideRideCompleteModal();
            });
        }
    }


    // ============================================================
    // GET LIVE LOCATION
    // ============================================================

    async function fetchAndUpdateLocation() {
        try {
            const response = await fetch(LIVE_LOCATION_URL, {
                method: "GET",
                cache: "no-store",
                headers: { "Accept": "application/json" }
            });

            if (!response.ok) {
                setStatus("Location unavailable — retrying...", true);
                return;
            }

            const data = await response.json();

            console.log("Live driver location:", data);

            // Optional: if the backend ever starts returning a live phase
            // (e.g. driver app marks "picked up" / "completed"), trust it
            // over GPS proximity.
            if (data.ridePhase === "toDrop" && currentPhase === "toPickup") {
                switchToDropPhase();
            } else if (data.ridePhase === "completed" && currentPhase !== "completed") {
                completeRide();
                return;
            }

            if (data.latitude == null || data.longitude == null) {
                if (!mapLoaded) {
                    setStatus("Waiting for GPS signal...", true);
                }
                return;
            }

            const newPosition = {
                lat: Number(data.latitude),
                lng: Number(data.longitude)
            };

            if (!mapLoaded) {
                clearInterval(pollTimer);
                buildMap(newPosition.lat, newPosition.lng);
                return;
            }

            if (currentPhase === "completed") return;

            updateCabPosition(newPosition);
            checkPhaseTransition(newPosition);

            if (currentPhase === "completed") return; // just transitioned

            if (HAS_DESTINATION && DESTINATION) {
                if (fallbackRouteLine) {
                    fallbackRouteLine.setPath([newPosition, DESTINATION]);
                }

                if (Date.now() - lastRouteCalcAt >= ROUTE_RECALC_INTERVAL_MS) {
                    computeRoute(newPosition, false);
                }
            } else {
                setStatus("Tracking " + (data.driverName || "@Model.DriverName") + "...");
            }

        } catch (error) {
            console.error("Live location error:", error);
            setStatus("Connection trouble — retrying...", true);
        }
    }


    

    function startTracking() {
        initFeedbackUI();

        if (HAS_INITIAL_FIX) {
            loadGoogleMaps();
        } else {
            setStatus("Waiting for GPS signal...", true);

            fetchAndUpdateLocation();

            clearInterval(pollTimer);
            pollTimer = setInterval(fetchAndUpdateLocation, POLL_INTERVAL_MS);

            locatingTimeoutTimer = setTimeout(markTimedOut, LOCATING_TIMEOUT_MS);
        }
    }


    // ============================================================
    // PAGE CLEANUP
    // ============================================================

    window.addEventListener("beforeunload", function () {
        clearInterval(pollTimer);
        clearTimeout(locatingTimeoutTimer);
    });


 

    startTracking();
</script>