<style>

    /* =========================================================
       PREMIUM SARDAR JI CABS LOGIN UI
       ========================================================= */

    :root {
        --sj-green: #0b5d50;
        --sj-green-dark: #063f37;
        --sj-green-light: #eaf6f3;
        --sj-yellow: #f2a93c;
        --sj-text: #18211f;
        --sj-muted: #7a8582;
        --sj-border: #e4e9e7;
        --sj-white: #ffffff;
        --sj-bg: #f4f7f6;
    }


    /* =========================================================
       PAGE BACKGROUND
       ========================================================= */

    html,
    body {
        margin: 0;
        padding: 0;
        min-height: 100%;
    }

    body {
        font-family: "Inter", sans-serif;
        background: radial-gradient( circle at 10% 10%, rgba(11, 93, 80, 0.07), transparent 28% ), radial-gradient( circle at 90% 90%, rgba(242, 169, 60, 0.08), transparent 25% ), #f4f7f6;
        color: var(--sj-text);
    }


    /* Remove bootstrap container restrictions */
    #login-split {
        width: 100%;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 35px;
        box-sizing: border-box;
    }


        /* =========================================================
       MAIN LOGIN WRAPPER
       ========================================================= */

        #login-split .hero {
            width: 100%;
            max-width: 1180px;
            min-height: 680px;
            display: grid;
            grid-template-columns: 0.88fr 1.12fr;
            background: #fff;
            border-radius: 30px;
            overflow: hidden;
            box-shadow: 0 35px 90px rgba(13, 42, 36, 0.12), 0 10px 30px rgba(13, 42, 36, 0.06);
            border: 1px solid rgba(11, 93, 80, 0.08);
        }


        /* =========================================================
       LEFT LOGIN AREA
       ========================================================= */

        #login-split .hero-left {
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 55px 70px;
            background: radial-gradient( circle at 0% 100%, rgba(11, 93, 80, 0.055), transparent 30% ), #ffffff;
        }


        /* =========================================================
       LOGO
       ========================================================= */

        #login-split .logo {
       
            top: 38px;
            left: 55px;
            width: 155px;
            max-width: 155px;
            z-index: 5;
        }

            #login-split .logo img {
                display: block;
                width: 100%;
                height: auto;
                object-fit: contain;
            }


        /* =========================================================
       LOGIN CONTENT
       ========================================================= */

        #login-split .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            width: fit-content;
            margin-bottom: 15px;
            padding: 7px 12px;
            border-radius: 50px;
            background: var(--sj-green-light);
