            <style>
                :root {
                    --road: #1B1B1F;
                    --mustard: #F2A93C;
                    --mustard-dark: #D6891C;
                    --marigold: #E5572B;
                    --marigold-dk: #C0431E;
                    --teal: #0E6B5F;
                    --teal-dark: #0A4F46;
                    --teal-pale: #E4F1EE;
                    --cream: #FBF3E1;
                    --ink: #241C14;
                    --ink-soft: #7A6E5C;
                    --line: #E6D9BC;
                    --danger: #B3261E;
                    --radius: 12px;
                }

                #login-split * {
                    box-sizing: border-box;
                }

                #login-split {
                    font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
                    color: var(--ink);
                    background: var(--cream);
                }

                    #login-split .ls-header {
                        display: flex;
                        align-items: center;
                        justify-content: space-between;
                        padding: 1.5rem 3rem;
                        border-bottom: 1px solid var(--line);
                    }

                    #login-split .ls-logo {
                        display: flex;
                        align-items: center;
                        gap: 0.6rem;
                        font-family: "Baloo 2", sans-serif;
                        font-weight: 800;
                        font-size: 1.35rem;
                        color: var(--ink);
                    }

                        #login-split .ls-logo .mark {
                            width: 34px;
                            height: 34px;
                            border-radius: 50%;
                            background: var(--teal);
                            color: var(--cream);
                            display: inline-flex;
                            align-items: center;
                            justify-content: center;
                            font-size: 0.95rem;
                        }

                    #login-split .ls-header nav a {
                        color: var(--ink-soft);
                        text-decoration: none;
                        font-size: 0.95rem;
                        font-weight: 500;
                        margin-left: 2rem;
                    }

                        #login-split .ls-header nav a:hover {
                            color: var(--ink);
                        }

                    #login-split .hero {
                        display: grid;
                        grid-template-columns: 1fr 1fr;
                        gap: 3rem;
                        align-items: center;
                        max-width: 1280px;
                        margin: 0 auto;
                        padding: 3.5rem 3rem 4rem;
                        direction: ltr;
                    }

                    #login-split .hero-left {
                        max-width: 420px;
                        order: 1;
                        grid-column: 1;
                    }

                    #login-split .hero-right {
                        order: 2;
                        grid-column: 2;
                        position: relative;
                        border-radius: 20px;
                        overflow: hidden;
                        aspect-ratio: 4 / 3;
                        box-shadow: 0 30px 60px -24px rgba(27,27,31,0.45);
                    }

                        #login-split .hero-right svg {
                            display: block;
                            width: 100%;
                            height: 100%;
                        }

                    #login-split .eyebrow {
                        display: inline-flex;
                        align-items: center;
                        gap: 0.5rem;
                        font-size: 0.85rem;
                        font-weight: 700;
                        letter-spacing: 0.08em;
                        text-transform: uppercase;
                        color: var(--teal-dark);
                        margin-bottom: 1rem;
                    }

                        #login-split .eyebrow .dot {
                            width: 7px;
                            height: 7px;
                            border-radius: 50%;
                            background: var(--marigold);
                        }

                    #login-split h1 {
                        font-family: "Baloo 2", sans-serif;
                        font-size: 2.5rem;
                        line-height: 1.05;
                        font-weight: 800;
                        margin: 0 0 0.5rem;
                        color: var(--ink);
                    }

                    #login-split .subtitle {
                        font-size: 0.98rem;
                        color: var(--ink-soft);
                        margin: 0 0 2rem;
                    }

                    #login-split .form-group {
                        margin-bottom: 1.15rem;
                        text-align: left;
                    }

                        #login-split .form-group label {
                            display: block;
                            font-size: 0.72rem;
                            font-weight: 700;
                            text-transform: uppercase;
                            letter-spacing: 0.08em;
                            color: var(--teal-dark);
                            margin-bottom: 0.4rem;
                        }

                    #login-split .form-control {
                        width: 100%;
                        padding: 0.8rem 0.95rem;
                        font-size: 0.98rem;
                        font-family: inherit;
                        color: var(--ink);
                        background: #FFFFFF;
                        border: 1.5px solid var(--line);
                        border-radius: var(--radius);
                        transition: border-color 0.15s ease, box-shadow 0.15s ease;
                    }

                        #login-split .form-control::placeholder {
                            color: #A99C84;
                        }

                        #login-split .form-control:hover {
                            border-color: var(--mustard-dark);
                        }

                        #login-split .form-control:focus {
                            outline: none;
                            border-color: var(--teal);
                            box-shadow: 0 0 0 3px rgba(14,107,95,0.15);
                        }

                    #login-split .btn-primary {
                        width: 100%;
                        background: var(--marigold);
                        color: #FFFFFF;
                        border: none;
                        border-radius: var(--radius);
                        padding: 0.9rem 1.25rem;
                        font-family: "Baloo 2", sans-serif;
                        font-size: 1.02rem;
                        font-weight: 700;
                        cursor: pointer;
                        margin-top: 0.3rem;
                        box-shadow: 0 12px 22px -10px rgba(229,87,43,0.6);
                        transition: background 0.15s ease, transform 0.05s ease;
                    }

                        #login-split .btn-primary:hover {
                            background: var(--marigold-dk);
                        }

                        #login-split .btn-primary:active {
                            transform: translateY(1px);
                        }

                        #login-split .btn-primary:disabled {
                            opacity: 0.7;
                            cursor: default;
                        }

                    #login-split .text-danger {
                        font-size: 0.85rem;
                        color: var(--danger);
                        background: rgba(179,38,30,0.08);
                        border: 1px solid rgba(179,38,30,0.25);
                        border-radius: var(--radius);
                        padding: 0.6rem 0.8rem;
                        margin-bottom: 1rem;
                    }

                    #login-split .forgot-row {
                        text-align: right;
                        margin-top: 0.7rem;
                    }

                        #login-split .forgot-row a {
                            font-size: 0.85rem;
                            color: var(--teal-dark);
                            text-decoration: none;
                            font-weight: 600;
                        }

                            #login-split .forgot-row a:hover {
                                text-decoration: underline;
                            }

                    #login-split hr {
                        border: none;
                        border-top: 1px dashed var(--line);
                        margin: 1.75rem 0 1.25rem;
                    }

                    #login-split .signup-row {
                        font-size: 0.92rem;
                        color: var(--ink-soft);
                    }

                        #login-split .signup-row a {
                            display: inline-block;
                            margin-left: 0.6rem;
                            padding: 0.45rem 1rem;
                            background: var(--teal);
                            color: #FFFFFF;
                            border-radius: 999px;
                            text-decoration: none;
                            font-weight: 600;
                            font-size: 0.85rem;
                            transition: background 0.15s ease;
                        }

                            #login-split .signup-row a:hover {
                                background: var(--teal-dark);
                            }

