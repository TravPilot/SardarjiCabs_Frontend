        <style>


            /* ==========================================
               PREMIUM RIGHT SIDE ANIMATION
               ========================================== */
            #login-split .hero-right {
                position: relative;
                min-height: 620px;
                border-radius: 28px;
                overflow: hidden;
                background: radial-gradient(circle at 75% 20%, rgba(242,169,60,.18), transparent 28%), radial-gradient(circle at 20% 70%, rgba(14,107,95,.35), transparent 35%), linear-gradient(145deg, #071f1c 0%, #0a3831 45%, #071b19 100%);
                box-shadow: 0 35px 80px -30px rgba(0,0,0,.55), inset 0 1px 0 rgba(255,255,255,.08);
                animation: premiumReveal .8s cubic-bezier(.2,.8,.2,1) both;
            }

            /* subtle grid */
            #login-split .hero-right::before {
                content: "";
                position: absolute;
                inset: 0;
                background-image: linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);
                background-size: 45px 45px;
                mask-image: linear-gradient(to bottom, rgba(0,0,0,.8), transparent 85%);
            }

            /* ambient glow */
            #login-split .ambient-glow {
                position: absolute;
                width: 280px;
                height: 280px;
                border-radius: 50%;
                background: rgba(242,169,60,.12);
                filter: blur(70px);
                top: 80px;
                right: 70px;
                animation: ambientPulse 5s ease-in-out infinite;
            }

            /* Heading */
            #login-split .visual-heading {
                position: absolute;
                top: 42px;
                left: 42px;
                z-index: 5;
                color: #fff;
            }

                #login-split .visual-heading small {
                    display: block;
                    color: #F2A93C;
                    font-size: .72rem;
                    font-weight: 700;
                    letter-spacing: .14em;
                    text-transform: uppercase;
                    margin-bottom: 8px;
                }

                #login-split .visual-heading strong {
                    display: block;
                    font-family: "Baloo 2", sans-serif;
                    font-size: 2rem;
                    line-height: 1.05;
                    font-weight: 800;
                }

                #login-split .visual-heading span {
                    display: block;
                    color: rgba(255,255,255,.62);
                    font-size: .85rem;
                    margin-top: 7px;
                }

            /* ==========================================
               ROAD
               ========================================== */

            #login-split .premium-road {
                position: absolute;
                left: -10%;
                right: -10%;
                bottom: 0;
                height: 225px;
                background: linear-gradient( 170deg, #15171a 0%, #0d0f11 100% );
                transform: perspective(450px) rotateX(38deg);
                transform-origin: bottom;
            }

                #login-split .premium-road::before {
                    content: "";
                    position: absolute;
                    left: 50%;
                    top: 0;
                    width: 7px;
                    height: 100%;
                    transform: translateX(-50%);
                    background: repeating-linear-gradient( to bottom, rgba(255,255,255,.85) 0 35px, transparent 35px 70px );
                    animation: roadMove .7s linear infinite;
                }

            /* road side lights */
            #login-split .road-light {
                position: absolute;
                bottom: 65px;
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: #F2A93C;
                box-shadow: 0 0 15px #F2A93C;
                animation: roadLight 2s linear infinite;
            }

                #login-split .road-light.l1 {
                    left: 17%;
                    animation-delay: 0s;
                }

                #login-split .road-light.l2 {
                    left: 29%;
                    animation-delay: .5s;
                }

                #login-split .road-light.l3 {
                    right: 29%;
                    animation-delay: 1s;
                }

                #login-split .road-light.l4 {
                    right: 17%;
                    animation-delay: 1.5s;
                }

            /* ==========================================
               MODERN CAB
               ========================================== */

            #login-split .premium-cab {
                position: absolute;
                z-index: 4;
                width: 340px;
                height: 150px;
                left: 50%;
                bottom: 135px;
                transform: translateX(-50%);
                animation: cabFloat 4s ease-in-out infinite;
            }

                /* shadow */
                #login-split .premium-cab::after {
                    content: "";
                    position: absolute;
                    width: 300px;
                    height: 28px;
                    left: 20px;
                    bottom: -18px;
                    border-radius: 50%;
                    background: rgba(0,0,0,.55);
                    filter: blur(12px);
                }

            /* body */
            #login-split .cab-body {
                position: absolute;
                left: 15px;
                bottom: 25px;
                width: 310px;
                height: 82px;
                border-radius: 28px 42px 18px 18px;
                background: linear-gradient( 145deg, #ffc45b 0%, #F2A93C 48%, #d77e18 100% );
                box-shadow: inset 0 2px 0 rgba(255,255,255,.5), 0 12px 30px rgba(0,0,0,.3);
            }

            /* roof */
            #login-split .cab-roof {
                position: absolute;
                left: 75px;
                bottom: 95px;
                width: 175px;
                height: 62px;
                background: linear-gradient(145deg, #1d2527, #0b1112);
                clip-path: polygon(18% 100%, 32% 0, 72% 0, 100% 100%);
                border-radius: 20px 20px 0 0;
                box-shadow: inset 0 1px rgba(255,255,255,.12);
            }

            /* windows */
            #login-split .cab-window {
                position: absolute;
                bottom: 99px;
                height: 48px;
                background: linear-gradient( 135deg, #173e3b, #071716 );
                border: 1px solid rgba(255,255,255,.14);
            }

                #login-split .cab-window.left {
                    left: 91px;
                    width: 70px;
                    clip-path: polygon(25% 0,100% 0,100% 100%,0 100%);
                }

                #login-split .cab-window.right {
                    left: 164px;
                    width: 73px;
                    clip-path: polygon(0 0,80% 0,100% 100%,0 100%);
                }

            /* headlights */
            #login-split .cab-headlight {
                position: absolute;
                width: 17px;
                height: 11px;
                border-radius: 8px;
                background: #fff;
                box-shadow: 0 0 10px #fff, 0 0 25px rgba(255,255,255,.7);
                bottom: 61px;
            }

                #login-split .cab-headlight.left {
                    right: 18px;
                }

                #login-split .cab-headlight.right {
                    right: 48px;
                }

            /* wheels */
            #login-split .cab-wheel {
                position: absolute;
                bottom: 8px;
                width: 43px;
                height: 43px;
                border-radius: 50%;
                background: #111416;
                border: 7px solid #292d2f;
                box-shadow: inset 0 0 0 5px #080909;
                animation: wheelSpin 1s linear infinite;
            }

                #login-split .cab-wheel.left {
                    left: 48px;
                }

                #login-split .cab-wheel.right {
                    right: 48px;
                }

                /* wheel center */
                #login-split .cab-wheel::after {
                    content: "";
                    position: absolute;
                    width: 9px;
                    height: 9px;
                    border-radius: 50%;
                    background: #F2A93C;
                    left: 50%;
                    top: 50%;
                    transform: translate(-50%, -50%);
                }

            /* ==========================================
               FLOATING UI CARDS
               ========================================== */

            #login-split .floating-card {
                position: absolute;
                z-index: 6;
                display: flex;
                align-items: center;
                gap: 11px;
                padding: 12px 15px;
                border: 1px solid rgba(255,255,255,.12);
                border-radius: 15px;
                background: rgba(255,255,255,.08);
                backdrop-filter: blur(14px);
                -webkit-backdrop-filter: blur(14px);
                color: #fff;
                box-shadow: 0 15px 35px rgba(0,0,0,.25);
            }

                #login-split .floating-card .card-icon {
                    width: 34px;
                    height: 34px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    border-radius: 10px;
                    background: rgba(242,169,60,.18);
                    color: #F2A93C;
                    font-size: 16px;
                }

                #login-split .floating-card strong {
                    display: block;
                    font-size: .78rem;
                    font-weight: 700;
                }

                #login-split .floating-card span {
                    display: block;
                    margin-top: 2px;
                    color: rgba(255,255,255,.55);
                    font-size: .67rem;
                }

            #login-split .location-card {
                top: 175px;
                right: 32px;
                animation: floatingCard 4s ease-in-out infinite;
            }

            #login-split .booking-card {
                top: 300px;
                left: 30px;
                animation: floatingCard 4.5s .8s ease-in-out infinite;
            }

            /* live badge */
            #login-split .premium-live {
                position: absolute;
                z-index: 7;
                top: 42px;
                right: 35px;
                display: flex;
                align-items: center;
                gap: 7px;
                padding: 7px 12px;
                border-radius: 30px;
                background: rgba(111,227,160,.1);
                border: 1px solid rgba(111,227,160,.2);
                color: #bff7d5;
                font-size: .68rem;
                font-weight: 600;
            }

                #login-split .premium-live i {
                    width: 6px;
                    height: 6px;
                    border-radius: 50%;
                    background: #6FE3A0;
                    box-shadow: 0 0 0 0 rgba(111,227,160,.5);
                    animation: livePulse 1.6s infinite;
                }

            /* ==========================================
               ANIMATIONS
               ========================================== */

            @@keyframes premiumReveal {
                from

            {
                opacity: 0;
                transform: translateY(20px) scale(.98);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }

            }

            @@keyframes ambientPulse {
                0%, 100%

            {
                transform: scale(1);
                opacity: .7;
            }

            50% {
                transform: scale(1.2);
                opacity: 1;
            }

            }

            @@keyframes cabFloat {
                0%, 100%

            {
                transform: translateX(-50%) translateY(0);
            }

            50% {
                transform: translateX(-50%) translateY(-7px);
            }

            }

            @@keyframes wheelSpin {
                from

            {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }

            }

            @@keyframes roadMove {
                from

            {
                background-position-y: 0;
            }

            to {
                background-position-y: 70px;
            }

            }

            @@keyframes roadLight {
                0%

            {
                transform: translateY(20px);
                opacity: 0;
            }

            20%, 80% {
                opacity: 1;
            }

            100% {
                transform: translateY(-120px);
                opacity: 0;
            }

            }

            @@keyframes floatingCard {
                0%, 100%

            {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-8px);
            }

            }

            @@keyframes livePulse {
                0%

            {
                box-shadow: 0 0 0 0 rgba(111,227,160,.55);
            }

            70% {
                box-shadow: 0 0 0 8px rgba(111,227,160,0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(111,227,160,0);
            }

            }

            /* ==========================================
               MOBILE
               ========================================== */

            @@media (max-width: 980px) {
                #login-split .hero-right

            {
                min-height: 470px;
                order: -1;
            }

            #login-split .premium-cab {
                transform: translateX(-50%) scale(.8);
                transform-origin: bottom center;
            }

            #login-split .visual-heading {
                top: 28px;
                left: 28px;
            }

                #login-split .visual-heading strong {
                    font-size: 1.6rem;
                }

            #login-split .location-card {
                right: 20px;
                top: 130px;
            }

            #login-split .booking-card {
                left: 20px;
                top: 250px;
            }

            }

            @@media (max-width: 576px) {
                #login-split .hero-right

            {
                min-height: 390px;
                border-radius: 20px;
            }

            #login-split .premium-cab {
                transform: translateX(-50%) scale(.65);
            }

            #login-split .floating-card {
                transform: scale(.85);
            }

            #login-split .location-card {
                right: 5px;
                top: 125px;
            }

            #login-split .booking-card {
                left: 5px;
                top: 220px;
            }

            #login-split .premium-live {
                top: 20px;
                right: 20px;
            }

            #login-split .visual-heading {
                top: 20px;
                left: 20px;
            }

            }
        
        </style>

