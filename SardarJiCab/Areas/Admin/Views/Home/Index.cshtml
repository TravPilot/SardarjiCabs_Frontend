@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | RideAdmin</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --sidebar-width: 260px;
            --sidebar-bg: #14161f;
            --sidebar-bg-active: #1f2230;
            --brand: #00c37a;
            --brand-dark: #00a868;
            --navbar-h: 66px;
            --body-bg: #f4f6fa;
            --card-shadow: 0 2px 10px rgba(20, 22, 31, 0.06);
            --text-muted-2: #8b93a7;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--body-bg);
            color: #2a2e3f;
            overflow-x: hidden;
        }

        /* ===== SIDEBAR ===== */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            width: var(--sidebar-width);
            background: var(--sidebar-bg);
            z-index: 1040;
            transition: transform .25s ease;
            display: flex;
            flex-direction: column;
        }

        .sidebar-brand {
            height: var(--navbar-h);
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 22px;
            border-bottom: 1px solid rgba(255,255,255,.06);
            flex-shrink: 0;
        }

            .sidebar-brand .logo-mark {
                width: 34px;
                height: 34px;
                border-radius: 9px;
                background: linear-gradient(135deg, var(--brand), var(--brand-dark));
                display: flex;
                align-items: center;
                justify-content: center;
                color: #fff;
                font-weight: 800;
                font-size: 16px;
            }

            .sidebar-brand span {
                color: #fff;
                font-weight: 700;
                font-size: 18px;
                letter-spacing: .3px;
            }

        .sidebar-nav {
            padding: 18px 12px;
            overflow-y: auto;
            flex-grow: 1;
        }

            .sidebar-nav .nav-section-label {
                color: #545a6e;
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: .08em;
                padding: 14px 12px 6px;
            }

            .sidebar-nav .nav-link {
                display: flex;
                align-items: center;
                gap: 12px;
                color: #b6bacb;
                font-size: 14.5px;
                font-weight: 500;
                padding: 10px 14px;
                border-radius: 10px;
                margin-bottom: 3px;
                transition: all .15s ease;
            }

                .sidebar-nav .nav-link i {
                    font-size: 17px;
                    width: 20px;
                    text-align: center;
                }

                .sidebar-nav .nav-link:hover {
                    background: rgba(255,255,255,.05);
                    color: #fff;
                }

                .sidebar-nav .nav-link.active {
                    background: var(--sidebar-bg-active);
                    color: #fff;
                    box-shadow: inset 3px 0 0 var(--brand);
                }

            .sidebar-nav .badge-count {
                margin-left: auto;
                background: var(--brand);
                color: #06110c;
                font-size: 11px;
                font-weight: 700;
                padding: 2px 7px;
                border-radius: 20px;
            }

        .sidebar-footer {
            padding: 14px 18px;
            border-top: 1px solid rgba(255,255,255,.06);
            display: flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
        }

            .sidebar-footer img {
                width: 36px;
                height: 36px;
                border-radius: 50%;
                object-fit: cover;
            }

            .sidebar-footer .name {
                color: #fff;
                font-size: 13.5px;
                font-weight: 600;
            }

            .sidebar-footer .role {
                color: #8b93a7;
                font-size: 11.5px;
            }

        /* ===== MAIN WRAPPER ===== */
        .main-wrapper {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            transition: margin .25s ease;
        }

        /* ===== TOP NAVBAR ===== */
        .topnav {
            height: var(--navbar-h);
            background: #fff;
            border-bottom: 1px solid #eaecf2;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            position: sticky;
            top: 0;
            z-index: 1030;
        }

            .topnav .search-box {
                position: relative;
                width: 320px;
                max-width: 40vw;
            }

                .topnav .search-box input {
                    border-radius: 10px;
                    border: 1px solid #e6e8f0;
                    background: #f7f8fb;
                    padding: 8px 14px 8px 38px;
                    font-size: 13.5px;
                }

                .topnav .search-box i {
                    position: absolute;
                    left: 13px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: #a2a8ba;
                }

            .topnav .nav-icon-btn {
                width: 40px;
                height: 40px;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #f7f8fb;
                color: #4b5266;
                position: relative;
                border: none;
            }

                .topnav .nav-icon-btn .dot {
                    position: absolute;
                    top: 8px;
                    right: 8px;
                    width: 8px;
                    height: 8px;
                    border-radius: 50%;
                    background: #ff4d4f;
                    border: 2px solid #fff;
                }

            .topnav .profile-chip {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 6px 10px 6px 6px;
                border-radius: 12px;
                background: #f7f8fb;
            }

                .topnav .profile-chip img {
                    width: 34px;
                    height: 34px;
                    border-radius: 50%;
                    object-fit: cover;
                }

                .topnav .profile-chip .name {
                    font-size: 13.5px;
                    font-weight: 600;
                    color: #2a2e3f;
                }

                .topnav .profile-chip .role {
                    font-size: 11px;
                    color: var(--text-muted-2);
                }

        #sidebarToggle {
            border: none;
            background: #f7f8fb;
            width: 40px;
            height: 40px;
            border-radius: 10px;
            color: #4b5266;
            display: none;
        }

        /* ===== PAGE CONTENT ===== */
        .page-content {
            padding: 26px;
        }

        .page-heading h4 {
            font-weight: 800;
            margin-bottom: 2px;
        }

        .page-heading p {
            color: var(--text-muted-2);
            font-size: 13.5px;
        }

        /* ===== STAT CARDS ===== */
        .stat-card {
            background: #fff;
            border-radius: 16px;
            padding: 20px 22px;
            box-shadow: var(--card-shadow);
            border: 1px solid #eef0f5;
            height: 100%;
        }

            .stat-card .icon-box {
                width: 46px;
                height: 46px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                margin-bottom: 14px;
            }

            .stat-card .label {
                font-size: 13px;
                color: var(--text-muted-2);
                font-weight: 500;
                margin-bottom: 4px;
            }

            .stat-card .value {
                font-size: 26px;
                font-weight: 800;
                color: #1c1f2b;
            }

            .stat-card .trend {
                font-size: 12.5px;
                font-weight: 600;
                margin-top: 8px;
                display: flex;
                align-items: center;
                gap: 4px;
            }

        .trend.up {
            color: #16a765;
        }

        .trend.down {
            color: #ff4d4f;
        }

        .bg-bookings {
            background: rgba(0,195,122,.12);
            color: var(--brand-dark);
        }

        .bg-drivers {
            background: rgba(66,133,244,.12);
            color: #4285f4;
        }

        .bg-customers {
            background: rgba(255,159,28,.12);
            color: #ff9f1c;
        }

        .bg-revenue {
            background: rgba(155,81,224,.12);
            color: #9b51e0;
        }

        /* ===== PANEL / CARD ===== */
        .panel {
            background: #fff;
            border-radius: 16px;
            box-shadow: var(--card-shadow);
            border: 1px solid #eef0f5;
        }

        .panel-header {
            padding: 18px 22px;
            border-bottom: 1px solid #f1f2f6;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

            .panel-header h6 {
                font-weight: 700;
                margin: 0;
                font-size: 15px;
            }

            .panel-header .view-all {
                font-size: 12.5px;
                font-weight: 600;
                color: var(--brand-dark);
                text-decoration: none;
            }

        /* ===== TABLE ===== */
        .table-custom {
            margin-bottom: 0;
        }

            .table-custom thead th {
                font-size: 11.5px;
                text-transform: uppercase;
                letter-spacing: .04em;
                color: var(--text-muted-2);
                font-weight: 700;
                border-bottom: 1px solid #f1f2f6;
                padding: 14px 22px;
                white-space: nowrap;
            }

            .table-custom tbody td {
                padding: 14px 22px;
                font-size: 13.5px;
                vertical-align: middle;
                border-bottom: 1px solid #f5f6f9;
                color: #3a3f52;
            }

            .table-custom tbody tr:last-child td {
                border-bottom: none;
            }

        .cust-cell {
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .cust-cell img {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                object-fit: cover;
            }

            .cust-cell .cname {
                font-weight: 600;
                font-size: 13.5px;
                color: #22263a;
            }

            .cust-cell .cid {
                font-size: 11.5px;
                color: var(--text-muted-2);
            }

        .status-pill {
            font-size: 11.5px;
            font-weight: 700;
            padding: 4px 11px;
            border-radius: 20px;
            display: inline-block;
        }

        .status-pending {
            background: rgba(255,159,28,.14);
            color: #cf7c00;
        }

        .status-assigned {
            background: rgba(66,133,244,.14);
            color: #2f6fe0;
        }

        .assign-select {
            font-size: 12.5px;
            border-radius: 8px;
            border: 1px solid #e6e8f0;
            padding: 6px 28px 6px 10px;
            min-width: 150px;
            background-color: #fbfbfd;
        }

        /* ===== RECENT ACTIVITY ===== */
        .activity-item {
            display: flex;
            gap: 14px;
            padding: 14px 22px;
        }

            .activity-item:not(:last-child) {
                border-bottom: 1px solid #f5f6f9;
            }

        .activity-icon {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 15px;
        }

        .activity-text {
            font-size: 13.5px;
            color: #363b4e;
        }

            .activity-text b {
                color: #1c1f2b;
            }

        .activity-time {
            font-size: 11.5px;
            color: var(--text-muted-2);
            margin-top: 2px;
        }

        /* ===== OVERLAY (mobile) ===== */
        .sidebar-overlay {
            position: fixed;
            inset: 0;
            background: rgba(10,11,18,.5);
            z-index: 1035;
            display: none;
        }

        /* ===== RESPONSIVE ===== */
        @@media (max-width: 991.98px) {
            .sidebar {
                transform: translateX(-100%);
            }

                .sidebar.show {
                    transform: translateX(0);
                }

            .main-wrapper {
                margin-left: 0;
            }

            #sidebarToggle {
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .sidebar-overlay.show {
                display: block;
            }

            .topnav .search-box {
                display: none;
            }
        }

        @@media (max-width: 575.98px) {
            .page-content {
                padding: 16px;
            }

            .topnav {
                padding: 0 14px;
            }

                .topnav .profile-chip .name, .topnav .profile-chip .role {
                    display: none;
                }
        }
    </style>
</head>
<body>

    <!-- ===== SIDEBAR ===== -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <div class="logo-mark"><i class="bi bi-car-front-fill"></i></div>
            <span>Ride<span style="color:var(--brand)">Admin</span></span>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section-label">Main</div>
            <a href="#" class="nav-link active"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>
            <a href="#" class="nav-link"><i class="bi bi-journal-text"></i> Bookings <span class="badge-count">12</span></a>
            <a href="#" class="nav-link"><i class="bi bi-person-badge-fill"></i> Drivers</a>
            <a href="#" class="nav-link"><i class="bi bi-people-fill"></i> Customers</a>
            <a href="#" class="nav-link"><i class="bi bi-cash-coin"></i> Revenue</a>

            <div class="nav-section-label">Manage</div>
            <a href="#" class="nav-link"><i class="bi bi-geo-alt-fill"></i> Live Tracking</a>
            <a href="#" class="nav-link"><i class="bi bi-star-fill"></i> Ratings &amp; Reviews</a>
            <a href="#" class="nav-link"><i class="bi bi-megaphone-fill"></i> Promotions</a>

            <div class="nav-section-label">System</div>
            <a href="#" class="nav-link"><i class="bi bi-gear-fill"></i> Settings</a>
            <a href="#" class="nav-link"><i class="bi bi-life-preserver"></i> Support</a>
            <a href="#" class="nav-link"><i class="bi bi-box-arrow-right"></i> Logout</a>
        </nav>

        <div class="sidebar-footer">
            <img src="https://i.pravatar.cc/72?img=12" alt="admin" />
            <div>
                <div class="name">Aarav Mehta</div>
                <div class="role">Super Admin</div>
            </div>
        </div>
    </aside>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- ===== MAIN WRAPPER ===== -->
    <div class="main-wrapper">

        <!-- TOP NAVBAR -->
        <header class="topnav">
            <div class="d-flex align-items-center gap-3">
                <button id="sidebarToggle"><i class="bi bi-list fs-4"></i></button>
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" class="form-control" placeholder="Search bookings, drivers, customers..." />
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <button class="nav-icon-btn"><i class="bi bi-moon-fill"></i></button>
                <button class="nav-icon-btn"><i class="bi bi-bell-fill"></i><span class="dot"></span></button>
                <button class="nav-icon-btn"><i class="bi bi-envelope-fill"></i></button>
                <div class="dropdown">
                    <a href="#" class="profile-chip text-decoration-none dropdown-toggle" data-bs-toggle="dropdown">
                        <img src="https://i.pravatar.cc/72?img=12" alt="profile" />
                        <div>
                            <div class="name">Aarav Mehta</div>
                            <div class="role">Super Admin</div>
                        </div>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i>My Profile</a></li>
                        <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i>Settings</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item text-danger" href="#"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- PAGE CONTENT -->
        <main class="page-content">

            <div class="page-heading mb-4">
                <h4>Dashboard Overview</h4>
                <p>Welcome back, here's what's happening with your fleet today.</p>
            </div>

            <!-- STAT CARDS -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-lg-3">
                    <div class="stat-card">
                        <div class="icon-box bg-bookings"><i class="bi bi-journal-check"></i></div>
                        <div class="label">Total Bookings</div>
                        <div class="value">8,942</div>
                        <div class="trend up"><i class="bi bi-arrow-up-short"></i> 12.4% this week</div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="stat-card">
                        <div class="icon-box bg-drivers"><i class="bi bi-person-badge"></i></div>
                        <div class="label">Active Drivers</div>
                        <div class="value">614</div>
                        <div class="trend up"><i class="bi bi-arrow-up-short"></i> 3.1% this week</div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="stat-card">
                        <div class="icon-box bg-customers"><i class="bi bi-people"></i></div>
                        <div class="label">Customers</div>
                        <div class="value">21,308</div>
                        <div class="trend up"><i class="bi bi-arrow-up-short"></i> 8.7% this week</div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="stat-card">
                        <div class="icon-box bg-revenue"><i class="bi bi-cash-stack"></i></div>
                        <div class="label">Revenue</div>
                        <div class="value">₹18.6L</div>
                        <div class="trend down"><i class="bi bi-arrow-down-short"></i> 1.8% this week</div>
                    </div>
                </div>
            </div>

            <div class="row g-3">
                <!-- PENDING BOOKINGS TABLE -->
                <div class="col-lg-8">
                    <div class="panel h-100">
                        <div class="panel-header">
                            <h6><i class="bi bi-hourglass-split me-2"></i>Pending Bookings</h6>
                            <a href="#" class="view-all">View all <i class="bi bi-arrow-right"></i></a>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-custom">
                                <thead>
                                    <tr>
                                        <th>Customer</th>
                                        <th>Pickup → Drop</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                        <th>Assign Driver</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            <div class="cust-cell">
                                                <img src="https://i.pravatar.cc/72?img=32" />
                                                <div>
                                                    <div class="cname">Rohan Kapoor</div>
                                                    <div class="cid">#BK-10245</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>Connaught Place → Saket</td>
                                        <td>29 Jul, 10:20 AM</td>
                                        <td><span class="status-pill status-pending">Pending</span></td>
                                        <td>
                                            <select class="form-select assign-select">
                                                <option selected disabled>Select driver</option>
                                                <option>Vikram Singh</option>
                                                <option>Suresh Yadav</option>
                                                <option>Imran Khan</option>
                                            </select>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <div class="cust-cell">
                                                <img src="https://i.pravatar.cc/72?img=45" />
                                                <div>
                                                    <div class="cname">Sneha Iyer</div>
                                                    <div class="cid">#BK-10246</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>Dwarka Sec-21 → IGI Airport</td>
                                        <td>29 Jul, 10:35 AM</td>
                                        <td><span class="status-pill status-pending">Pending</span></td>
                                        <td>
                                            <select class="form-select assign-select">
                                                <option selected disabled>Select driver</option>
                                                <option>Vikram Singh</option>
                                                <option>Suresh Yadav</option>
                                                <option>Imran Khan</option>
                                            </select>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <div class="cust-cell">
                                                <img src="https://i.pravatar.cc/72?img=15" />
                                                <div>
                                                    <div class="cname">Aditya Rao</div>
                                                    <div class="cid">#BK-10247</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>Karol Bagh → Noida Sec-62</td>
                                        <td>29 Jul, 11:05 AM</td>
                                        <td><span class="status-pill status-assigned">Assigned</span></td>
                                        <td>
                                            <select class="form-select assign-select">
                                                <option selected>Vikram Singh</option>
                                                <option>Suresh Yadav</option>
                                                <option>Imran Khan</option>
                                            </select>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <div class="cust-cell">
                                                <img src="https://i.pravatar.cc/72?img=25" />
                                                <div>
                                                    <div class="cname">Priya Nair</div>
                                                    <div class="cid">#BK-10248</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>Lajpat Nagar → Gurugram Cyber Hub</td>
                                        <td>29 Jul, 11:40 AM</td>
                                        <td><span class="status-pill status-pending">Pending</span></td>
                                        <td>
                                            <select class="form-select assign-select">
                                                <option selected disabled>Select driver</option>
                                                <option>Vikram Singh</option>
                                                <option>Suresh Yadav</option>
                                                <option>Imran Khan</option>
                                            </select>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- RECENT ACTIVITIES -->
                <div class="col-lg-4">
                    <div class="panel h-100">
                        <div class="panel-header">
                            <h6><i class="bi bi-activity me-2"></i>Recent Activities</h6>
                            <a href="#" class="view-all">View all</a>
                        </div>
                        <div>
                            <div class="activity-item">
                                <div class="activity-icon bg-bookings"><i class="bi bi-check2"></i></div>
                                <div>
                                    <div class="activity-text"><b>Vikram Singh</b> completed booking #BK-10231</div>
                                    <div class="activity-time">2 minutes ago</div>
                                </div>
                            </div>
                            <div class="activity-item">
                                <div class="activity-icon bg-customers"><i class="bi bi-person-plus-fill"></i></div>
                                <div>
                                    <div class="activity-text">New customer <b>Meera Joshi</b> signed up</div>
                                    <div class="activity-time">18 minutes ago</div>
                                </div>
                            </div>
                            <div class="activity-item">
