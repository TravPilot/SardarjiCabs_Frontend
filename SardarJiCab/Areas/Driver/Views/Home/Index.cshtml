<script>
        let map;
    let carMarker;
    let destinationMarker;
    let directionsService;
    let directionsRenderer;

    let currentLocation = null;
    let watchId = null;
    let rideStarted = false;
    let routePath = [];        
    let animationTimer = null;
    let animationIndex = 0;

    const DESTINATION = { lat: 28.6315, lng: 77.2167 };

    function initGoogleMaps() {
        map = new google.maps.Map(document.getElementById("liveMap"), {
            zoom: 14,
            center: { lat: 28.6139, lng: 77.2090 },
            mapTypeControl: false
        });

        directionsService = new google.maps.DirectionsService();

        directionsRenderer = new google.maps.DirectionsRenderer({
            map: map,
            suppressMarkers: true,
            preserveViewport: false,   
            polylineOptions: {
                strokeColor: "#FFB020",
                strokeWeight: 6,
                strokeOpacity: 0.9,
                zIndex: 1               
            }
        });

        destinationMarker = new google.maps.Marker({
            map: map,
            position: DESTINATION,
            title: "Delhi Destination",
            icon: { url: "https://maps.google.com/mapfiles/ms/icons/red-dot.png" }
        });

        document.getElementById("mapPlaceholder").style.display = "none";

        startLiveTracking();
    }

    function startLiveTracking() {
        if (!navigator.geolocation) {
            alert("Your device does not support GPS");
            return;
        }

        watchId = navigator.geolocation.watchPosition(
            function (position) {
                currentLocation = {
                    lat: position.coords.latitude,
                    lng: position.coords.longitude
                };

                moveCar(currentLocation);

                if (!rideStarted) {
                    updateRoute(currentLocation, DESTINATION);
                }
            },
            function (error) {
                switch (error.code) {
                    case 1: alert("Please allow location permission"); break;
                    case 2: alert("GPS location unavailable"); break;
                    case 3: alert("GPS timeout"); break;
                }
            },
            { enableHighAccuracy: true, maximumAge: 0, timeout: 10000 }
        );
    }

   
    function moveCar(location) {
        if (carMarker == null) {
            carMarker = new google.maps.Marker({
                map: map,
                position: location,
                icon: {
                    url: "https://maps.google.com/mapfiles/kml/shapes/cabs.png",
                    scaledSize: new google.maps.Size(28, 28),  
                    anchor: new google.maps.Point(14, 14)
                },
                title: "Driver Location",
                zIndex: google.maps.Marker.MAX_ZINDEX + 1       
            });
        } else {
            carMarker.setPosition(location);
        }

        map.panTo(location);
    }

   
    function updateRoute(start, end) {
        directionsService.route(
            {
                origin: start,
                destination: end,
                travelMode: google.maps.TravelMode.DRIVING
            },
            function (result, status) {
                if (status === google.maps.DirectionsStatus.OK) {
                    directionsRenderer.setDirections(result);

                    routePath = [];
                    result.routes[0].legs[0].steps.forEach(step => {
                        routePath = routePath.concat(step.path);
                    });

                    let leg = result.routes[0].legs[0];
                    let eta = document.getElementById("etaChip");
                    eta.innerHTML = "ETA " + leg.duration.text;
                    eta.style.display = "block";
                } else {
                   
                    console.error("Directions request failed:", status);
                    alert("Could not load route: " + status);
                }
            }
        );
    }

   
    function animateCarAlongRoute() {
        if (routePath.length === 0) {
            alert("Route not loaded yet, please wait a moment.");
            return;
        }

        animationIndex = 0;
        clearInterval(animationTimer);

        animationTimer = setInterval(function () {
            if (animationIndex >= routePath.length) {
                clearInterval(animationTimer);
                return;
            }
            const point = routePath[animationIndex];
            carMarker.setPosition(point);
            map.panTo(point);
            animationIndex++;
        }, 300); 
    }

    document.getElementById("startRideBtn").addEventListener("click", function () {
        if (currentLocation == null) {
            alert("Waiting for GPS...");
            return;
        }
        if (routePath.length === 0) {
            alert("Waiting for route to load...");
            return;
        }

        rideStarted = true;
        alert("Ride Started - Live Tracking Enabled");
        animateCarAlongRoute();
    });
    </script>






