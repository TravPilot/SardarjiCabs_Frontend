@using SardarJi_Cab_Booking.Models
@model HomeIndexViewModel
@{



    ViewData["Title"] = "Driver Dashboard";

    var apppo = Model.GoogleMapsApiKey;

}
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@500;700;800&family=Work+Sans:wght@400;500;600&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

<style>
    :root {
        --ink: #12181F;
        --ink-soft: #1C242F;
        --paper: #EEF1F5;
        --paper-card: #FFFFFF;
        --line: #DCE1E8;
        --text: #1B222C;
        --text-muted: #66707C;
        --amber: #FFB020;
        --amber-dim: #8A5E0F;
        --teal: #1B6E6E;
        --red: #D64545;
        --font-display: 'Big Shoulders Display', sans-serif;
        --font-body: 'Work Sans', sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
    }

    .driver-dashboard {
        background: var(--paper);
        font-family: var(--font-body);
        color: var(--text);
        min-height: 100vh;
        padding: 28px 32px 56px;
    }

    /* ---------- Status bar ---------- */
    .status-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--ink);
        border-radius: 16px;
        padding: 16px 24px;
        color: #fff;
        margin-bottom: 24px;
    }

        .status-bar .driver-id {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .status-bar .avatar {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--amber), #E08E00);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 18px;
            color: var(--ink);
        }

        .status-bar .driver-name {
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 20px;
            letter-spacing: .3px;
            line-height: 1.1;
        }

        .status-bar .driver-meta {
            font-size: 13px;
            color: #9AA5B1;
            font-family: var(--font-mono);
        }

    .online-toggle {
        display: flex;
        align-items: center;
        gap: 10px;
        background: rgba(255,255,255,0.06);
        padding: 8px 16px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.1);
    }

        .online-toggle .dot {
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: var(--amber);
            box-shadow: 0 0 8px var(--amber);
            animation: pulse 1.8s infinite ease-in-out;
        }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: .35;
        }
    }

    .online-toggle span {
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: var(--amber);
    }

    /* ---------- Hero: current ride ---------- */
    .ride-hero {
        background: var(--paper-card);
        border-radius: 20px;
        border: 1px solid var(--line);
        overflow: hidden;
        box-shadow: 0 1px 2px rgba(16,24,32,.04);
        margin-bottom: 24px;
    }

    .ride-hero-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 28px 0;
    }

        .ride-hero-head h1 {
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 26px;
            margin: 0;
            letter-spacing: .3px;
            color: var(--ink);
        }

    .ride-badge {
        font-family: var(--font-mono);
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 6px 14px;
        border-radius: 999px;
        background: #FFF3DC;
        color: var(--amber-dim);
        border: 1px solid #F5D89A;
    }

    /* status stepper — genuine sequence, so numbering is warranted */
    .ride-stepper {
        display: flex;
        gap: 6px;
        padding: 20px 28px 4px;
    }

        .ride-stepper .step {
            flex: 1;
            text-align: left;
        }

        .ride-stepper .step-bar {
            height: 4px;
            border-radius: 2px;
            background: var(--line);
            margin-bottom: 8px;
        }

        .ride-stepper .step.done .step-bar {
            background: var(--teal);
        }

        .ride-stepper .step.active .step-bar {
            background: var(--amber);
        }

        .ride-stepper .step-label {
            font-family: var(--font-mono);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .6px;
            color: var(--text-muted);
        }

        .ride-stepper .step.active .step-label,
        .ride-stepper .step.done .step-label {
            color: var(--text);
        }

    .ride-body {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0;
        padding: 20px 0 0;
    }

    .ride-details {
        padding: 8px 28px 28px;
    }

        .ride-details dl {
            margin: 0 0 20px;
        }

    .ride-row {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 11px 0;
        border-bottom: 1px dashed var(--line);
    }

        .ride-row:last-child {
            border-bottom: none;
        }

        .ride-row i {
            color: var(--teal);
            font-size: 15px;
            margin-top: 2px;
            width: 18px;
        }

        .ride-row .label {
            font-family: var(--font-mono);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .6px;
            color: var(--text-muted);
            display: block;
        }

        .ride-row .value {
            font-size: 15px;
            font-weight: 500;
            color: var(--text);
        }

    .btn-start-ride {
        width: 100%;
        background: var(--ink);
        color: #fff;
        border: none;
        border-radius: 12px;
        padding: 16px;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 18px;
        letter-spacing: .5px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        cursor: pointer;
        transition: background .2s ease;
    }

        .btn-start-ride:hover {
            background: #232D3A;
        }

        .btn-start-ride i {
            color: var(--amber);
            font-size: 16px;
        }

   
    .ride-map {
        position: relative;
        background: var(--ink-soft);
        min-height: 320px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    #liveMap {
        width: 100%;
        height: 100%;
        min-height: 320px;
        position: absolute;
        inset: 0;
    }

    .ride-map .map-placeholder {
        text-align: center;
        color: #6B7684;
        font-family: var(--font-mono);
        font-size: 13px;
        z-index: 1;
    }

        .ride-map .map-placeholder i {
            font-size: 30px;
            color: var(--amber);
            display: block;
            margin-bottom: 10px;
        }

    .eta-chip {
        position: absolute;
        top: 16px;
        right: 16px;
        background: var(--amber);
        color: var(--ink);
        font-family: var(--font-mono);
        font-weight: 700;
        font-size: 13px;
        padding: 8px 14px;
        border-radius: 10px;
        z-index: 2;
    }

    
    .meter-strip {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
    }

    .meter-tile {
        background: var(--ink);
        border-radius: 16px;
        padding: 18px 20px;
        position: relative;
        overflow: hidden;
    }

        .meter-tile::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: var(--amber);
            opacity: .8;
        }

        .meter-tile .meter-label {
            font-family: var(--font-mono);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #7C8794;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

            .meter-tile .meter-label i {
                color: var(--amber);
                font-size: 13px;
            }

    .meter-digits {
        font-family: var(--font-mono);
        font-weight: 700;
        font-size: 32px;
        color: var(--amber);
        text-shadow: 0 0 12px rgba(255,176,32,.45);
        letter-spacing: 1px;
        line-height: 1;
    }

        .meter-digits .unit {
            font-size: 14px;
            color: #C98F2E;
            margin-left: 4px;
        }

    
    @@media (max-width: 900px) {
        .ride-body {
            grid-template-columns: 1fr;
        }

        .ride-map {
            min-height: 240px;
        }

        .meter-strip {
            grid-template-columns: repeat(2, 1fr);
        }

        .driver-dashboard {
            padding: 18px 16px 40px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .online-toggle .dot {
            animation: none;
        }
    }

    .btn-start-ride:focus-visible,
    .online-toggle:focus-visible {
        outline: 2px solid var(--amber);
        outline-offset: 2px;
    }
</style>

